module

public import TauCeti.AlgebraicGeometry.LineBundle.Basic
public import TauCeti.AlgebraicGeometry.RelativeProj.Basic

set_option warningAsError false

/-!
# Lookahead stubs for `relative-proj-twisting-sheaf`

These are lookahead stubs for the supplier `relative-proj-twisting-sheaf`
(SchemeAndStackFoundations, §0.3), to be replaced by the landed declarations.

* `CategoryTheory.CommMon.relativeProjTwistingSheaf A n` is the twisting sheaf `𝒪(n)` on the
  relative `Proj` of `A`, in the form of open PR 22384.
* `CategoryTheory.CommMon.IsGeneratedInDegreeOne A` says that `A` is generated by `A₁` as a graded
  `A₀`-algebra.
* `CategoryTheory.CommMon.isInvertible_relativeProjTwistingSheaf_one` says that `𝒪(1)` is
  invertible when `A` is generated in degree one (Stacks, Lemma 27.16.11 (01O4)).
-/

public section

open CategoryTheory AlgebraicGeometry

namespace TauCeti

universe u

noncomputable section

/-- The graded algebra `A` is generated in degree one: it is generated by `A₁` as a graded
`A₀`-algebra. -/
def _root_.CategoryTheory.CommMon.IsGeneratedInDegreeOne {X : Scheme.{u}}
    (A : CommMon (GradedObject ℕ X.Modules)) : Prop :=
  sorry

variable {X : Scheme.{u}} (A : CommMon (GradedObject ℕ X.Modules)) [∀ n, (A.X n).IsQuasicoherent]

/-- The twisting sheaf `𝒪(n)` on the relative `Proj` of `A`. -/
def _root_.CategoryTheory.CommMon.relativeProjTwistingSheaf (n : ℤ) : A.relativeProj.Modules :=
  sorry

/-- If `A` is generated in degree one, the twisting sheaf `𝒪(1)` on its relative `Proj` is
invertible. -/
theorem _root_.CategoryTheory.CommMon.isInvertible_relativeProjTwistingSheaf_one
    (hA : A.IsGeneratedInDegreeOne) :
    AlgebraicGeometry.SheafOfModules.isInvertible _ (A.relativeProjTwistingSheaf 1) :=
  sorry

end

end TauCeti
