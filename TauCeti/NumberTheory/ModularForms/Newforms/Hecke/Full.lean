module

public import TauCeti.NumberTheory.ModularForms.Newforms.Hecke.Rational
public import TauCeti.NumberTheory.ModularForms.Newforms.BadPrime.Stability
import TauCeti.LinearAlgebra.End.Adjoin
import TauCeti.LinearAlgebra.Eigenspace.JointEigenvector.Basic

/-!
# The full Hecke algebra of the newspace

The new subspace `S_k(Γ₁(N))ⁿᵉʷ` is stable under `T_p` at every prime `p`, the primes dividing
the level included (where `T_p = U_p`), and under the diamond operators. This file defines the
algebras these operators generate on the new subspace, over `ℂ` and over `ℚ`, and the character
of each normalized newform on them: its value on `T_p` is the Fourier coefficient `a_p` at every
prime `p`, and its value on `⟨u⟩` is the nebentypus value `χ(u)`.

Unlike `TauCeti.heckeTDiamondCuspNewRationalAlgebra`, which holds only the good `T_p`, the
rational algebra here sees the Fourier coefficients at the primes dividing the level.

## Main definitions

* `TauCeti.heckeTCuspNatNewEnd`: the restriction of `T_p` to the new subspace, at every prime.
* `TauCeti.heckeTDiamondCuspNewFullAlgebra`: the complex algebra generated on the new subspace by
  every `T_p` and every diamond operator.
* `TauCeti.heckeTDiamondCuspNewFullRationalAlgebra`: the rational algebra they generate.
* `TauCeti.Newform.heckeTDiamondCuspNewFullRationalCharacter f`: the character of a newform `f`
  on the rational algebra.

## References

* [F. Diamond and J. Shurman, *A first course in modular forms*][diamondshurman2005],
  Proposition 5.6.2 and Theorem 5.8.2.
-/

public noncomputable section

open Matrix.SpecialLinearGroup UpperHalfPlane CongruenceSubgroup HeckeRing.GL2
open scoped MatrixGroups

namespace TauCeti

variable (N : ℕ) [NeZero N] (k : ℤ)

/-- The restriction of the Hecke operator `T_p` to the new subspace, at any prime `p`. -/
def heckeTCuspNatNewEnd {p : ℕ} (hp : p.Prime) : Module.End ℂ (cuspFormsNew N k) :=
  (@heckeTCuspNat N _ k p ⟨hp.ne_zero⟩).restrict
    (fun _ hf ↦ heckeTCuspNat_mem_cuspFormsNew hp hf)

@[simp]
theorem coe_heckeTCuspNatNewEnd_apply {p : ℕ} (hp : p.Prime) (f : cuspFormsNew N k) :
    (heckeTCuspNatNewEnd N k hp f : CuspForm ((Gamma1 N).map (mapGL ℝ)) k) =
      @heckeTCuspNat N _ k p ⟨hp.ne_zero⟩ f :=
  (rfl)

/-- The generators of the full newspace Hecke algebra: `T_p` at every prime `p` and the diamond
operators. -/
def heckeTDiamondCuspNewFullGenerators : Set (Module.End ℂ (cuspFormsNew N k)) :=
  Set.range (fun p : {p : ℕ // p.Prime} ↦ heckeTCuspNatNewEnd N k p.2) ∪
    Set.range (diamondOpCuspNewEnd N k)

/-- The complex Hecke algebra on the new subspace generated by `T_p` at every prime `p` and the
diamond operators. -/
def heckeTDiamondCuspNewFullAlgebra : Subalgebra ℂ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.adjoin ℂ (heckeTDiamondCuspNewFullGenerators N k)

/-- The rational Hecke algebra on the new subspace generated by `T_p` at every prime `p` and the
diamond operators. -/
def heckeTDiamondCuspNewFullRationalAlgebra : Subalgebra ℚ (Module.End ℂ (cuspFormsNew N k)) :=
  Algebra.adjoin ℚ (heckeTDiamondCuspNewFullGenerators N k)

@[simp]
theorem heckeTCuspNatNewEnd_mem_heckeTDiamondCuspNewFullRationalAlgebra {p : ℕ}
    (hp : p.Prime) :
    heckeTCuspNatNewEnd N k hp ∈ heckeTDiamondCuspNewFullRationalAlgebra N k :=
  Algebra.subset_adjoin (Or.inl ⟨⟨p, hp⟩, rfl⟩)

@[simp]
theorem diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewFullRationalAlgebra (u : (ZMod N)ˣ) :
    diamondOpCuspNewEnd N k u ∈ heckeTDiamondCuspNewFullRationalAlgebra N k :=
  Algebra.subset_adjoin (Or.inr ⟨u, rfl⟩)

/-- A rational algebra contains the full rational newspace Hecke algebra exactly when it
contains `T_p` at every prime `p` and every diamond operator. -/
theorem heckeTDiamondCuspNewFullRationalAlgebra_le_iff
    (A : Subalgebra ℚ (Module.End ℂ (cuspFormsNew N k))) :
    heckeTDiamondCuspNewFullRationalAlgebra N k ≤ A ↔
      (∀ (p : ℕ) (hp : p.Prime), heckeTCuspNatNewEnd N k hp ∈ A) ∧
        ∀ u : (ZMod N)ˣ, diamondOpCuspNewEnd N k u ∈ A := by
  rw [heckeTDiamondCuspNewFullRationalAlgebra, Algebra.adjoin_le_iff,
    heckeTDiamondCuspNewFullGenerators, Set.union_subset_iff, Set.range_subset_iff,
    Set.range_subset_iff]
  simp

/-- Every rational operator of the full newspace Hecke algebra lies in its complex algebra. -/
theorem heckeTDiamondCuspNewFullRationalAlgebra_le :
    heckeTDiamondCuspNewFullRationalAlgebra N k ≤
      (heckeTDiamondCuspNewFullAlgebra N k).restrictScalars ℚ :=
  Algebra.adjoin_le Algebra.subset_adjoin

/-- The natural inclusion of the full rational newspace Hecke algebra into its complex
algebra. -/
def heckeTDiamondCuspNewFullRationalAlgebraToComplex :
    heckeTDiamondCuspNewFullRationalAlgebra N k →ₐ[ℚ] heckeTDiamondCuspNewFullAlgebra N k :=
  (heckeTDiamondCuspNewFullRationalAlgebra N k).val.codRestrict _ fun T ↦
    heckeTDiamondCuspNewFullRationalAlgebra_le N k T.2

variable {N k}

/-- `T_p` acts on a newform basis vector by the Fourier coefficient `a_p`, at every prime. -/
@[simp]
theorem heckeTCuspNatNewEnd_basis {p : ℕ} (hp : p.Prime) (f : Newform N k) :
    heckeTCuspNatNewEnd N k hp (Newform.basis N k f) =
      (qExpansion 1 f.toCuspForm).coeff p • Newform.basis N k f := by
  apply Subtype.ext
  simpa using f.heckeTCuspNat_eq_qExpansion_coeff_smul hp

private theorem heckeTDiamondCuspNewFullAlgebra_apply_basis (f : Newform N k)
    (T : heckeTDiamondCuspNewFullAlgebra N k) :
    T.1 (Newform.basis N k f) =
      (Newform.basis N k).repr (T.1 (Newform.basis N k f)) f • Newform.basis N k f := by
  obtain ⟨c, hc⟩ := exists_smul_eq_of_mem_adjoin (v := Newform.basis N k f) (by
    rintro _ (⟨p, rfl⟩ | ⟨u, rfl⟩)
    · exact ⟨_, heckeTCuspNatNewEnd_basis p.2 f⟩
    · exact ⟨_, diamondOpCuspNewEnd_basis u f⟩) T.2
  simp [hc]

namespace Newform

open HeckeRing.GL2.Newform

/-- The complex character of the full newspace Hecke algebra associated with a normalized
newform: the eigenvalue of an operator on it. -/
def heckeTDiamondCuspNewFullCharacter (f : Newform N k) :
    heckeTDiamondCuspNewFullAlgebra N k →ₐ[ℂ] ℂ :=
  (heckeTDiamondCuspNewFullAlgebra N k).val.eigenvalueHomOfJointEigenvector
    (fun T ↦ (basis N k).repr (T.1 (basis N k f)) f) (basis N k f) (Module.Basis.ne_zero _ f)
    (fun T ↦ Module.End.mem_eigenspace_iff.mpr (heckeTDiamondCuspNewFullAlgebra_apply_basis f T))

/-- Every operator of the full newspace Hecke algebra acts on a newform by its character. -/
theorem apply_basis_eq_heckeTDiamondCuspNewFullCharacter_smul (f : Newform N k)
    (T : heckeTDiamondCuspNewFullAlgebra N k) :
    T.1 (basis N k f) = heckeTDiamondCuspNewFullCharacter f T • basis N k f := by
  rw [heckeTDiamondCuspNewFullCharacter, AlgHom.eigenvalueHomOfJointEigenvector_apply]
  exact heckeTDiamondCuspNewFullAlgebra_apply_basis f T

/-- The character of a newform on the full rational newspace Hecke algebra. -/
def heckeTDiamondCuspNewFullRationalCharacter (f : Newform N k) :
    heckeTDiamondCuspNewFullRationalAlgebra N k →ₐ[ℚ] ℂ :=
  ((heckeTDiamondCuspNewFullCharacter f).restrictScalars ℚ).comp
    (heckeTDiamondCuspNewFullRationalAlgebraToComplex N k)

/-- Every operator of the full rational newspace Hecke algebra acts on a newform by its
character. -/
theorem apply_basis_eq_heckeTDiamondCuspNewFullRationalCharacter_smul (f : Newform N k)
    (T : heckeTDiamondCuspNewFullRationalAlgebra N k) :
    T.1 (basis N k f) = heckeTDiamondCuspNewFullRationalCharacter f T • basis N k f :=
  apply_basis_eq_heckeTDiamondCuspNewFullCharacter_smul f
    (heckeTDiamondCuspNewFullRationalAlgebraToComplex N k T)

/-- The character on `T_p` is the Fourier coefficient `a_p`, at every prime `p`. -/
@[simp]
theorem heckeTDiamondCuspNewFullRationalCharacter_apply_heckeTCuspNatNewEnd (f : Newform N k)
    {p : ℕ} (hp : p.Prime) :
    heckeTDiamondCuspNewFullRationalCharacter f ⟨heckeTCuspNatNewEnd N k hp,
      heckeTCuspNatNewEnd_mem_heckeTDiamondCuspNewFullRationalAlgebra N k hp⟩ =
      (qExpansion 1 f.toCuspForm).coeff p := by
  apply smul_left_injective ℂ (Module.Basis.ne_zero (basis N k) f)
  exact (apply_basis_eq_heckeTDiamondCuspNewFullRationalCharacter_smul f _).symm.trans
    (heckeTCuspNatNewEnd_basis hp f)

/-- The character on a diamond operator is the nebentypus value. -/
@[simp]
theorem heckeTDiamondCuspNewFullRationalCharacter_apply_diamondOpCuspNewEnd (f : Newform N k)
    (u : (ZMod N)ˣ) :
    heckeTDiamondCuspNewFullRationalCharacter f ⟨diamondOpCuspNewEnd N k u,
      diamondOpCuspNewEnd_mem_heckeTDiamondCuspNewFullRationalAlgebra N k u⟩ =
      (f.χ u : ℂ) := by
  apply smul_left_injective ℂ (Module.Basis.ne_zero (basis N k) f)
  exact (apply_basis_eq_heckeTDiamondCuspNewFullRationalCharacter_smul f _).symm.trans
    (diamondOpCuspNewEnd_basis u f)

end Newform

end TauCeti
