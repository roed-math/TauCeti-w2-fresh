module

public import TauCeti.AlgebraicGeometry.Modules.FinitePresentation
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Adjunction
public import TauCeti.AlgebraicGeometry.RelativeProj.Affine
public import TauCeti.AlgebraicGeometry.RelativeProj.Proper
public import TauCeti.AlgebraicGeometry.RelativeProj.TwistingSheaf
public import TauCeti.LinearAlgebra.SymmetricAlgebra.Grading

/-!
# The relative `Proj` of a symmetric algebra

For a quasicoherent sheaf `F` on a scheme `X`, the graded symmetric algebra `Sym F = ⨁ₙ Symⁿ F`
(`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebra`) is generated in degree one, so the twisting
sheaves of its relative `Proj`, the projective bundle `ℙ(F) = Proj_X(Sym F)`, are invertible. Its
degree-zero part is `𝒪_X`, and it is of finite type over `X` when `F` is of finite type, so in that
case `ℙ(F) ⟶ X` is proper. Over an affine scheme `X`, `ℙ(F)` is the projective spectrum of the
symmetric algebra of the module of global sections of `F`.

## Main results

* `TauCeti.AlgebraicGeometry.isGeneratedInDegreeOne_gradedSymmetricAlgebra`: `Sym F` is generated
  in degree one;
* `TauCeti.AlgebraicGeometry.finiteType_sections_gradedSymmetricAlgebra`: over an affine open `U`,
  the sections `⨁ n, Γ(Symⁿ F, U)` form a `Γ(X, U)`-algebra of finite type when `F` is of finite
  type;
* `TauCeti.AlgebraicGeometry.finite_sections_gradedSymmetricAlgebra_zero`: over an affine open `U`,
  the sections of `Sym⁰ F` form a finite `Γ(X, U)`-module;
* `TauCeti.AlgebraicGeometry.isProper_relativeProjToBase_gradedSymmetricAlgebra`: `ℙ(F) ⟶ X` is
  proper when `F` is of finite type.
* `TauCeti.AlgebraicGeometry.projGradedSectionsGradingIso`: over an affine open `U`, the chart
  `Proj (⨁ n, Γ(Symⁿ F, U))` of `ℙ(F)` is `Proj (Sym Γ(F, U))`, over `Spec Γ(X, U)`;
* `TauCeti.AlgebraicGeometry.relativeProjGradedSymmetricAlgebraIso`: over an affine scheme `X`,
  `ℙ(F) ≅ Proj (Sym Γ(F, X))`, over `X`
  (`relativeProjGradedSymmetricAlgebraIso_inv_relativeProjToBase`).

## References

* The Stacks Project, [Tag 01O4](https://stacks.math.columbia.edu/tag/01O4).
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry GradedQuasicoherentAlgebra

universe u

variable {X : Scheme.{u}} (F : QuasicoherentSheaf X)

/-- **The symmetric algebra is generated in degree one**: over every affine open `U`, the ring
`⨁ n, Γ(Symⁿ F, U)` is generated by `Γ(Sym¹ F, U)` over `Γ(Sym⁰ F, U)`. -/
theorem isGeneratedInDegreeOne_gradedSymmetricAlgebra :
    ((gradedSymmetricAlgebra X).obj F).obj.IsGeneratedInDegreeOne :=
  CommMon.isGeneratedInDegreeOne_of_adjoin_eq_top fun _ hU ↦
    adjoin_gradedSectionsGrading_one_gradedSymmetricAlgebra F hU

/-- Over an affine open `U`, the sections `⨁ n, Γ(Symⁿ F, U)` of the symmetric algebra of a
quasicoherent sheaf of finite type form a `Γ(X, U)`-algebra of finite type: they are the symmetric
algebra of the finite module `Γ(F, U)` (`gradedSymmetricAlgebraSectionsEquiv`). -/
theorem finiteType_sections_gradedSymmetricAlgebra [F.obj.IsFiniteType] {U : X.Opens}
    (hU : IsAffineOpen U) :
    Algebra.FiniteType Γ(X, U)
      (⨁ n, Γ(((gradedSymmetricAlgebra X).obj F).obj.X n, U)) :=
  have : Module.Finite Γ(X, U)
      (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (Opposite.op U)) :=
    Scheme.Modules.finite_sections_of_isAffineOpen F.obj U hU
  .equiv inferInstance (gradedSymmetricAlgebraSectionsEquiv F hU)

/-- Over an affine open `U`, the sections of `Sym⁰ F ≅ 𝒪_X` form a finite `Γ(X, U)`-module: the
unit `Γ(X, U) → Γ(Sym⁰ F, U)` of the symmetric algebra is surjective. -/
theorem finite_sections_gradedSymmetricAlgebra_zero (U : X.Opens) :
    Module.Finite Γ(X, U) Γ(((gradedSymmetricAlgebra X).obj F).obj.X 0, U) := by
  let A := ((gradedSymmetricAlgebra X).obj F).obj
  have : IsIso A.toMon.one := by
    have hi {B C : X.Modules} (p : B = C) : IsIso (eqToHom p) := (eqToIso p).isIso_hom
    rw [one_gradedSymmetricAlgebra]
    exact @IsIso.comp_isIso _ _ _ _ _ _ _
      (inferInstanceAs (IsIso ((SheafOfModules.symmetricPowerZeroIso X.sheaf).inv.app F.obj)))
      (hi _)
  refine Module.Finite.of_surjective (Functor.LaxMonoidal.ε (Scheme.Modules.sectionsFunctor U) ≫
    (Scheme.Modules.sectionsFunctor U).map A.toMon.one).hom ?_
  have : IsIso (Functor.LaxMonoidal.ε (Scheme.Modules.sectionsFunctor U)) := by
    rw [Scheme.Modules.sectionsFunctor_ε]
    exact IsIso.id _
  exact (ConcreteCategory.bijective_of_isIso _).2

/-- **The projective bundle of a quasicoherent sheaf of finite type is proper**:
`ℙ(F) = Proj_X(Sym F) ⟶ X` is proper. -/
theorem isProper_relativeProjToBase_gradedSymmetricAlgebra [F.obj.IsFiniteType] :
    IsProper ((gradedSymmetricAlgebra X).obj F).obj.relativeProjToBase :=
  CommMon.isProper_relativeProjToBase (fun _ hU ↦ finiteType_sections_gradedSymmetricAlgebra F hU)
    (fun U _ ↦ finite_sections_gradedSymmetricAlgebra_zero F U)

section Affine

open Opposite

variable {U : X.Opens} (hU : IsAffineOpen U)

/-- The isomorphism `Sym Γ(F, U) ≅ ⨁ n, Γ(Symⁿ F, U)` of `gradedSymmetricAlgebraSectionsEquiv`
over an affine open `U`, as a graded ring homomorphism. -/
noncomputable def gradedSymmetricAlgebraSectionsGradedHom :
    TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, U)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op U)) →+*ᵍ
      ((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U where
  toRingHom := (gradedSymmetricAlgebraSectionsEquiv F hU : _ →+* _)
  map_mem := gradedSymmetricAlgebraSectionsEquiv_mem F hU

/-- The inverse of `gradedSymmetricAlgebraSectionsGradedHom`, as a graded ring homomorphism. -/
noncomputable def gradedSymmetricAlgebraSectionsGradedHomInv :
    ((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U →+*ᵍ
      TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, U)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op U)) where
  toRingHom := ((gradedSymmetricAlgebraSectionsEquiv F hU).symm : _ →+* _)
  map_mem := gradedSymmetricAlgebraSectionsEquiv_symm_mem F hU

/-- Over an affine open `U`, the chart `Proj (⨁ n, Γ(Symⁿ F, U))` of the projective bundle is the
projective spectrum `Proj (Sym Γ(F, U))` of the symmetric algebra of the sections. -/
noncomputable def projGradedSectionsGradingIso :
    Proj (((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U) ≅
      Proj (TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, U)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op U))) :=
  Proj.mapIso (gradedSymmetricAlgebraSectionsGradedHom F hU)
    (gradedSymmetricAlgebraSectionsGradedHomInv F hU)
    (gradedSymmetricAlgebraSectionsEquiv F hU).apply_symm_apply
    (gradedSymmetricAlgebraSectionsEquiv F hU).symm_apply_apply

/-- `projGradedSectionsGradingIso` lies over `Spec Γ(X, U)`. -/
@[reassoc]
theorem projGradedSectionsGradingIso_hom_toSpecCoeff :
    (projGradedSectionsGradingIso F hU).hom ≫
        Proj.toSpecCoeff (TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, U)
          (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op U))) =
      Proj.toSpecCoeff (((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U) := by
  have hR (r : Γ(X, U)) : (gradedSymmetricAlgebraSectionsGradedHom F hU).gradedZeroRingHom
      (algebraMap Γ(X, U) _ r) = algebraMap Γ(X, U) _ r :=
    Subtype.ext ((gradedSymmetricAlgebraSectionsEquiv F hU).commutes r)
  have h := Proj.map_toSpecCoeff _ _
    (HomogeneousIdeal.irrelevant_le_map_of_surjective _
      (gradedSymmetricAlgebraSectionsEquiv F hU).surjective) hR
  have e : (projGradedSectionsGradingIso F hU).hom =
      Proj.map (gradedSymmetricAlgebraSectionsGradedHom F hU) _ :=
    Proj.mapIso_hom _ _ _ _
  rw [e]
  exact h

/-- **Over an affine scheme, the projective bundle is the `Proj` of a symmetric algebra**: for `X`
affine, `ℙ(F) = Proj_X(Sym F)` is `Proj (Sym Γ(F, X))`, through the chart of `ℙ(F)` over `X`. It
lies over `Spec Γ(X, X) ≅ X` (`relativeProjGradedSymmetricAlgebraIso_inv_relativeProjToBase`). -/
noncomputable def relativeProjGradedSymmetricAlgebraIso [IsAffine X] :
    ((gradedSymmetricAlgebra X).obj F).obj.relativeProj ≅
      Proj (TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, ⊤)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op ⊤))) :=
  (asIso (((gradedSymmetricAlgebra X).obj F).obj.relativeProjCover.f
    ⟨⊤, isAffineOpen_top X⟩)).symm ≪≫ projGradedSectionsGradingIso F (isAffineOpen_top X)

/-- Over an affine scheme `X`, the identification `ℙ(F) ≅ Proj (Sym Γ(F, X))` lies over `X`: the
structure morphism of `ℙ(F)` corresponds to the coefficient projection to `Spec Γ(X, X)` followed
by `Spec Γ(X, X) ≅ X`. -/
@[reassoc]
theorem relativeProjGradedSymmetricAlgebraIso_inv_relativeProjToBase [IsAffine X] :
    (relativeProjGradedSymmetricAlgebraIso F).inv ≫
        ((gradedSymmetricAlgebra X).obj F).obj.relativeProjToBase =
      Proj.toSpecCoeff (TauCeti.SymmetricAlgebra.homogeneousSubmodule Γ(X, ⊤)
        (PresheafOfModulesOfCommRing.obj (R := X.presheaf) F.obj.val (op ⊤))) ≫
          (isAffineOpen_top X).fromSpec := by
  let A := ((gradedSymmetricAlgebra X).obj F).obj
  change (projGradedSectionsGradingIso F (isAffineOpen_top X)).inv ≫
    A.relativeProjCover.f ⟨⊤, isAffineOpen_top X⟩ ≫ A.relativeProjToBase = _
  rw [(Iso.eq_inv_comp _).mpr (projGradedSectionsGradingIso_hom_toSpecCoeff F (isAffineOpen_top X)),
    Category.assoc]
  exact congrArg ((projGradedSectionsGradingIso F (isAffineOpen_top X)).inv ≫ ·)
    (A.relativeProjCover_f_relativeProjToBase ⟨⊤, isAffineOpen_top X⟩)

end Affine

end TauCeti.AlgebraicGeometry
