public import TauCeti.AlgebraicGeometry.RelativeProj.TwistingSheaf
public import TauCeti.AlgebraicGeometry.RelativeProj.TwistingSheafPullback

/-!
# The relative `Proj` of an algebra generated in degree one embeds in `Proj_X(Sym A₁)`

Let `A` be a graded quasicoherent algebra on a scheme `X` which is *generated in degree one*: over
every affine open `U` of `X`, the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by `Γ(A₁, U)`
as an algebra over `Γ(A₀, U)`. Let `φ : Sym A₁ ⟶ A` be the morphism of graded quasicoherent
algebras extending the identity of `A₁` (`TauCeti.AlgebraicGeometry.gradedSymmetricAlgebraLift`),
and `f : Proj_X(A) ⟶ Proj_X(Sym A₁)` the morphism it induces. Then (Stacks, Lemmas 27.11.3 and
27.11.5 (01N0, 01N1), on affine charts):

* `φ` is surjective in every positive degree;
* `f` is a closed immersion over `X`;
* `f` pulls the twisting sheaves `𝒪(n)` of `Proj_X(Sym A₁)` back to the twisting sheaves `𝒪(n)` of
  `Proj_X(A)`: the glued morphism `f^* 𝒪(n) ⟶ 𝒪(n)` is an isomorphism;
* if `A₁` is of finite type, `Proj_X(A) ⟶ X` is proper.

The last point uses that the twisting sheaves of `Proj_X(Sym F)` are invertible for every
quasicoherent `F`, because the sections of `Sym F` over affine opens are generated in degree one.

## Main results

* `TauCeti.AlgebraicGeometry.isInvertible_relativeProjTwistingSheaf_gradedSymmetricAlgebra`: the
  twisting sheaves of `Proj_X(Sym F)` are invertible.
* `TauCeti.AlgebraicGeometry.isProper_relativeProjToBase_gradedSymmetricAlgebra`: `Proj_X(Sym F)`
  is proper over `X` for `F` of finite type.

In the namespace `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra`:

* `isIso_relativeProjTwistingSheafMap_gradedSymmetricAlgebraLift`: the closed immersion
  `Proj_X(A) ⟶ Proj_X(Sym A₁)` pulls `𝒪(n)` back to `𝒪(n)`.
* `relativeProj_closedImmersion`: the bundled statement for an algebra generated in degree one.
* `isProper_relativeProjToBase_of_adjoin_one_eq_top`: `Proj_X(A)` is proper over `X` when `A` is
  generated in degree one and `A₁` is of finite type.

When `A₁` is of finite type, the closed immersion `Proj_X(A) ⟶ Proj_X(Sym A₁)` over `X` exhibits
`Proj_X(A) ⟶ X` as a projective morphism in the sense of Stacks, Definition 29.43.1 (01W8). Tau
Ceti has no predicate for projective morphisms over a general base, so this file records the
closed immersion together with its consequence that `Proj_X(A) ⟶ X` is proper.

## References

* [The Stacks Project, Lemma 27.11.3 (01N0)](https://stacks.math.columbia.edu/tag/01N0)
* [The Stacks Project, Lemma 27.11.5 (01N1)](https://stacks.math.columbia.edu/tag/01N1)
* [The Stacks Project, Definition 29.43.1 (01W8)](https://stacks.math.columbia.edu/tag/01W8)
-/

public section

open CategoryTheory DirectSum

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry GradedQuasicoherentAlgebra

universe u

variable {X : Scheme.{u}}

/-- **The twisting sheaves of `Proj_X(Sym F)` are invertible**, for every quasicoherent sheaf `F`:
the sections of `Sym F` over affine opens are generated in degree one. -/
theorem isInvertible_relativeProjTwistingSheaf_gradedSymmetricAlgebra (F : QuasicoherentSheaf X)
    (n : ℤ) :
    SheafOfModules.isInvertible ((gradedSymmetricAlgebra X).obj F).obj.relativeProj
      (((gradedSymmetricAlgebra X).obj F).obj.relativeProjTwistingSheaf n) :=
  CommMon.isInvertible_relativeProjTwistingSheaf ((gradedSymmetricAlgebra X).obj F).obj
    (fun _ hU ↦ (GradedAlgebra.adjoin_zero_union_one_eq_top_iff _).mp
      (adjoin_zero_union_one_gradedSymmetricAlgebra_eq_top F hU)) n

/-- **`Proj_X(Sym F)` is proper over `X` when `F` is of finite type**: over every affine open `U`
of `X`, the sections of `Sym F` are generated by finitely many sections of degree one, and
`Γ(Sym⁰ F, U)` is a quotient of `Γ(X, U)`. -/
theorem isProper_relativeProjToBase_gradedSymmetricAlgebra (F : QuasicoherentSheaf X)
    [F.obj.IsFiniteType] :
    IsProper ((gradedSymmetricAlgebra X).obj F).obj.relativeProjToBase := by
  classical
  let B := ((gradedSymmetricAlgebra X).obj F).obj
  -- `Γ(Sym⁰ F, U)` is a quotient of `Γ(X, U)`: the unit `𝒪_X ⟶ Sym⁰ F` is an epimorphism, hence
  -- surjective on sections over affine opens.
  have h₀ (U : X.Opens) (hU : IsAffineOpen U) : Module.Finite Γ(X, U) Γ(B.X 0, U) := by
    refine Module.Finite.of_surjective (Functor.LaxMonoidal.ε (Scheme.Modules.sectionsFunctor U) ≫
      (Scheme.Modules.sectionsFunctor U).map B.toMon.one).hom ?_
    have : IsIso (Functor.LaxMonoidal.ε (Scheme.Modules.sectionsFunctor U)) := by
      rw [Scheme.Modules.sectionsFunctor_ε]
      exact IsIso.id _
    exact (@Scheme.Modules.Hom.app_surjective_of_epi_of_isAffineOpen _ _ _ B.toMon.one
      inferInstance inferInstance (inferInstanceAs (B.X 0).IsQuasicoherent) U hU).comp
        (ConcreteCategory.bijective_of_isIso
          (Functor.LaxMonoidal.ε (Scheme.Modules.sectionsFunctor U))).2
  refine CommMon.isProper_relativeProjToBase (fun U hU ↦ ?_) h₀
  -- `Γ(Sym¹ F, U) ≅ Γ(F, U)` is a finite `Γ(X, U)`-module, since `F` is of finite type.
  have := h₀ U hU
  have : Module.Finite Γ(X, U) ((Scheme.Modules.sectionsFunctor U).obj F.obj) :=
    Scheme.Modules.finite_sections_of_isAffineOpen F.obj U hU
  have : Module.Finite Γ(X, U) Γ(B.X 1, U) := Module.Finite.equiv
    ((Scheme.Modules.sectionsFunctor U).mapIso (Iso.refl F.obj ≪≫ ((ObjectProperty.ι _).mapIso
      ((gradedSymmetricAlgebraDegreeOneIso X).app F)).symm ≪≫
        eqToIso (degree_obj_obj ((gradedSymmetricAlgebra X).obj F) 1))).toLinearEquiv
  -- Finitely many sections of degrees `0` and `1` generate, as `Γ(Sym⁰ F, U) ∪ Γ(Sym¹ F, U)` does.
  obtain ⟨s₀, hs₀⟩ := Module.Finite.fg_top (R := Γ(X, U)) (M := Γ(B.X 0, U))
  obtain ⟨s₁, hs₁⟩ := Module.Finite.fg_top (R := Γ(X, U)) (M := Γ(B.X 1, U))
  let ι (i : ℕ) := DirectSum.lof Γ(X, U) ℕ (fun n ↦ Γ(B.X n, U)) i
  refine ⟨⟨s₀.image (ι 0) ∪ s₁.image (ι 1), eq_top_iff.mpr ?_⟩⟩
  rw [← adjoin_zero_union_one_gradedSymmetricAlgebra_eq_top F hU, Algebra.adjoin_le_iff]
  refine Set.union_subset (fun _ hx ↦ ?_) (fun _ hx ↦ ?_) <;>
    obtain ⟨x, rfl⟩ := DirectSum.mem_summand.mp hx <;>
    refine Algebra.span_le_adjoin Γ(X, U) _ (Submodule.span_mono (Finset.coe_union _ _).ge ?_)
  · refine Submodule.span_mono Set.subset_union_left ?_
    rw [Finset.coe_image, Submodule.span_image]
    exact Submodule.mem_map_of_mem (hs₀ ▸ Submodule.mem_top)
  · refine Submodule.span_mono Set.subset_union_right ?_
    rw [Finset.coe_image, Submodule.span_image]
    exact Submodule.mem_map_of_mem (hs₁ ▸ Submodule.mem_top)

namespace GradedQuasicoherentAlgebra

variable (A : GradedQuasicoherentAlgebra X)
  (h : ∀ U : X.Opens, IsAffineOpen U →
    Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤)

/-- **`Proj_X(A) ⟶ Proj_X(Sym A₁)` pulls `𝒪(n)` back to `𝒪(n)`.** If over every affine open `U`
of `X` the graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by its homogeneous elements of
degrees `0` and `1`, then the glued morphism `f^* 𝒪(n) ⟶ 𝒪(n)` of twisting sheaves along the
morphism `f : Proj_X(A) ⟶ Proj_X(Sym A₁)` induced by `Sym A₁ ⟶ A` is an isomorphism. -/
@[stacks 01N1]
theorem isIso_relativeProjTwistingSheafMap_gradedSymmetricAlgebraLift (n : ℤ) :
    IsIso (CommMon.relativeProjTwistingSheafMap
      (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom
      (CommMon.irrelevant_le_map_gradedSectionsGradedHom_of_grade_subset_range _
        fun U hU ↦ grade_subset_range_gradedSymmetricAlgebraLift A U hU (h U hU)) n) :=
  CommMon.isIso_relativeProjTwistingSheafMap _ _ n
    (isInvertible_relativeProjTwistingSheaf_gradedSymmetricAlgebra (degreeOne.obj A) n)
    fun U ↦ exists_mem_basicOpen_gradedSymmetricAlgebraLift A U.toOpens U.2 (h U.toOpens U.2)

/-- **The relative `Proj` of an algebra generated in degree one is a closed subscheme of
`Proj_X(Sym A₁)`.** Let `A` be generated in degree one: over every affine open `U` of `X`, the
graded ring of sections `⨁ n, Γ(Aₙ, U)` is generated by `Γ(A₁, U)` as an algebra over `Γ(A₀, U)`.
Then the morphism `Sym A₁ ⟶ A` extending the identity of `A₁` is an epimorphism in every positive
degree, and the morphism `f : Proj_X(A) ⟶ Proj_X(Sym A₁)` it induces is a closed immersion over
`X` along which the glued morphisms `f^* 𝒪(n) ⟶ 𝒪(n)` of twisting sheaves are isomorphisms. -/
@[stacks 01N1]
theorem relativeProj_closedImmersion
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin (A.obj.gradedSectionsGrading U 0)
        (A.obj.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.obj.X n, U))) = ⊤) :
    (∀ i, 0 < i → Epi ((gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom.hom.hom i)) ∧
      ∃ hφ, IsClosedImmersion
          (CommMon.relativeProjMap (gradedSymmetricAlgebraLift (𝟙 (degreeOne.obj A))).hom hφ) ∧
        CommMon.relativeProjMap _ hφ ≫
            ((gradedSymmetricAlgebra X).obj (degreeOne.obj A)).obj.relativeProjToBase =
          A.obj.relativeProjToBase ∧
        ∀ n, IsIso (CommMon.relativeProjTwistingSheafMap _ hφ n) := by
  replace h U hU := (GradedAlgebra.adjoin_zero_union_one_eq_top_iff _).mpr (h U hU)
  exact ⟨epi_gradedSymmetricAlgebraLift A h, _,
    isClosedImmersion_relativeProjMap_gradedSymmetricAlgebraLift A h,
    CommMon.relativeProjMap_relativeProjToBase _ _,
    isIso_relativeProjTwistingSheafMap_gradedSymmetricAlgebraLift A h⟩

/-- **The relative `Proj` of an algebra generated in degree one by a finite type `A₁` is proper.**
If `A` is generated in degree one and `A₁` is of finite type, then `Proj_X(A) ⟶ X` is proper: it
factors as the closed immersion into `Proj_X(Sym A₁)` (`relativeProj_closedImmersion`) followed by
the proper morphism `Proj_X(Sym A₁) ⟶ X`. -/
theorem isProper_relativeProjToBase_of_adjoin_one_eq_top
    (h : ∀ U : X.Opens, IsAffineOpen U →
      Algebra.adjoin (A.obj.gradedSectionsGrading U 0)
        (A.obj.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.obj.X n, U))) = ⊤)
    [(A.obj.X 1).IsFiniteType] :
    IsProper A.obj.relativeProjToBase := by
  obtain ⟨-, hφ, hi, hf, -⟩ := relativeProj_closedImmersion A h
  have : (degreeOne.obj A).obj.IsFiniteType := (degree_obj_obj A 1) ▸ inferInstance
  have := isProper_relativeProjToBase_gradedSymmetricAlgebra (degreeOne.obj A)
  rw [← hf]
  infer_instance

end GradedQuasicoherentAlgebra

end TauCeti.AlgebraicGeometry
