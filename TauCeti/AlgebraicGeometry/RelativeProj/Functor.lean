/-!
# Functoriality of the relative `Proj`

Let `φ : A ⟶ B` be a morphism of graded algebras on a scheme `X` with quasi-coherent homogeneous
components. Over every affine open `U` of `X`, `φ` induces a graded ring homomorphism
`⨁ n, Γ(Aₙ, U) → ⨁ n, Γ(Bₙ, U)` (`CategoryTheory.CommMon.gradedSectionsGradedHom`). When the
irrelevant ideal of the target is contained in the ideal generated by the image of the irrelevant
ideal of the source over every affine open, these induce morphisms of projective spectra
`Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))` compatible with restriction to basic opens, which
glue to a morphism of relative `Proj`s

`Proj_X(B) ⟶ Proj_X(A)`

over `X`. Over each affine open it is the morphism of projective spectra, and the square it forms
with the charts is cartesian. When `φ` is surjective on sections over affine opens in positive
degrees, it is a closed immersion.

## Main definitions

* `CategoryTheory.CommMon.relativeProjMap φ hφ`: the morphism `Proj_X(B) ⟶ Proj_X(A)` induced by
  `φ : A ⟶ B`.
* `CategoryTheory.CommMon.relativeProjIso e`: the isomorphism `Proj_X(A) ≅ Proj_X(B)` induced by
  an isomorphism `e : A ≅ B` of graded algebras.

## Main results

* `CategoryTheory.CommMon.relativeProjMap_relativeProjToBase`: `relativeProjMap φ hφ` lies over `X`.
* `CategoryTheory.CommMon.relativeProjMap_id`, `CategoryTheory.CommMon.relativeProjMap_comp`:
  functoriality.
* `CategoryTheory.CommMon.isPullback_relativeProjMap`: over an affine open `U`, the morphism
  `relativeProjMap φ hφ` is `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`, as a cartesian square.
* `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap`: a morphism of graded algebras
  surjective on sections over affine opens in positive degrees induces a closed immersion of
  relative `Proj`s.

## References

* [The Stacks Project, Section 27.15, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique II*, §3.5.
-/

public section

open CategoryTheory Limits DirectSum

namespace TauCeti

open _root_.AlgebraicGeometry

universe u

noncomputable section

variable {X : Scheme.{u}} {A B : CommMon (GradedObject ℕ X.Modules)} (φ : A ⟶ B)

/-- The graded ring homomorphism `⨁ n, Γ(Aₙ, U) → ⨁ n, Γ(Bₙ, U)` induced by a morphism of graded
algebras `φ : A ⟶ B`. Its underlying ring homomorphism is `CategoryTheory.CommMon.gradedSectionsMap`
(`CategoryTheory.CommMon.gradedSectionsGradedHom_apply`). -/
def _root_.CategoryTheory.CommMon.gradedSectionsGradedHom (U : X.Opens) :
    A.gradedSectionsGrading U →+*ᵍ B.gradedSectionsGrading U where
  __ := (CommMon.gradedSectionsMap φ U).toRingHom
  map_mem {n x} hx := by
    obtain ⟨x, rfl⟩ := DirectSum.mem_summand.mp hx
    simpa using B.of_mem_gradedSectionsGrading n _

/-- The graded ring homomorphism induced on sections is `CategoryTheory.CommMon.gradedSectionsMap`.
-/
@[simp]
theorem _root_.CategoryTheory.CommMon.gradedSectionsGradedHom_apply (U : X.Opens)
    (x : ⨁ n, Γ(A.X n, U)) :
    CommMon.gradedSectionsGradedHom φ U x = CommMon.gradedSectionsMap φ U x :=
  (rfl)

/-- The graded ring homomorphisms induced on sections commute with restriction of sections. -/
theorem _root_.CategoryTheory.CommMon.gradedSectionsGradedHom_comp_restrictGradedSectionsGradedHom
    {U V : X.Opens} (i : V ⟶ U) :
    (CommMon.gradedSectionsGradedHom φ V).comp (A.restrictGradedSectionsGradedHom i) =
      (B.restrictGradedSectionsGradedHom i).comp (CommMon.gradedSectionsGradedHom φ U) :=
  GradedRingHom.ext fun x ↦ by
    simpa using CommMon.gradedSectionsMap_restrictGradedSections φ i x

/-- If `φ : A ⟶ B` is surjective on sections over `U` in every positive degree, the image of the
induced graded ring homomorphism contains every homogeneous element of positive degree. -/
theorem _root_.CategoryTheory.CommMon.gradedSectionsGrading_subset_range_gradedSectionsGradedHom
    {U : X.Opens} (h : ∀ n, 0 < n → Function.Surjective ((φ.hom.hom n).app U)) (n : ℕ)
    (hn : 0 < n) :
    (B.gradedSectionsGrading U n : Set (⨁ n, Γ(B.X n, U))) ⊆
      Set.range (CommMon.gradedSectionsGradedHom φ U) := by
  rintro _ hx
  obtain ⟨y, rfl⟩ := DirectSum.mem_summand.mp hx
  obtain ⟨x, rfl⟩ := h n hn y
  exact ⟨DirectSum.of _ n x, CommMon.gradedSectionsMap_of φ U n x⟩

/-- The condition on a morphism of graded algebras `φ : A ⟶ B` under which it induces a morphism
of relative `Proj`s: over every affine open `U`, the irrelevant ideal of `⨁ n, Γ(Bₙ, U)` is
contained in the ideal generated by the image of the irrelevant ideal of `⨁ n, Γ(Aₙ, U)`. -/
abbrev _root_.CategoryTheory.CommMon.IrrelevantLeMap : Prop :=
  ∀ U : X.AffineZariskiSite,
    HomogeneousIdeal.irrelevant (B.gradedSectionsGrading U.toOpens) ≤
      (HomogeneousIdeal.irrelevant (A.gradedSectionsGrading U.toOpens)).map
        (CommMon.gradedSectionsGradedHom φ U.toOpens)

open Scheme.AffineZariskiSite

variable {φ} in
/-- A morphism of graded algebras surjective on sections over affine opens in positive degrees
satisfies the irrelevant-ideal condition under which it induces a morphism of relative `Proj`s. -/
theorem _root_.CategoryTheory.CommMon.irrelevantLeMap_of_surjective
    (h : ∀ U : X.Opens, IsAffineOpen U → ∀ n, 0 < n → Function.Surjective ((φ.hom.hom n).app U)) :
    CommMon.IrrelevantLeMap φ := fun U ↦
  HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _
    (CommMon.gradedSectionsGrading_subset_range_gradedSectionsGradedHom φ (h U.toOpens U.2))

/-- An isomorphism of graded algebras satisfies the irrelevant-ideal condition, being bijective on
sections in every degree. -/
theorem _root_.CategoryTheory.CommMon.irrelevantLeMap_of_isIso [IsIso φ] :
    CommMon.IrrelevantLeMap φ :=
  CommMon.irrelevantLeMap_of_surjective fun U _ n _ ↦
    have : IsIso (φ.hom.hom n) :=
      inferInstanceAs (IsIso ((CommMon.forget _ ⋙ GradedObject.eval n).map φ))
    (ConcreteCategory.bijective_of_isIso ((Scheme.Modules.sectionsFunctor U).map
      (φ.hom.hom n))).2

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent]

/-- The morphisms of projective spectra `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))` induced by
`φ : A ⟶ B`, natural in the affine open `U`. -/
private def relativeProjGluingDataMap (hφ : CommMon.IrrelevantLeMap φ) :
    B.relativeProjGluingData.functor ⟶ A.relativeProjGluingData.functor where
  app U := Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U)
  naturality _ _ i :=
    -- `rw [← Proj.map_comp]` fails here: the instances of `Proj.map` are stated at
    -- `(toOpensFunctor X).obj V`, which is `V.toOpens` only up to unfolding.
    (Proj.map_comp _ _ _ _).symm.trans ((Proj.map_congr
      (CommMon.gradedSectionsGradedHom_comp_restrictGradedSectionsGradedHom φ
        ((toOpensFunctor X).map i)).symm _ _).trans (Proj.map_comp _ _ _ _))

/-- The **morphism of relative `Proj`s** `Proj_X(B) ⟶ Proj_X(A)` induced by a morphism of graded
algebras `φ : A ⟶ B` satisfying the irrelevant-ideal condition `CommMon.IrrelevantLeMap φ`: it is
glued from the morphisms `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))` over the affine opens `U`. -/
def _root_.CategoryTheory.CommMon.relativeProjMap (hφ : CommMon.IrrelevantLeMap φ) :
    B.relativeProj ⟶ A.relativeProj :=
  colimMap (relativeProjGluingDataMap φ hφ)

/-- On the chart over an affine open `U`, the morphism of relative `Proj`s is the morphism of
projective spectra `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`. -/
@[reassoc]
theorem _root_.CategoryTheory.CommMon.relativeProjCover_f_relativeProjMap
    (hφ : CommMon.IrrelevantLeMap φ) (U : X.AffineZariskiSite) :
    B.relativeProjCover.f U ≫ CommMon.relativeProjMap φ hφ =
      Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U) ≫ A.relativeProjCover.f U :=
  ι_colimMap (relativeProjGluingDataMap φ hφ) U

/-- The morphism of relative `Proj`s induced by `φ` lies over `X`. -/
@[reassoc (attr := simp)]
theorem _root_.CategoryTheory.CommMon.relativeProjMap_relativeProjToBase
    (hφ : CommMon.IrrelevantLeMap φ) :
    CommMon.relativeProjMap φ hφ ≫ A.relativeProjToBase = B.relativeProjToBase := by
  refine B.relativeProjCover.hom_ext _ _ fun U ↦ ?_
  -- The index `U` of the cover is an affine open of `X`, but only up to unfolding, so the chain
  -- is built with `Eq.trans` rather than `calc` or `rw`.
  refine (CommMon.relativeProjCover_f_relativeProjMap_assoc φ hφ U _).trans <|
    (congrArg (Proj.map _ (hφ U) ≫ ·) (A.relativeProjCover_f_relativeProjToBase U)).trans <|
      (Proj.map_toSpecCoeff_assoc _ _ _ ?_ _).trans
        (B.relativeProjCover_f_relativeProjToBase U).symm
  exact fun r ↦ Subtype.ext ((CommMon.gradedSectionsMap φ U.toOpens).commutes r)

/-- The identity of a graded algebra induces the identity of its relative `Proj`. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjMap_id (h : CommMon.IrrelevantLeMap (𝟙 A)) :
    CommMon.relativeProjMap (𝟙 A) h = 𝟙 A.relativeProj := by
  refine A.relativeProjCover.hom_ext _ _ fun U ↦ ?_
  -- As above, the chain is built with `Eq.trans` because `U` is an affine open only up to
  -- unfolding.
  refine (CommMon.relativeProjCover_f_relativeProjMap _ h U).trans <|
    ((congrArg (· ≫ A.relativeProjCover.f U) ((Proj.map_congr ?_ _ _).trans Proj.map_id)).trans
      (Category.id_comp _)).trans (Category.comp_id _).symm
  exact GradedRingHom.ext fun x ↦ by simp

omit [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent] in
/-- On the charts, the morphism of projective spectra induced by a composite is the composite of
the induced morphisms. -/
private lemma proj_map_gradedSectionsGradedHom_comp {C : CommMon (GradedObject ℕ X.Modules)}
    (ψ : B ⟶ C) (U : X.AffineZariskiSite) (hφ : CommMon.IrrelevantLeMap φ)
    (hψ : CommMon.IrrelevantLeMap ψ) (hφψ : CommMon.IrrelevantLeMap (φ ≫ ψ)) :
    Proj.map (CommMon.gradedSectionsGradedHom (φ ≫ ψ) U.toOpens) (hφψ U) =
      Proj.map (CommMon.gradedSectionsGradedHom ψ U.toOpens) (hψ U) ≫
        Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U) :=
  (Proj.map_congr (GradedRingHom.ext fun x ↦
    DFunLike.congr_fun (CommMon.gradedSectionsMap_comp φ ψ U.toOpens) x) _ _).trans
      (Proj.map_comp (CommMon.gradedSectionsGradedHom φ U.toOpens)
        (CommMon.gradedSectionsGradedHom ψ U.toOpens) (hφ U) (hψ U))

/-- The morphism of relative `Proj`s induced by a composite of morphisms of graded algebras is the
composite of the induced morphisms, in the opposite order. -/
theorem _root_.CategoryTheory.CommMon.relativeProjMap_comp
    {C : CommMon (GradedObject ℕ X.Modules)} [∀ n, (C.X n).IsQuasicoherent] (ψ : B ⟶ C)
    (hφ : CommMon.IrrelevantLeMap φ) (hψ : CommMon.IrrelevantLeMap ψ)
    (hφψ : CommMon.IrrelevantLeMap (φ ≫ ψ)) :
    CommMon.relativeProjMap (φ ≫ ψ) hφψ =
      CommMon.relativeProjMap ψ hψ ≫ CommMon.relativeProjMap φ hφ := by
  refine C.relativeProjCover.hom_ext _ _ fun U ↦ ?_
  refine (CommMon.relativeProjCover_f_relativeProjMap _ hφψ U).trans <|
    ((congrArg (· ≫ A.relativeProjCover.f U)
      (proj_map_gradedSectionsGradedHom_comp φ ψ U hφ hψ hφψ)).trans
        (Category.assoc _ _ _)).trans <|
      (congrArg (Proj.map _ (hψ U) ≫ ·)
        (CommMon.relativeProjCover_f_relativeProjMap φ hφ U).symm).trans
        (CommMon.relativeProjCover_f_relativeProjMap_assoc ψ hψ U _).symm

/-- The **isomorphism of relative `Proj`s** `Proj_X(A) ≅ Proj_X(B)` induced by an isomorphism of
graded algebras `e : A ≅ B`. Its forward morphism is induced by `e.inv`, since the relative `Proj`
is contravariant. -/
def _root_.CategoryTheory.CommMon.relativeProjIso (e : A ≅ B) :
    A.relativeProj ≅ B.relativeProj where
  hom := CommMon.relativeProjMap e.inv (CommMon.irrelevantLeMap_of_isIso e.inv)
  inv := CommMon.relativeProjMap e.hom (CommMon.irrelevantLeMap_of_isIso e.hom)
  hom_inv_id := by
    rw [← CommMon.relativeProjMap_comp _ _ _ _ (CommMon.irrelevantLeMap_of_isIso _)]
    simp only [Iso.hom_inv_id, CommMon.relativeProjMap_id]
  inv_hom_id := by
    rw [← CommMon.relativeProjMap_comp _ _ _ _ (CommMon.irrelevantLeMap_of_isIso _)]
    simp only [Iso.inv_hom_id, CommMon.relativeProjMap_id]

/-- The forward morphism of `CategoryTheory.CommMon.relativeProjIso e` is induced by `e.inv`. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjIso_hom (e : A ≅ B) :
    (CommMon.relativeProjIso e).hom =
      CommMon.relativeProjMap e.inv (CommMon.irrelevantLeMap_of_isIso e.inv) := by
  rfl

/-- The inverse of `CategoryTheory.CommMon.relativeProjIso e` is induced by `e.hom`. -/
@[simp]
theorem _root_.CategoryTheory.CommMon.relativeProjIso_inv (e : A ≅ B) :
    (CommMon.relativeProjIso e).inv =
      CommMon.relativeProjMap e.hom (CommMon.irrelevantLeMap_of_isIso e.hom) := by
  rfl

/-- **Over an affine open `U`, the morphism of relative `Proj`s is the morphism of projective
spectra** `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`: the square it forms with the charts
over `U` is cartesian, because both charts are the preimages of `U`. -/
theorem _root_.CategoryTheory.CommMon.isPullback_relativeProjMap (hφ : CommMon.IrrelevantLeMap φ)
    (U : X.AffineZariskiSite) :
    IsPullback (Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U))
      (B.relativeProjCover.f U) (A.relativeProjCover.f U) (CommMon.relativeProjMap φ hφ) := by
  refine IsPullback.of_right ?_ (CommMon.relativeProjCover_f_relativeProjMap φ hφ U).symm
    (A.isPullback_relativeProjCover U)
  rw [CommMon.relativeProjMap_relativeProjToBase, Proj.map_toSpecCoeff_assoc]
  · exact B.isPullback_relativeProjCover U
  · exact fun r ↦ Subtype.ext ((CommMon.gradedSectionsMap φ U.toOpens).commutes r)

/-- **A morphism of graded algebras surjective in positive degrees induces a closed immersion of
relative `Proj`s**: if `φ : A ⟶ B` is surjective on sections over every affine open in every
positive degree, then `Proj_X(B) ⟶ Proj_X(A)` is a closed immersion. Over each affine open `U` it
is `Proj (⨁ n, Γ(Bₙ, U)) ⟶ Proj (⨁ n, Γ(Aₙ, U))`, induced by a graded ring homomorphism
surjective in positive degrees. -/
theorem _root_.CategoryTheory.CommMon.isClosedImmersion_relativeProjMap
    (hφ : CommMon.IrrelevantLeMap φ)
    (h : ∀ U : X.Opens, IsAffineOpen U → ∀ n, 0 < n → Function.Surjective ((φ.hom.hom n).app U)) :
    IsClosedImmersion (CommMon.relativeProjMap φ hφ) := by
  refine IsZariskiLocalAtTarget.of_openCover A.relativeProjCover fun U ↦ ?_
  have hU := (CommMon.isPullback_relativeProjMap φ hφ U).flip
  have : IsClosedImmersion (Proj.map (CommMon.gradedSectionsGradedHom φ U.toOpens) (hφ U)) :=
    Proj.isClosedImmersion_map_of_grade_subset_range _ _
      (CommMon.gradedSectionsGrading_subset_range_gradedSectionsGradedHom φ (h U.toOpens U.2))
  -- The index `U` of the cover is an affine open of `X` only up to unfolding, so the square is
  -- compared with the pullback in a general statement rather than by rewriting.
  have key {P Q R T : Scheme.{u}} {fst : P ⟶ Q} {snd : P ⟶ R} {f : Q ⟶ T} {g : R ⟶ T}
      (hP : IsPullback fst snd f g) (hsnd : IsClosedImmersion snd) :
      IsClosedImmersion (pullback.snd f g) := by
    rw [← hP.isoPullback_inv_snd]
    infer_instance
  exact key hU this

end

end TauCeti
