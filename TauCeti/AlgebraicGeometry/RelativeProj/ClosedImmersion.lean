public import TauCeti.AlgebraicGeometry.Modules.AffineGlobalSections
public import TauCeti.AlgebraicGeometry.RelativeProj.Functor
public import TauCeti.AlgebraicGeometry.RelativeProj.SymmetricAlgebra
public import TauCeti.RingTheory.GradedAlgebra.DegreeOne

/-!
# Closed immersions of relative `Proj`s

Let `φ : A ⟶ B` be a morphism of graded algebras with quasi-coherent homogeneous components on a
scheme `X`, with `B` generated in degree one. If `φ` is surjective on sections over affine opens
in degree one, it is surjective on them in every positive degree, since the sections of positive
degree of `B` lie in the subsemiring generated by those of degree one. So `φ` induces a closed
immersion `Proj_X(B) ⟶ Proj_X(A)`.

Two cases are recorded:
* the counit `Sym A₁ ⟶ A` of the adjunction between the graded symmetric algebra and the degree-one
  component is an isomorphism in degree one, so the relative `Proj` of a graded quasicoherent
  algebra generated in degree one is a closed subscheme of the projective bundle
  `ℙ(A₁) = Proj_X(Sym A₁)`;
* an epimorphism `ψ : F ⟶ E` of quasicoherent sheaves induces a closed immersion
  `ℙ(E) ⟶ ℙ(F)` of projective bundles.

## Main results

* `CategoryTheory.CommMon.surjective_app_of_isGeneratedInDegreeOne`: a morphism of graded
  algebras into an algebra generated in degree one that is surjective on sections over an affine
  open in degree one is surjective on them in every positive degree.
* `CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_isGeneratedInDegreeOne`: such a
  morphism induces a closed immersion of relative `Proj`s.
* `TauCeti.AlgebraicGeometry.GradedQuasicoherentAlgebra.isClosedImmersion_relativeProjMap_counit`:
  for `A` generated in degree one, `Proj_X(A) ⟶ ℙ(A₁)` is a closed immersion.
* `TauCeti.AlgebraicGeometry.isClosedImmersion_relativeProjMap_gradedSymmetricAlgebra_map`: an
  epimorphism `F ⟶ E` of quasicoherent sheaves induces a closed immersion `ℙ(E) ⟶ ℙ(F)`.

## References

* [The Stacks Project, Section 27.15, Relative Proj](https://stacks.math.columbia.edu/tag/01NS)
* A. Grothendieck and J. Dieudonné, *Éléments de géométrie algébrique II*, §3.5 and §4.1.
-/

public section

open CategoryTheory DirectSum

namespace TauCeti

open _root_.AlgebraicGeometry

universe u

section General

variable {X : Scheme.{u}} {A B : CommMon (GradedObject ℕ X.Modules)}

/-- The degree-`n` component of the image of a section under the map induced by a morphism of
graded algebras is the image of its degree-`n` component. -/
private lemma gradedSectionsMap_apply_apply (φ : A ⟶ B) (U : X.Opens) (x : ⨁ n, Γ(A.X n, U))
    (n : ℕ) : CommMon.gradedSectionsMap φ U x n = (φ.hom.hom n).app U (x n) := by
  -- The sections are typed through `A.toMon.X`, which `rw` and `simp` do not identify with
  -- `A.X`, so the cases are closed by terms.
  induction x using DirectSum.induction_on with
  | zero =>
    simp only [map_zero, DirectSum.zero_apply]
    exact (map_zero _).symm
  | of i y =>
    rw [CommMon.gradedSectionsMap_of]
    by_cases hi : i = n
    · subst hi
      exact (DirectSum.of_eq_same _ _).trans (congrArg ((φ.hom.hom i).app U)
        (DirectSum.of_eq_same (β := fun n ↦ Γ(A.X n, U)) i y).symm)
    · exact (DirectSum.of_eq_of_ne _ _ _ (Ne.symm hi)).trans ((congrArg ((φ.hom.hom n).app U)
        (DirectSum.of_eq_of_ne (β := fun n ↦ Γ(A.X n, U)) i n y (Ne.symm hi))).trans
          (map_zero _)).symm
  | add x y hx hy =>
    rw [map_add, DirectSum.add_apply, DirectSum.add_apply, hx, hy]
    exact (map_add _ _ _).symm

/-- **Surjectivity in degree one propagates to positive degrees**: if `B` is generated in degree
one and `φ : A ⟶ B` is surjective on sections over an affine open `U` in degree one, then it is
surjective on sections over `U` in every degree `n > 0`. The sections of positive degree of `B` lie
in the subsemiring generated by those of degree one (`TauCeti.GradedAlgebra.mem_closure_grade_one`),
which lies in the image of `φ`. -/
theorem _root_.CategoryTheory.CommMon.surjective_app_of_isGeneratedInDegreeOne (φ : A ⟶ B)
    (hB : B.IsGeneratedInDegreeOne) {U : X.Opens} (hU : IsAffineOpen U)
    (h₁ : Function.Surjective ((φ.hom.hom 1).app U)) (n : ℕ) (hn : 0 < n) :
    Function.Surjective ((φ.hom.hom n).app U) := by
  let f := CommMon.gradedSectionsMap φ U
  -- The image of `f` contains the sections of degree one, hence those of every positive degree.
  have hle : Subsemiring.closure (B.gradedSectionsGrading U 1 : Set (⨁ n, Γ(B.X n, U))) ≤
      f.toRingHom.rangeS := by
    refine Subsemiring.closure_le.mpr fun z hz ↦ ?_
    obtain ⟨y, rfl⟩ := DirectSum.mem_summand.mp hz
    obtain ⟨x, rfl⟩ := h₁ y
    exact ⟨DirectSum.of _ 1 x, CommMon.gradedSectionsMap_of φ U 1 x⟩
  intro y
  obtain ⟨w, hw⟩ := hle (GradedAlgebra.mem_closure_grade_one _ hn
    (B.isGeneratedInDegreeOne_iff.mp hB U hU) (B.of_mem_gradedSectionsGrading n y))
  refine ⟨w n, ?_⟩
  have := congrArg (· n) hw
  simp only [f, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at this
  rw [gradedSectionsMap_apply_apply] at this
  exact this.trans (DirectSum.of_eq_same _ _)

/-- A morphism of graded algebras surjective in degree one onto an algebra generated in degree one
satisfies the irrelevant-ideal condition under which it induces a morphism of relative `Proj`s. -/
theorem _root_.CategoryTheory.CommMon.irrelevantLeMap_of_isGeneratedInDegreeOne (φ : A ⟶ B)
    (hB : B.IsGeneratedInDegreeOne)
    (h₁ : ∀ U : X.Opens, IsAffineOpen U → Function.Surjective ((φ.hom.hom 1).app U)) :
    CommMon.IrrelevantLeMap φ :=
  CommMon.irrelevantLeMap_of_surjective fun _ hU ↦
    CommMon.surjective_app_of_isGeneratedInDegreeOne φ hB hU (h₁ _ hU)

variable [∀ n, (A.X n).IsQuasicoherent] [∀ n, (B.X n).IsQuasicoherent]

/-- **A morphism of graded algebras surjective in degree one onto an algebra generated in degree
one induces a closed immersion of relative `Proj`s**: if `B` is generated in degree one and
`φ : A ⟶ B` is surjective on sections over affine opens in degree one, then
`Proj_X(B) ⟶ Proj_X(A)` is a closed immersion. -/
theorem _root_.CategoryTheory.CommMon.isClosedImmersion_relativeProjMap_of_isGeneratedInDegreeOne
    (φ : A ⟶ B) (hB : B.IsGeneratedInDegreeOne)
    (h₁ : ∀ U : X.Opens, IsAffineOpen U → Function.Surjective ((φ.hom.hom 1).app U))
    (hφ : CommMon.IrrelevantLeMap φ) : IsClosedImmersion (CommMon.relativeProjMap φ hφ) :=
  CommMon.isClosedImmersion_relativeProjMap φ hφ fun _ hU ↦
    CommMon.surjective_app_of_isGeneratedInDegreeOne φ hB hU (h₁ _ hU)

end General

namespace AlgebraicGeometry

open GradedQuasicoherentAlgebra

variable {X : Scheme.{u}}

/-- The transports `eqToHom` between module sheaves are isomorphisms. Typeclass search does not
find this instance in `X.Modules`, so it is supplied by hand. -/
private lemma isIso_eqToHom {B C : X.Modules} (p : B = C) : IsIso (eqToHom p) :=
  (eqToIso p).isIso_hom

/-- The degree-one component of the counit `Sym A₁ ⟶ A` is an isomorphism: through the
identification `A₁ ≅ Sym¹ A₁`, it is the identity of `A₁`. -/
instance GradedQuasicoherentAlgebra.isIso_counit_app_hom_hom_hom_one
    (A : GradedQuasicoherentAlgebra X) :
    IsIso (((gradedSymmetricAlgebraAdjunction X).counit.app A).hom.hom.hom 1) := by
  let c := (gradedSymmetricAlgebraAdjunction X).counit.app A
  have h := gradedSymmetricAlgebraDegreeOneIso_inv_app_comp_degreeOne_map_lift
    (𝟙 (degreeOne.obj A))
  rw [← gradedSymmetricAlgebraAdjunction_counit_app] at h
  have : IsIso ((gradedSymmetricAlgebraDegreeOneIso X).inv.app (degreeOne.obj A) ≫
      degreeOne.map c) := by
    rw [h]
    exact IsIso.id _
  have := IsIso.of_isIso_comp_left ((gradedSymmetricAlgebraDegreeOneIso X).inv.app
    (degreeOne.obj A)) (degreeOne.map c)
  -- The degree-one functor sends a morphism to its degree-one component, up to transports.
  have h₁ : IsIso ((degreeOne.map c).hom) := Functor.map_isIso (ObjectProperty.ι _) _
  rw [degree_map_hom] at h₁
  have h₂ := @IsIso.of_isIso_comp_left _ _ _ _ _ _ _ (isIso_eqToHom _) h₁
  exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (isIso_eqToHom _) h₂

/-- **The relative `Proj` of an algebra generated in degree one is a closed subscheme of
`ℙ(A₁)`**: for a graded quasicoherent algebra `A` generated in degree one, the counit
`Sym A₁ ⟶ A`, an isomorphism in degree one, induces a closed immersion
`Proj_X(A) ⟶ Proj_X(Sym A₁)` over `X`
(`CategoryTheory.CommMon.relativeProjMap_relativeProjToBase`). The irrelevant-ideal condition is
supplied by `CategoryTheory.CommMon.irrelevantLeMap_of_isGeneratedInDegreeOne`. -/
theorem GradedQuasicoherentAlgebra.isClosedImmersion_relativeProjMap_counit
    (A : GradedQuasicoherentAlgebra X) (hA : A.obj.IsGeneratedInDegreeOne)
    (hφ : CommMon.IrrelevantLeMap ((gradedSymmetricAlgebraAdjunction X).counit.app A).hom) :
    IsClosedImmersion (CommMon.relativeProjMap _ hφ) :=
  CommMon.isClosedImmersion_relativeProjMap_of_isGeneratedInDegreeOne _ hA
    (fun _ _ ↦ (ConcreteCategory.bijective_of_isIso ((Scheme.Modules.sectionsFunctor _).map
      (((gradedSymmetricAlgebraAdjunction X).counit.app A).hom.hom.hom 1))).2) hφ

/-- The degree-one component of the morphism of symmetric algebras induced by an epimorphism of
quasicoherent sheaves is an epimorphism: through the identifications `F ≅ Sym¹ F`, it is the
epimorphism itself. -/
instance epi_gradedSymmetricAlgebra_map_hom_hom_hom_one {F E : QuasicoherentSheaf X} (ψ : F ⟶ E)
    [Epi ψ.hom] : Epi (((gradedSymmetricAlgebra X).map ψ).hom.hom.hom 1) := by
  let e := gradedSymmetricAlgebraDegreeOneIso X
  have h : degreeOne.map ((gradedSymmetricAlgebra X).map ψ) =
      (e.app F).hom ≫ ψ ≫ (e.app E).inv := by
    rw [← Category.assoc, Iso.eq_comp_inv]
    exact e.hom.naturality ψ
  have hi {P Q : QuasicoherentSheaf X} (g : P ≅ Q) : IsIso g.hom.hom :=
    Functor.map_isIso (ObjectProperty.ι _) g.hom
  have := hi (e.app F)
  have := hi (e.app E).symm
  -- As for `eqToHom` above, typeclass search does not combine these instances in `X.Modules`,
  -- so the composites are formed by hand.
  have h₁ : Epi (degreeOne.map ((gradedSymmetricAlgebra X).map ψ)).hom := by
    rw [h]
    exact @epi_comp _ _ _ _ _ _ inferInstance _
      (@epi_comp _ _ _ _ _ _ inferInstance _ inferInstance)
  rw [degree_map_hom] at h₁
  have h₂ := @epi_of_epi _ _ _ _ _ _ _ h₁
  exact (@epi_comp_iff_of_isIso _ _ _ _ _ _ _ (isIso_eqToHom _)).mp h₂

/-- **An epimorphism of quasicoherent sheaves induces a closed immersion of projective bundles**:
for an epimorphism `ψ : F ⟶ E` of quasicoherent sheaves, the morphism of symmetric algebras
`Sym F ⟶ Sym E` induces a closed immersion `ℙ(E) ⟶ ℙ(F)` over `X`. The irrelevant-ideal condition
is supplied by `CategoryTheory.CommMon.irrelevantLeMap_of_isGeneratedInDegreeOne`. -/
theorem isClosedImmersion_relativeProjMap_gradedSymmetricAlgebra_map {F E : QuasicoherentSheaf X}
    (ψ : F ⟶ E) [Epi ψ.hom]
    (hφ : CommMon.IrrelevantLeMap ((gradedSymmetricAlgebra X).map ψ).hom) :
    IsClosedImmersion (CommMon.relativeProjMap _ hφ) :=
  CommMon.isClosedImmersion_relativeProjMap_of_isGeneratedInDegreeOne _
    (isGeneratedInDegreeOne_gradedSymmetricAlgebra E)
    (fun U hU ↦ @Scheme.Modules.Hom.app_surjective_of_epi_of_isAffineOpen _ _ _ _ _
      (inferInstanceAs (((gradedSymmetricAlgebra X).obj F).obj.X 1).IsQuasicoherent)
      (inferInstanceAs (((gradedSymmetricAlgebra X).obj E).obj.X 1).IsQuasicoherent) U hU) hφ

end AlgebraicGeometry

end TauCeti
