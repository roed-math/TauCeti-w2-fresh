module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.CyclicSubgroup
public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.NaiveExactOrder.Basic
import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.ExactOrder.Comparison

/-!
# Naive cyclic subgroups of elliptic curves

Over a base on which `N` is invertible, the `N`-torsion `E[N]` of an elliptic curve is finite
étale (Katz–Mazur 2.3.1), and the cyclic subgroups of order `N` need no Drinfeld divisor
condition. A *naive cyclic subgroup of order `N`* of an elliptic curve `E` over `S`
(`EllipticCurveGeom.IsNaiveCyclicSubgroup`) is a closed subgroup scheme of `E`, finite locally
free of constant rank `N` over `S`, which is étale-locally on `S` generated by a single section:
there is an étale surjection `T ⟶ S` and, on the base change `E_T`, a point `P` of naive exact
order `N` (`EllipticCurveGeom.IsOfNaiveExactOrder`), that is of exact order `N` in every fibre,
such that the inverse image of the subgroup on `E_T` is the divisor `[P] + ⋯ + [NP]`.

This is the naive `[Γ₀(N)]`-structure of the roadmap's Layer 3N. Where `N` is invertible, a point
of naive exact order `N` generates a naive cyclic subgroup of order `N` over the base itself
(`EllipticCurveGeom.IsOfNaiveExactOrder.isNaiveCyclicSubgroup_multiplesDivisor`), since it then
has Drinfeld exact order (`EllipticCurveGeom.IsOfNaiveExactOrder.isOfExactOrder`). Naive cyclic
subgroups are stable under arbitrary base change (`EllipticCurveGeom.IsNaiveCyclicSubgroup.comap`):
the étale surjection and the local generator pull back.

## Main definitions

* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsNaiveCyclicSubgroup E I N`: the closed subscheme
  of `E` cut out by `I` is a naive cyclic subgroup of order `N`.

## Main results

* `EllipticCurveGeom.IsOfNaiveExactOrder.isNaiveCyclicSubgroup_multiplesDivisor`: where `N` is
  invertible, a point of naive exact order `N` generates a naive cyclic subgroup.
* `TauCeti.AlgebraicGeometry.EllipticCurveGeom.IsNaiveCyclicSubgroup.comap`: naive cyclic
  subgroups are stable under base change.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, 2.3.1 and §3.7 (naive level
  structures where `N` is invertible).
* D. Loeffler, *Modular curves*, lecture notes, Definition 3.8.1.
-/

public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory AlgebraicGeometry MonObj

universe u

namespace TauCeti.AlgebraicGeometry

namespace EllipticCurveGeom

variable {S : Scheme.{u}} (E : EllipticCurveGeom S)

/-- **Naive cyclic subgroups of order `N`** (Katz–Mazur, §3.7; Loeffler, Definition 3.8.1). The
closed subscheme `G` of an elliptic curve `E` over `S` cut out by the ideal sheaf `I` is a naive
cyclic subgroup of order `N` when it is a subgroup scheme of `E`, finite locally free of constant
rank `N` over `S`, and étale-locally on `S` generated by a single section: there is an étale
surjection `T ⟶ S` such that on the base change `E_T` of `E` to `T` the inverse image of `G` is
the divisor `[P] + ⋯ + [NP]` of a point `P` of `E_T` of exact order `N` in every fibre. It is the
naive `[Γ₀(N)]`-structure, meaningful over a base on which `N` is invertible. -/
structure IsNaiveCyclicSubgroup (I : E.carrier.IdealSheafData) (N : ℕ) : Prop where
  /-- The closed subscheme is a subgroup scheme of `E`. -/
  exists_grpObj_isMonHom : ∃ _ : GrpObj (Over.mk (I.subschemeι ≫ E.structureMap)),
    IsMonHom (Over.homMk I.subschemeι :
      Over.mk (I.subschemeι ≫ E.structureMap) ⟶ Over.mk E.structureMap)
  /-- The closed subscheme is finite over the base. -/
  isFinite : IsFinite (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme is flat over the base. -/
  flat : Flat (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme is locally of finite presentation over the base. -/
  locallyOfFinitePresentation : LocallyOfFinitePresentation (I.subschemeι ≫ E.structureMap)
  /-- The closed subscheme has rank `N` over every point of the base. -/
  finrank_eq (s : S) : (I.subschemeι ≫ E.structureMap).finrank s = N
  /-- Étale-locally on the base, the closed subscheme is generated by a point of exact order `N`
  in every fibre: after base change along an étale surjection `t : T ⟶ S`, it is the divisor
  `[P] + ⋯ + [NP]` of such a point `P`. -/
  exists_etale : ∃ (T : Scheme.{u}) (t : T ⟶ S) (_ : Etale t) (_ : Surjective t)
    (E' : EllipticCurveGeom T) (g : E'.carrier ⟶ E.carrier)
    (_ : IsPullback g E'.structureMap E.structureMap t) (_ : E'.zero ≫ g = t ≫ E.zero)
    (P : 𝟙_ (Over T) ⟶ Over.mk E'.structureMap),
      E'.IsOfNaiveExactOrder P N ∧ I.comap g = E'.multiplesDivisor P N

variable {E}

/-- **A point of naive exact order `N` generates a naive cyclic subgroup of order `N`** where `N`
is invertible: the divisor `[P] + ⋯ + [NP]` is then a subgroup scheme, finite locally free of rank
`N`, and it is generated by `P` over the base itself. -/
theorem IsOfNaiveExactOrder.isNaiveCyclicSubgroup_multiplesDivisor [NeZero N]
    {P : 𝟙_ (Over S) ⟶ Over.mk E.structureMap} (h : E.IsOfNaiveExactOrder P N)
    (hN : ∀ s : S, (N : S.residueField s) ≠ 0) :
    E.IsNaiveCyclicSubgroup (E.multiplesDivisor P N) N where
  exists_grpObj_isMonHom := isOfExactOrder_def.mp (h.isOfExactOrder hN)
  isFinite := inferInstance
  flat := inferInstance
  locallyOfFinitePresentation := inferInstance
  finrank_eq s := congrFun (finrank_multiplesDivisor P N) s
  exists_etale := ⟨S, 𝟙 S, inferInstance, inferInstance, E, 𝟙 _, .id_horiz _,
    (Category.comp_id _).trans (Category.id_comp _).symm, P, h, Scheme.IdealSheafData.comap_id _⟩

variable {I : E.carrier.IdealSheafData} {N : ℕ}

section BaseChange

variable {S' : Scheme.{u}} {E' : EllipticCurveGeom S'} {g : E'.carrier ⟶ E.carrier}
  {f : S' ⟶ S} (hg : IsPullback g E'.structureMap E.structureMap f)
  (h0 : E'.zero ≫ g = f ≫ E.zero)

include hg h0 in
/-- **Naive cyclic subgroups are stable under base change.** Let `g : E' ⟶ E` be a morphism of
elliptic curves lying over `f : S' ⟶ S`, forming a pullback square with the structure morphisms
and carrying the zero section of `E'` to that of `E`. If the ideal sheaf `I` cuts out a naive
cyclic subgroup of `E` of order `N`, then its inverse image along `g` cuts out a naive cyclic
subgroup of `E'` of order `N`. -/
theorem IsNaiveCyclicSubgroup.comap (h : E.IsNaiveCyclicSubgroup I N) :
    E'.IsNaiveCyclicSubgroup (I.comap g) N := by
  have := h.isFinite
  have := h.flat
  have := h.locallyOfFinitePresentation
  -- The closed subscheme of `I.comap g` is the base change of that of `I` along `f`.
  have hsub := I.isPullback_subschemeMap_comap _ hg
  refine
    { exists_grpObj_isMonHom := exists_grpObj_isMonHom_comap hg h0 I h.exists_grpObj_isMonHom
      isFinite := MorphismProperty.of_isPullback hsub ‹_›
      flat := MorphismProperty.of_isPullback hsub ‹_›
      locallyOfFinitePresentation := MorphismProperty.of_isPullback hsub ‹_›
      finrank_eq s := by rw [I.finrank_comap_of_isPullback _ g _ f hg, h.finrank_eq]
      exists_etale := ?_ }
  obtain ⟨T, t, ht, hts, E₁, g₁, hg₁, h0₁, P, hP, hI⟩ := h.exists_etale
  -- Pull the étale surjection back along `f`, and pull the generator back to `S' ×_S T`.
  obtain ⟨E₂, g₂, k, hg₂, h0₂, hk, h0k, hkg⟩ := exists_isPullback_pullback_snd hg₁ h0₁ hg h0
  refine ⟨pullback f t, pullback.fst f t, inferInstance, inferInstance, E₂, g₂, hg₂, h0₂,
    pointsPullback hk h0k P, hP.pointsPullback hk h0k, ?_⟩
  rw [← Scheme.IdealSheafData.comap_comp, ← hkg, Scheme.IdealSheafData.comap_comp, hI]
  exact (multiplesDivisor_pointsPullback hk h0k P N).symm

end BaseChange

end EllipticCurveGeom

end TauCeti.AlgebraicGeometry
