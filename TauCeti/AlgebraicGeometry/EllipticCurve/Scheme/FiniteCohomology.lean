/-!
# Finiteness of the first cohomology of a projective Weierstrass model

Let `W` be a Weierstrass curve over a commutative ring `R`. Its projective model is covered by the
two affine charts `D₊(Y)` and `D₊(Z)`, whose overlap is the affine open `D₊(YZ)`
(`WeierstrassCurve.opensRange_chartι_one_sup_opensRange_chartι_two`). For a quasi-coherent sheaf
`M` of finite type, `H¹(projModel W, M)` is therefore the cokernel of the difference of
restrictions `Γ(M, D₊(Y)) × Γ(M, D₊(Z)) → Γ(M, D₊(YZ))`. This file shows that this cokernel is a
finitely generated `R`-module, with no hypothesis on `R`, on `W` or on `M` beyond finite type.

The proof follows the one for the projective line
(`TauCeti.AlgebraicGeometry.projectiveLine.finite_cohomology_one`). On the overlap, the affine
coordinates `F = Z / Y` of `D₊(Y)` and `G = Y / Z` of `D₊(Z)` are inverse to each other. The
Weierstrass equation makes `x = X / Z` integral of degree three over `R[G]`, so every function on
the overlap is `Fᵏ (c₀ + x c₁ + x² c₂)` with `cᵢ` in the algebra `Γ[F, G]` generated by `F` and
`G` over the global functions (`WeierstrassCurve.Projective.exists_eq_overlap`). Hence the
sections over the overlap are generated over `Γ[F, G]` by the restrictions of `xⁱ s`, for `i < 3`
and `s` running over finitely many generators of `Γ(M, D₊(Z))`, and
`TauCeti.Algebra.finite_quotient_sup_of_mul_eq_one` applies.

## Main results

* `WeierstrassCurve.awayToSection_algebraMap`: on a standard chart `D₊(f)`, the constant fraction
  `r / 1` is the constant function `r`.
* `WeierstrassCurve.map_awayCoord_mul_map_awayCoord`: on the overlap, `(Z / Y) (Y / Z) = 1`.
* `WeierstrassCurve.finite_sectionsQuotient`: the Čech description of `H¹` on the cover by `D₊(Y)`
  and `D₊(Z)` is finite over the global functions.
* `WeierstrassCurve.bijective_baseRingToGlobalSections` and
  `WeierstrassCurve.surjective_baseRingToStructurePresheaf_app_top`: the global functions on the
  projective model are the constants.
* `WeierstrassCurve.finite_cohomology_one`: `H¹(projModel W, M)` is a finitely generated
  `R`-module for every quasi-coherent sheaf `M` of finite type.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem III.5.2.
* The Stacks Project, Tag 02O6, finiteness of cohomology of coherent sheaves on proper schemes.
-/

public section

open CategoryTheory Opposite AlgebraicGeometry HomogeneousLocalization
open AlgebraicGeometry.Scheme.Modules TauCeti.AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme.Modules

universe u

namespace WeierstrassCurve

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

/-- **Constants on a standard chart.** On the chart `D₊(f)` of the projective model, for `f`
homogeneous of positive degree, the fraction `r / 1` is the restriction of the constant function
`r`, through the action of the base ring `Scheme.baseRingToStructurePresheaf`. -/
theorem awayToSection_algebraMap {f : W.toProjective.CoordinateRing} {m : ℕ}
    (hf : f ∈ W.toProjective.grading m) (hm : 0 < m) (r : R) :
    Proj.awayToSection W.toProjective.grading f (algebraMap R _ r) =
      (W.projModel.baseRingToStructurePresheaf R).app (op (Proj.basicOpen _ f)) r := by
  -- the constant `r` is pulled back from `Spec A₀` along `Proj.toSpecZero`
  have h := ConcreteCategory.congr_hom (Proj.toSpecZero_appLE_basicOpen _ hf hm)
    ((Scheme.ΓSpecIso _).inv (W.toProjective.gradingZeroEquiv r))
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply, Iso.inv_hom_id_apply] at h
  have hr : (Spec.map W.toProjective.gradingZeroEquiv.toRingEquiv.toCommRingCatIso.hom).appTop
      ((Scheme.ΓSpecIso (.of R)).inv r) =
        (Scheme.ΓSpecIso _).inv (W.toProjective.gradingZeroEquiv r) :=
    (ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality
      W.toProjective.gradingZeroEquiv.toRingEquiv.toCommRingCatIso.hom) r).symm
  rw [Scheme.baseRingToStructurePresheaf_app_eq_appLE, over_projModel, projModelOver_def,
    CommRingCat.comp_apply]
  refine Eq.trans ?_ ((congrArg _ hr).trans h).symm
  rw [Projective.gradingZeroEquiv_apply]
  rfl

/-- On the overlap `D₊(YZ)`, the affine coordinates `Z / Y` of `D₊(Y)` and `Y / Z` of `D₊(Z)`
are inverse to each other. -/
theorem map_awayCoord_mul_map_awayCoord
    (h₀ : Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1 * W.toProjective.coord 2) ≤
      Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1))
    (h₁ : Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1 * W.toProjective.coord 2) ≤
      Proj.basicOpen W.toProjective.grading (W.toProjective.coord 2)) :
    W.projModel.presheaf.map (homOfLE h₀).op
        (Proj.awayToSection _ _ (W.toProjective.awayCoord 1 2)) *
      W.projModel.presheaf.map (homOfLE h₁).op
        (Proj.awayToSection _ _ (W.toProjective.awayCoord 2 1)) = 1 := by
  let σ :=
    Proj.awayToSection W.toProjective.grading (W.toProjective.coord 1 * W.toProjective.coord 2)
  have hY : W.projModel.presheaf.map (homOfLE h₀).op
      (Proj.awayToSection _ _ (W.toProjective.awayCoord 1 2)) =
        σ (W.toProjective.awayMapOverlapY (W.toProjective.awayCoord 1 2)) :=
    congr($(Proj.awayMap_awayToSection W.toProjective.grading
      (W.toProjective.coord_mem_grading 2) rfl) _).symm
  have hZ : W.projModel.presheaf.map (homOfLE h₁).op
      (Proj.awayToSection _ _ (W.toProjective.awayCoord 2 1)) =
        σ (W.toProjective.awayMapOverlapZ (W.toProjective.awayCoord 2 1)) :=
    congr($(Proj.awayMap_awayToSection W.toProjective.grading
      (W.toProjective.coord_mem_grading 1) (mul_comm _ _)) _).symm
  rw [hY, hZ]
  exact (map_mul σ.hom _ _).symm.trans
    ((congrArg σ.hom W.toProjective.awayMapOverlapY_mul_awayMapOverlapZ).trans (map_one _))

attribute [local instance] sectionsGlobalAlgebra isScalarTower_sectionsGlobalAlgebra

/-- The Čech description of `H¹` on the cover by `D₊(Y)` and `D₊(Z)`, the overlap sections modulo
the restrictions from the two charts, is a finitely generated module over the global functions,
for `M` quasi-coherent of finite type. -/
theorem finite_sectionsQuotient (M : W.projModel.Modules) [M.IsQuasicoherent] [M.IsFiniteType] :
    Module.Finite Γ(W.projModel, ⊤)
      (Γ(M, Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1) ⊓
          Proj.basicOpen W.toProjective.grading (W.toProjective.coord 2)) ⧸ LinearMap.range
        (mayerVietorisSectionsDifferenceLinear M
          (Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1))
          (Proj.basicOpen W.toProjective.grading (W.toProjective.coord 2)))) := by
  rw [range_mayerVietorisSectionsDifferenceLinear]
  -- the overlap is `D₊(YZ)`, whose functions are fractions of the homogeneous coordinate ring
  suffices h : ∀ (O : W.projModel.Opens)
      (_ : Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1 * W.toProjective.coord 2)
        = O) (h₀ : O ≤ Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1))
      (h₁ : O ≤ Proj.basicOpen W.toProjective.grading (W.toProjective.coord 2)),
      Module.Finite Γ(W.projModel, ⊤) (Γ(M, O) ⧸
        (LinearMap.range (sectionsRestrictionLinear M (homOfLE h₀)) ⊔
          LinearMap.range (sectionsRestrictionLinear M (homOfLE h₁)))) from
    h _ (Proj.basicOpen_mul _ _ _) inf_le_left inf_le_right
  rintro _ rfl h₀ h₁
  set W' := W.toProjective
  have hU : IsAffineOpen (Proj.basicOpen W'.grading (W'.coord 1)) :=
    Proj.isAffineOpen_basicOpen _ _ (W'.coord_mem_grading 1) one_pos
  have hV : IsAffineOpen (Proj.basicOpen W'.grading (W'.coord 2)) :=
    Proj.isAffineOpen_basicOpen _ _ (W'.coord_mem_grading 2) one_pos
  let σ := Proj.awayToSection W'.grading (W'.coord 1 * W'.coord 2)
  have hσ : Function.Surjective σ :=
    (Proj.basicOpenIsoAway W'.grading _ (SetLike.mul_mem_graded (W'.coord_mem_grading 1)
      (W'.coord_mem_grading 2)) two_pos).commRingCatIsoToRingEquiv.surjective
  -- the affine coordinates `Z / Y` on `D₊(Y)` and `Y / Z`, `X / Z` on `D₊(Z)`
  let fU := Proj.awayToSection W'.grading (W'.coord 1) (W'.awayCoord 1 2)
  let gV := Proj.awayToSection W'.grading (W'.coord 2) (W'.awayCoord 2 1)
  let xV := Proj.awayToSection W'.grading (W'.coord 2) (W'.awayCoord 2 0)
  let F := W.projModel.presheaf.map (homOfLE h₀).op fU
  let G := W.projModel.presheaf.map (homOfLE h₁).op gV
  let x := W.projModel.presheaf.map (homOfLE h₁).op xV
  have hY (a) : W.projModel.presheaf.map (homOfLE h₀).op (Proj.awayToSection _ _ a) =
      σ (W'.awayMapOverlapY a) :=
    congr($(Proj.awayMap_awayToSection W'.grading (W'.coord_mem_grading 2) rfl) a).symm
  have hZ (a) : W.projModel.presheaf.map (homOfLE h₁).op (Proj.awayToSection _ _ a) =
      σ (W'.awayMapOverlapZ a) :=
    congr($(Proj.awayMap_awayToSection W'.grading (W'.coord_mem_grading 1)
      (mul_comm (W'.coord 1) (W'.coord 2))) a).symm
  have hF : F = σ (W'.awayMapOverlapY (W'.awayCoord 1 2)) := hY _
  have hG : G = σ (W'.awayMapOverlapZ (W'.awayCoord 2 1)) := hZ _
  have hx : x = σ (W'.awayMapOverlapZ (W'.awayCoord 2 0)) := hZ _
  have hFG : F * G = 1 := W.map_awayCoord_mul_map_awayCoord h₀ h₁
  -- the functions on the overlap are `Fᵏ (c₀ + x c₁ + x² c₂)` with `cᵢ ∈ Γ[F, G]`
  let B' := Algebra.adjoin Γ(W.projModel, ⊤) {F, G}
  have hconst (r : R) : σ (algebraMap R _ r) ∈ B' := by
    rw [W.awayToSection_algebraMap (SetLike.mul_mem_graded (W'.coord_mem_grading 1)
      (W'.coord_mem_grading 2)) two_pos, Scheme.baseRingToStructurePresheaf_app]
    exact Subalgebra.algebraMap_mem B' _
  have haeval (P : Polynomial R) :
      σ (Polynomial.aeval (W'.awayMapOverlapZ (W'.awayCoord 2 1)) P) ∈ B' := by
    induction P using Polynomial.induction_on with
    | C a => rw [Polynomial.aeval_C]; exact hconst a
    | add p q hp hq => rw [map_add, map_add]; exact B'.add_mem hp hq
    | monomial n a ih =>
      rw [pow_succ, ← mul_assoc, map_mul, Polynomial.aeval_X, map_mul, ← hG]
      exact B'.mul_mem ih (Algebra.subset_adjoin (by simp))
  have hb (b : Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2))) :
      ∃ (k : ℕ) (c₀ c₁ c₂ : Γ(W.projModel, _)), c₀ ∈ B' ∧ c₁ ∈ B' ∧ c₂ ∈ B' ∧
        b = F ^ k * (c₀ + x * c₁ + x ^ 2 * c₂) := by
    obtain ⟨b, rfl⟩ := hσ b
    obtain ⟨k, P₀, P₁, P₂, rfl⟩ := W'.exists_eq_overlap b
    refine ⟨k, _, _, _, haeval P₀, haeval P₁, haeval P₂, ?_⟩
    simp only [map_mul, map_add, map_pow, hF, hx]
  -- generators of the sections over `D₊(Z)` restrict to generators over the overlap, which is the
  -- basic open of `Y / Z` in `D₊(Z)`
  have := Scheme.Modules.finite_sections_of_isAffineOpen M _ hV
  obtain ⟨S₁, hS₁⟩ := Module.Finite.fg_top
    (R := Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 2)))
    (M := Γ(M, Proj.basicOpen W'.grading (W'.coord 2)))
  have hbasicU : W.projModel.basicOpen fU = Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2) :=
    Proj.basicOpen_awayToSection_mk _ _ _ _
  have hbasicV :
      W.projModel.basicOpen gV = Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2) := by
    rw [Proj.basicOpen_awayToSection_mk, mul_comm]
  have hspan₁ : Submodule.span Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2))
      (M.presheaf.map (homOfLE h₁).op '' S₁) = ⊤ := by
    suffices h : ∀ (V' : W.projModel.Opens) (_ : W.projModel.basicOpen gV = V')
        (hV' : V' ≤ Proj.basicOpen W'.grading (W'.coord 2)),
        Submodule.span Γ(W.projModel, V') (M.presheaf.map (homOfLE hV').op '' S₁) = ⊤ from
      h _ hbasicV h₁
    rintro _ rfl _
    have := hV.isLocalization_basicOpen gV
    have := M.isLocalizedModule_basicOpenRestrict hV gV
    have h := span_eq_top_of_isLocalizedModule Γ(W.projModel, W.projModel.basicOpen gV)
      (.powers gV) (M.basicOpenRestrict gV) hS₁
    rwa [show ⇑(M.basicOpenRestrict gV) = _ from funext (M.basicOpenRestrict_apply gV)] at h
  have hxs (i : ℕ) (s : Γ(M, Proj.basicOpen W'.grading (W'.coord 2))) :
      x ^ i • M.presheaf.map (homOfLE h₁).op s = M.presheaf.map (homOfLE h₁).op (xV ^ i • s) := by
    rw [M.map_smul, map_pow]
  let S : Set Γ(M, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2)) :=
    (fun p : ℕ × Γ(M, Proj.basicOpen W'.grading (W'.coord 2)) ↦
      M.presheaf.map (homOfLE h₁).op (xV ^ p.1 • p.2)) '' (Set.Iio 3 ×ˢ ↑S₁)
  have hF' : F ∈ B' := Algebra.subset_adjoin (by simp)
  have hG' : G ∈ B' := Algebra.subset_adjoin (by simp)
  refine TauCeti.Algebra.finite_quotient_sup_of_mul_eq_one (B := B') (F := ⟨F, hF'⟩)
    (G := ⟨G, hG'⟩) (S := S) (Subtype.ext hFG) ?_
    (((Set.finite_Iio 3).prod S₁.finite_toSet).image _) ?_ ?_ ?_ ?_ ?_
  · -- `Γ[F, G]` is generated by `F` and `G`
    have h := Algebra.adjoin_adjoin_coe_preimage (R := Γ(W.projModel, ⊤))
      (s := ({F, G} : Set Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2))))
    convert h using 2
    ext ⟨z, hz⟩
    simp [Subtype.ext_iff]
  · -- every section over the overlap is a `Γ[F, G]`-combination of the `xⁱ s` with `s ∈ S₁`
    have key₀ : ∀ s ∈ S₁,
        ∀ b : Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2)),
          b • M.presheaf.map (homOfLE h₁).op s ∈ Submodule.span B' S := by
      intro s hs b
      obtain ⟨k, c₀, c₁, c₂, hc₀, hc₁, hc₂, rfl⟩ := hb b
      have hmem (i : ℕ) (hi : i < 3) (c) (hc : c ∈ B') :
          (F ^ k * c * x ^ i) • M.presheaf.map (homOfLE h₁).op s ∈ Submodule.span B' S := by
        rw [mul_smul, hxs]
        exact Submodule.smul_mem _ (⟨F ^ k * c, B'.mul_mem (B'.pow_mem hF' k) hc⟩ : B')
          (Submodule.subset_span ⟨(i, s), ⟨hi, hs⟩, rfl⟩)
      have : F ^ k * (c₀ + x * c₁ + x ^ 2 * c₂) =
          F ^ k * c₀ * x ^ 0 + F ^ k * c₁ * x ^ 1 + F ^ k * c₂ * x ^ 2 := by ring
      rw [this, add_smul, add_smul]
      exact add_mem (add_mem (hmem 0 (by norm_num) c₀ hc₀) (hmem 1 (by norm_num) c₁ hc₁))
        (hmem 2 (by norm_num) c₂ hc₂)
    have key : ∀ y ∈ Submodule.span Γ(W.projModel, Proj.basicOpen W'.grading
        (W'.coord 1 * W'.coord 2)) (M.presheaf.map (homOfLE h₁).op '' S₁),
        ∀ b : Γ(W.projModel, Proj.basicOpen W'.grading (W'.coord 1 * W'.coord 2)),
          b • y ∈ Submodule.span B' S := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem _ hm => obtain ⟨s, hs, rfl⟩ := hm; exact key₀ s hs
      | zero => intro b; rw [smul_zero]; exact zero_mem _
      | add y z _ _ hy hz => intro b; rw [smul_add]; exact add_mem (hy b) (hz b)
      | smul c y _ hy => intro b; rw [smul_smul]; exact hy _
    refine eq_top_iff.mpr fun n _ ↦ ?_
    simpa using key n (hspan₁ ▸ Submodule.mem_top) 1
  · rintro _ ⟨y, rfl⟩
    exact ⟨fU • y, by
      rw [sectionsRestrictionLinear_apply, sectionsRestrictionLinear_apply, M.map_smul]; rfl⟩
  · intro n _
    obtain ⟨k, y, hy⟩ := M.exists_pow_smul_eq_map hU fU hbasicU h₀ n
    exact ⟨k, y, by rw [sectionsRestrictionLinear_apply]; exact hy.symm⟩
  · rintro _ ⟨y, rfl⟩
    exact ⟨gV • y, by
      rw [sectionsRestrictionLinear_apply, sectionsRestrictionLinear_apply, M.map_smul]; rfl⟩
  · rintro _ ⟨⟨i, s⟩, _, rfl⟩
    exact ⟨xV ^ i • s, sectionsRestrictionLinear_apply _ _ _⟩

/-- **The global functions on the projective model are the constants**: the map from `R` to the
global functions on the projective model is bijective. -/
theorem bijective_baseRingToGlobalSections :
    Function.Bijective (baseRingToGlobalSections R W.projModel) := by
  have : IsIso ((Scheme.ΓSpecIso (.of R)).inv ≫ (W.projModel ↘ Spec (.of R)).appTop) := by
    rw [over_projModel]
    infer_instance
  convert ConcreteCategory.bijective_of_isIso
    ((Scheme.ΓSpecIso (.of R)).inv ≫ (W.projModel ↘ Spec (.of R)).appTop) using 1
  ext r
  rw [baseRingToGlobalSections_apply, CommRingCat.comp_apply]

/-- **The global functions on the projective model are the constants**: the base ring maps onto
them (`WeierstrassCurve.bijective_baseRingToGlobalSections`). -/
theorem surjective_baseRingToStructurePresheaf_app_top :
    Function.Surjective ((W.projModel.baseRingToStructurePresheaf R).app (op ⊤)) := by
  intro z
  obtain ⟨r, hr⟩ := W.bijective_baseRingToGlobalSections.2 z
  exact ⟨r, by rw [Scheme.baseRingToStructurePresheaf_app_top, CommRingCat.ofHom_apply, hr]⟩

/-- Cohomology of a sheaf on the projective model that is finitely generated over the global
functions is finitely generated over the base ring, which maps onto them. -/
theorem finite_cohomology_of_finite (M : W.projModel.Modules) (n : ℕ)
    [Module.Finite Γ(W.projModel, ⊤) (Cohomology M n)] : Module.Finite R (Cohomology M n) := by
  let : Algebra R Γ(W.projModel, ⊤) :=
    ((W.projModel.baseRingToStructurePresheaf R).app (op ⊤)).hom.toAlgebra
  have := isScalarTower_cohomology R W.projModel M n
  have : Module.Finite R Γ(W.projModel, ⊤) :=
    Module.Finite.of_surjective (Algebra.linearMap R _)
      W.surjective_baseRingToStructurePresheaf_app_top
  exact Module.Finite.trans Γ(W.projModel, ⊤) (Cohomology M n)

/-- **The first cohomology of a quasi-coherent sheaf of finite type on the projective Weierstrass
model is a finitely generated module** over the base ring, for every Weierstrass curve over every
commutative ring. It is the Čech cohomology of the cover by the affine charts `D₊(Y)` and `D₊(Z)`
(`WeierstrassCurve.finite_sectionsQuotient`). -/
theorem finite_cohomology_one (M : W.projModel.Modules) [M.IsQuasicoherent] [M.IsFiniteType] :
    Module.Finite R (Cohomology M 1) := by
  have hacyclic (i : Fin 3) : Subsingleton (cohomologyOn M 1
      (Proj.basicOpen W.toProjective.grading (W.toProjective.coord i))) :=
    subsingleton_cohomologyOn_succ_of_isAffineOpen M
      (Proj.isAffineOpen_basicOpen _ _ (W.toProjective.coord_mem_grading i) one_pos) 0
  have hUV : Proj.basicOpen W.toProjective.grading (W.toProjective.coord 1) ⊔
      Proj.basicOpen W.toProjective.grading (W.toProjective.coord 2) = ⊤ := by
    simpa using W.opensRange_chartι_one_sup_opensRange_chartι_two
  have := W.finite_sectionsQuotient M
  have : Module.Finite Γ(W.projModel, ⊤) (Cohomology M 1) := Module.Finite.equiv
    (sectionsQuotientLinearEquivCohomologyOne M _ _ hUV (hacyclic 1) (hacyclic 2))
  exact W.finite_cohomology_of_finite M 1

end WeierstrassCurve
