module

public import TauCeti.AlgebraicGeometry.Modules.AffineGlobalSections
public import TauCeti.AlgebraicGeometry.Modules.GradedAlgebra.Sections
public import TauCeti.AlgebraicGeometry.Modules.Quasicoherent.GradedAlgebra.SymmetricAlgebra.Basic
public import TauCeti.AlgebraicGeometry.Modules.TensorProduct.Sections

/-!
# The sections of the graded symmetric algebra are generated in degree one

For a quasicoherent sheaf `F` on a scheme `X` and an affine open `U`, the graded ring of sections
`⨁ n, Γ(Symⁿ F, U)` of the graded symmetric algebra `Sym F` is generated by its homogeneous
elements of degrees `0` and `1`. Indeed, the multiplication `Symⁿ F ⊗ Sym¹ F ⟶ Symⁿ⁺¹ F` is an
epimorphism of quasicoherent sheaves (`TauCeti.AlgebraicGeometry.epi_mul_gradedSymmetricAlgebra`),
hence surjective on sections over `U`, and the sections of a tensor product of quasicoherent
sheaves over `U` are the tensor product of the sections
(`AlgebraicGeometry.Scheme.Modules.bijective_μ_sectionsFunctor`). So every section of `Symⁿ⁺¹ F`
over `U` is a sum of products of sections of `Symⁿ F` and of `Sym¹ F`.

This is the hypothesis, in the form used for the relative `Proj`, under which the twisting
sheaves of `Proj_X(Sym F)` are invertible.

## Main results

* `TauCeti.AlgebraicGeometry.adjoin_zero_union_one_gradedSymmetricAlgebra_eq_top`: over an
  affine open `U`, the sections of `Sym⁰ F` and `Sym¹ F` generate `⨁ n, Γ(Symⁿ F, U)` as a
  `Γ(X, U)`-algebra.
-/

public section

open CategoryTheory MonoidalCategory DirectSum

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry GradedQuasicoherentAlgebra

universe u

variable {X : Scheme.{u}} {U : X.Opens}

namespace GradedQuasicoherentAlgebra

variable (A : GradedQuasicoherentAlgebra X) [∀ n, Epi (A.obj.toMon.mul n 1)]

/-- If the multiplications `Aₙ ⊗ A₁ ⟶ Aₙ₊₁` of a graded quasicoherent algebra are epimorphisms,
then over an affine open every section of `Aₙ₊₁` is a polynomial in the sections of `A₁`: the
multiplications are surjective on sections. -/
theorem of_succ_mem_adjoin_of_epi_mul (hU : IsAffineOpen U) (n : ℕ) (x : Γ(A.obj.X (n + 1), U)) :
    DirectSum.of (fun n ↦ Γ(A.obj.X n, U)) (n + 1) x ∈
      Algebra.adjoin Γ(X, U) (A.obj.gradedSectionsGrading U 1 : Set (⨁ n, Γ(A.obj.X n, U))) := by
  induction n with
  | zero => exact Algebra.subset_adjoin (A.obj.of_mem_gradedSectionsGrading 1 x)
  | succ n ih =>
    -- The source of the multiplication is a tensor product in the category of graded objects,
    -- which is that of `X.Modules` only after unfolding, so its instances are supplied by hand.
    obtain ⟨y, rfl⟩ := @Scheme.Modules.Hom.app_surjective_of_epi_of_isAffineOpen _ _ _
      (A.obj.toMon.mul (n + 1) 1) inferInstance
      (Scheme.Modules.isQuasicoherent_tensorObj X (A.obj.X (n + 1)) (A.obj.X 1))
      (inferInstanceAs (A.obj.X (n + 1 + 1)).IsQuasicoherent) U hU x
    obtain ⟨t, rfl⟩ := (Scheme.Modules.bijective_μ_sectionsFunctor (A.obj.X (n + 1)) (A.obj.X 1)
      hU).2 y
    induction t using TensorProduct.inductionOn with
    | tmul a b =>
      have h := mul_mem (ih a) (Algebra.subset_adjoin (A.obj.of_mem_gradedSectionsGrading 1 b))
      rw [DirectSum.of_mul_of (A := fun n ↦ Γ(A.obj.X n, U)) (i := n + 1) (j := 1) a b] at h
      exact (CommMon.sections_gMul_def (A := A.obj) (U := U) (i := n + 1) (j := 1) a b) ▸ h
    | add s t hs ht =>
      -- The tensor map and the multiplication are applied through `ConcreteCategory.hom` at the
      -- carriers of the sections functor, which `map_add` matches only up to unfolding.
      erw [map_add, map_add, map_add]
      exact add_mem hs ht

/-- If the multiplications `Aₙ ⊗ A₁ ⟶ Aₙ₊₁` of a graded quasicoherent algebra are epimorphisms,
then over an affine open `U` the sections of `A₀` and `A₁` generate the graded ring of sections
`⨁ n, Γ(Aₙ, U)` as a `Γ(X, U)`-algebra. -/
theorem adjoin_zero_union_one_eq_top_of_epi_mul (hU : IsAffineOpen U) :
    Algebra.adjoin Γ(X, U) ((A.obj.gradedSectionsGrading U 0 : Set (⨁ n, Γ(A.obj.X n, U))) ∪
      A.obj.gradedSectionsGrading U 1) = ⊤ := by
  refine Algebra.eq_top_iff.mpr fun x ↦ ?_
  induction x using DirectSum.induction_on with
  | zero => exact zero_mem _
  | of i x =>
    cases i with
    | zero => exact Algebra.subset_adjoin (Or.inl (A.obj.of_mem_gradedSectionsGrading 0 x))
    | succ n =>
      exact Algebra.adjoin_mono Set.subset_union_right (A.of_succ_mem_adjoin_of_epi_mul hU n x)
  | add x y hx hy => exact add_mem hx hy

end GradedQuasicoherentAlgebra

/-- **The sections of the graded symmetric algebra are generated in degree one.** Over an affine
open `U`, the sections of `Sym⁰ F` and `Sym¹ F` generate the graded ring of sections
`⨁ n, Γ(Symⁿ F, U)` of `Sym F` as a `Γ(X, U)`-algebra. -/
theorem adjoin_zero_union_one_gradedSymmetricAlgebra_eq_top (F : QuasicoherentSheaf X)
    (hU : IsAffineOpen U) :
    Algebra.adjoin Γ(X, U)
      ((((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U 0 :
          Set (⨁ n, Γ(((gradedSymmetricAlgebra X).obj F).obj.X n, U))) ∪
        ((gradedSymmetricAlgebra X).obj F).obj.gradedSectionsGrading U 1) = ⊤ :=
  ((gradedSymmetricAlgebra X).obj F).adjoin_zero_union_one_eq_top_of_epi_mul hU

end TauCeti.AlgebraicGeometry
