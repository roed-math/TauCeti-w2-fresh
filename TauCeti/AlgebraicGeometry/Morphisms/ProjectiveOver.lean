/-!
# Projective schemes over a ring are projective morphisms

A scheme `X` over `Spec R` is projective over `R` in the sense of
`AlgebraicGeometry.Scheme.IsProjectiveOver` if it is a closed subscheme over `R` of
`Proj (Sym_R M)` for a finite `R`-module `M`. This file shows that this holds exactly when
`X ⟶ Spec R` is a projective morphism (`TauCeti.AlgebraicGeometry.IsProjective`).

The identification `M ≅ Γ(M~, Spec R)`, semilinear over `R ≅ Γ(Spec R, Spec R)`, induces an
isomorphism `Proj (Sym Γ(M~, Spec R)) ≅ Proj (Sym_R M)` over `Spec R`
(`TauCeti.AlgebraicGeometry.projSymmetricAlgebraTildeIso`). The left side is the projective bundle
`ℙ(M~)` (`TauCeti.AlgebraicGeometry.relativeProjGradedSymmetricAlgebraIso`), which is projective
over `Spec R` because `M~` is of finite type.

Conversely, a projective morphism `X ⟶ Spec R` is a closed immersion into the relative `Proj` of a
graded algebra `A` generated in degree one, which over the affine base is
`Proj (⨁ n, Γ(Aₙ, ⊤))`. The degree-one part `Γ(A₁, ⊤)` is a finite module, and the graded map
from its symmetric algebra is surjective in positive degrees, so `Proj (⨁ n, Γ(Aₙ, ⊤))` is a closed
subscheme of `Proj (Sym_R Γ(A₁, ⊤))`.

Through this description, projectivity over an affine base is stable under affine base change:
`Proj (Sym_R M) ×_R Spec S` is `Proj (Sym_S (S ⊗[R] M))`.

Over an affine open `U` of any base `S`, the relative `Proj` of `A` is `Proj (⨁ n, Γ(Aₙ, U))`,
which is projective over `Γ(S, U)`. So a projective morphism stays projective after base change
along `Spec Γ(S, U) ≅ U ⊆ S`, and hence along every morphism `Spec R ⟶ Spec Γ(S, U) ≅ U ⊆ S`.

## Main results

* `TauCeti.AlgebraicGeometry.projSymmetricAlgebraTildeIso`: `Proj (Sym Γ(M~, Spec R))` is
  `Proj (Sym_R M)`, over `Spec R` (`projSymmetricAlgebraTildeIso_hom_projToSpec`);
* `AlgebraicGeometry.Scheme.IsProjectiveOver.isProjective`: a scheme projective over `R` is
  projective over `Spec R`.
* `TauCeti.AlgebraicGeometry.exists_isClosedImmersion_proj_symmetricAlgebra`: the projective
  spectrum of a graded algebra generated by a finite degree-one part is a closed subscheme of
  `Proj (Sym_R M)` for a finite `R`-module `M`.
* `AlgebraicGeometry.Scheme.isProjectiveOver_iff_isProjective`: a scheme over `Spec R` is
  projective over `R` if and only if its structure morphism is projective.
* `TauCeti.AlgebraicGeometry.isProjective_toSpecCoeff`: the projective spectrum of a graded algebra
  of finite type, generated in degree one and with finite degree-zero part, is projective over its
  coefficient ring.
* `TauCeti.AlgebraicGeometry.isProjective_pullback_snd_spec_map`: the base change of a projective
  morphism `X ⟶ Spec R` along `Spec S ⟶ Spec R` is projective.
* `TauCeti.AlgebraicGeometry.isProjective_pullback_snd_fromSpec` and
  `isProjective_pullback_snd_spec_map_fromSpec`: the base change of a projective morphism
  `X ⟶ S` along `Spec Γ(S, U) ⟶ S`, for an affine open `U`, and along `Spec R ⟶ Spec Γ(S, U) ⟶ S`
  is projective. In particular, over an affine base, projectivity is stable under base change
  along every morphism from the spectrum of a ring (`isProjective_pullback_snd_of_isAffine`).
-/

public section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TauCeti.SymmetricAlgebra

namespace TauCeti.AlgebraicGeometry

universe u

noncomputable section

variable {R : CommRingCat.{u}} (M : ModuleCat.{u} R)

/-- The inverse of the identification `M ≅ Γ(M~, Spec R)` (`tildeToOpenₛₗ M ⊤`), semilinear over
`Γ(Spec R, Spec R) ≅ R`. -/
def tildeToOpenTopInvₛₗ :
    PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤) →ₛₗ[
      (Scheme.ΓSpecIso R).hom.hom] M where
  toFun n := inv (tilde.toOpen M ⊤) n
  map_add' := (inv (tilde.toOpen M ⊤)).hom.map_add
  map_smul' s n := by
    obtain ⟨m, rfl⟩ := (ConcreteCategory.bijective_of_isIso (tilde.toOpen M ⊤)).2 n
    obtain ⟨r, rfl⟩ : ∃ r, (Scheme.ΓSpecIso R).inv.hom r = s :=
      ⟨(Scheme.ΓSpecIso R).hom.hom s, by simp⟩
    -- The scalar action of `Γ(Spec R, ⊤)` through `R → Γ(Spec R, ⊤)` is the `R`-module structure
    -- of the global sections in which `tilde.toOpen` is linear.
    change inv (tilde.toOpen M ⊤) (r • tilde.toOpen M ⊤ m) = _
    rw [← (tilde.toOpen M ⊤).hom.map_smul r m]
    simp

@[simp]
theorem tildeToOpenTopInvₛₗ_apply
    (n : PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤)) :
    tildeToOpenTopInvₛₗ M n = inv (tilde.toOpen M ⊤) n :=
  (rfl)

/-- The map `Sym_R M → Sym Γ(M~, Spec R)` induced by `M ≅ Γ(M~, Spec R)`, as a graded ring
homomorphism. -/
def symmetricAlgebraTildeGradedHom :
    homogeneousSubmodule R M →+*ᵍ homogeneousSubmodule Γ(Spec R, ⊤)
      (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤)) where
  toRingHom := _root_.SymmetricAlgebra.mapₛₗ (tildeToOpenₛₗ M ⊤)
  map_mem := mapₛₗ_mem_homogeneousSubmodule _

/-- The inverse of `symmetricAlgebraTildeGradedHom`, as a graded ring homomorphism. -/
def symmetricAlgebraTildeGradedHomInv :
    homogeneousSubmodule Γ(Spec R, ⊤)
      (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤)) →+*ᵍ
      homogeneousSubmodule R M where
  toRingHom := _root_.SymmetricAlgebra.mapₛₗ (tildeToOpenTopInvₛₗ M)
  map_mem := mapₛₗ_mem_homogeneousSubmodule _

/-- The projective spectrum of the symmetric algebra of the global sections of `M~` is the
projective spectrum `Proj (Sym_R M)`. -/
def projSymmetricAlgebraTildeIso :
    Proj (homogeneousSubmodule Γ(Spec R, ⊤)
      (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤))) ≅
      Proj (homogeneousSubmodule R M) :=
  Proj.mapIso (symmetricAlgebraTildeGradedHom M) (symmetricAlgebraTildeGradedHomInv M)
    (fun x ↦ by
      have h := _root_.SymmetricAlgebra.mapₛₗ_comp_mapₛₗ (tildeToOpenTopInvₛₗ M)
        (tildeToOpenₛₗ M ⊤) LinearMap.id (fun s ↦ by simp) fun n ↦ by
          rw [tildeToOpenₛₗ_apply, tildeToOpenTopInvₛₗ_apply, LinearMap.id_apply]
          exact ConcreteCategory.congr_hom (IsIso.inv_hom_id (tilde.toOpen M ⊤)) n
      rw [_root_.SymmetricAlgebra.mapₛₗ_eq_id (fun _ ↦ rfl) (fun _ ↦ rfl)] at h
      exact RingHom.congr_fun h x)
    (fun x ↦ by
      have h := _root_.SymmetricAlgebra.mapₛₗ_comp_mapₛₗ (tildeToOpenₛₗ M ⊤)
        (tildeToOpenTopInvₛₗ M) LinearMap.id (fun s ↦ by simp) fun m ↦ by
          rw [tildeToOpenₛₗ_apply, LinearMap.id_apply]
          exact ConcreteCategory.congr_hom (IsIso.hom_inv_id (tilde.toOpen M ⊤)) m
      rw [_root_.SymmetricAlgebra.mapₛₗ_eq_id (fun _ ↦ rfl) (fun _ ↦ rfl)] at h
      exact RingHom.congr_fun h x)

/-- `projSymmetricAlgebraTildeIso` lies over `Spec Γ(Spec R, Spec R) ≅ Spec R`. -/
theorem projSymmetricAlgebraTildeIso_hom_projToSpec :
    (projSymmetricAlgebraTildeIso M).hom ≫ projToSpec R M =
      Proj.toSpecCoeff (homogeneousSubmodule Γ(Spec R, ⊤)
        (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤))) ≫
        Spec.map (Scheme.ΓSpecIso R).inv := by
  -- `Proj.mapIso` is not exposed, so its forward map is unfolded with `Proj.mapIso_hom`.
  have e : (projSymmetricAlgebraTildeIso M).hom =
      Proj.map (symmetricAlgebraTildeGradedHom M) _ :=
    Proj.mapIso_hom _ _ _ _
  rw [e, projToSpec_def, Proj.map_toSpecZero_assoc, Proj.toSpecCoeff_def, Category.assoc]
  congr 1
  simp only [← Spec.map_comp]
  congr 1
  ext r
  exact _root_.SymmetricAlgebra.mapₛₗ_algebraMap (tildeToOpenₛₗ M ⊤) r

end

/-- **A projective scheme over a ring is projective over its spectrum**: if `X` is a closed
subscheme over `R` of `Proj (Sym_R M)` for a finite `R`-module `M`
(`AlgebraicGeometry.Scheme.IsProjectiveOver`), then `X ⟶ Spec R` is projective. Through
`projSymmetricAlgebraTildeIso` and `relativeProjGradedSymmetricAlgebraIso`, `Proj (Sym_R M)` is the
projective bundle of `M~`, which is of finite type. -/
instance _root_.AlgebraicGeometry.Scheme.IsProjectiveOver.isProjective {R : Type u} [CommRing R]
    {X : Scheme.{u}} [X.Over (Spec (.of R))] [X.IsProjectiveOver R] :
    IsProjective (X ↘ Spec (.of R)) := by
  obtain ⟨M, _, _, _, g, hg, hgR⟩ :=
    Scheme.IsProjectiveOver.exists_isClosedImmersion (R := R) (X := X)
  -- `ModuleCat` needs an additive group, and a module over a ring is one.
  let := Module.addCommMonoidToAddCommGroup R (M := M)
  let F : QuasicoherentSheaf (Spec (.of R)) := ⟨tilde (ModuleCat.of R M), inferInstance⟩
  have := isProjective_toSpecCoeff_comp_fromSpec F
  have key : projToSpec R M =
      (projSymmetricAlgebraTildeIso (ModuleCat.of (CommRingCat.of R) M)).inv ≫
        Proj.toSpecCoeff (homogeneousSubmodule Γ(Spec (.of R), ⊤)
          (PresheafOfModulesOfCommRing.obj (R := (Spec (.of R)).presheaf) F.obj.val (op ⊤))) ≫
          (isAffineOpen_top _).fromSpec := by
    rw [Iso.eq_inv_comp, projSymmetricAlgebraTildeIso_hom_projToSpec,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
  rw [← comp_over g (Spec (.of R)), over_eq_projToSpec, key, ← Category.assoc]
  infer_instance

/-- **A graded algebra generated by a finite degree-one part is a closed subscheme of a projective
space**: if `A` is a graded `S`-algebra generated over `𝒜 0` by `𝒜 1`, finite over `S`, then for
a finite ring homomorphism `φ : R →+* S` the projective spectrum of `A` is a closed subscheme of
`Proj (Sym_R M)` for a finite `R`-module `M`, lying over `Spec φ`. Here `M` is `𝒜 1`, an
`R`-module through `φ`, and the closed immersion is induced by the graded map `Sym_R M → A`, which
is surjective in positive degrees (`TauCeti.GradedAlgebra.mem_closure_grade_one`). -/
theorem exists_isClosedImmersion_proj_symmetricAlgebra {R S B : Type u} [CommRing R]
    [CommRing S] [CommRing B] [Algebra S B] (𝒜 : ℕ → Submodule S B) [GradedAlgebra 𝒜]
    [Module.Finite S (𝒜 1)] (hA : Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) = ⊤) (φ : R →+* S)
    (hφ : φ.Finite) :
    ∃ (M : Type u) (_ : AddCommMonoid M) (_ : Module R M) (_ : Module.Finite R M)
      (g : Proj 𝒜 ⟶ Proj (homogeneousSubmodule R M)), IsClosedImmersion g ∧
      g ≫ projToSpec R M = Proj.toSpecCoeff 𝒜 ≫ Spec.map (CommRingCat.ofHom φ) := by
  let : Algebra R S := φ.toAlgebra
  let : Module R (𝒜 1) := Module.compHom _ φ
  have : IsScalarTower R S (𝒜 1) := ⟨fun r s m ↦ mul_smul (φ r) s m⟩
  have : Module.Finite R S := hφ
  have : Module.Finite R (𝒜 1) := .trans S _
  let e : 𝒜 1 →ₛₗ[φ] 𝒜 1 :=
    { toFun := id
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }
  let f : homogeneousSubmodule R (𝒜 1) →+*ᵍ 𝒜 :=
    (SymmetricAlgebra.gradedLift S 𝒜 LinearMap.id).comp
      ⟨_root_.SymmetricAlgebra.mapₛₗ e, mapₛₗ_mem_homogeneousSubmodule e⟩
  -- The image of `f` contains `𝒜 1`, hence every homogeneous element of positive degree.
  have hsurj (n : ℕ) (hn : 0 < n) : (𝒜 n : Set B) ⊆ Set.range f := by
    intro x hx
    have hle : Subsemiring.closure (𝒜 1 : Set B) ≤ f.toRingHom.rangeS :=
      Subsemiring.closure_le.mpr fun y hy ↦
        ⟨_root_.SymmetricAlgebra.ι R (𝒜 1) ⟨y, hy⟩, by simp [f, e]⟩
    exact hle (GradedAlgebra.mem_closure_grade_one 𝒜 hn hA hx)
  have hf := HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range f hsurj
  refine ⟨𝒜 1, inferInstance, inferInstance, inferInstance, Proj.map f hf,
    Proj.isClosedImmersion_map_of_grade_subset_range f hf hsurj, ?_⟩
  rw [projToSpec_def, Proj.map_toSpecZero_assoc, Proj.toSpecCoeff_def, Category.assoc]
  congr 1
  simp only [← Spec.map_comp]
  congr 1
  ext r
  simp [f, e]

/-- **The projective spectrum of a graded algebra generated in degree one is projective over its
coefficient ring**: if `A` is a graded `R`-algebra of finite type, generated over `𝒜 0` by `𝒜 1`,
with `𝒜 0` finite over `R`, then `Proj 𝒜 ⟶ Spec R` is projective. The degree-one part is finite
(`TauCeti.GradedAlgebra.finite_grade_one`), so `Proj 𝒜` is a closed subscheme of
`Proj (Sym_R (𝒜 1))` over `R` (`exists_isClosedImmersion_proj_symmetricAlgebra`). -/
theorem isProjective_toSpecCoeff {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    (𝒜 : ℕ → Submodule R B) [GradedAlgebra 𝒜] [Algebra.FiniteType R B] [Module.Finite R (𝒜 0)]
    (hA : Algebra.adjoin (𝒜 0) (𝒜 1 : Set B) = ⊤) : IsProjective (Proj.toSpecCoeff 𝒜) := by
  have := GradedAlgebra.finite_grade_one 𝒜
  obtain ⟨M, _, _, _, g, hg, hgR⟩ :=
    exists_isClosedImmersion_proj_symmetricAlgebra 𝒜 hA (RingHom.id R) (RingHom.Finite.id R)
  have : IsProjective (projToSpec R M) := by
    rw [← over_eq_projToSpec]
    infer_instance
  have hg' : g ≫ projToSpec R M = Proj.toSpecCoeff 𝒜 := by
    rw [hgR, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
  rw [← hg']
  infer_instance

/-- **A scheme projective over the spectrum of a ring is projective over the ring**: if
`X ⟶ Spec R` is projective, then `X` is a closed subscheme over `R` of `Proj (Sym_R M)` for a finite
`R`-module `M` (`AlgebraicGeometry.Scheme.IsProjectiveOver`).

Write `X ⟶ Spec R` as a closed immersion into the relative `Proj` of `A` followed by its structure
morphism. Over the affine scheme `Spec R` the relative `Proj` is `Proj (⨁ n, Γ(Aₙ, ⊤))`
(`CategoryTheory.CommMon.isIso_relativeProjCover_f_top`). Its degree-one part `Γ(A₁, ⊤)` is finite
because `⨁ n, Γ(Aₙ, ⊤)` is of finite type and `Γ(A₀, ⊤)` is finite
(`TauCeti.GradedAlgebra.finite_grade_one`), so `exists_isClosedImmersion_proj_symmetricAlgebra`
embeds `Proj (⨁ n, Γ(Aₙ, ⊤))` into `Proj (Sym_R Γ(A₁, ⊤))` over `R ≅ Γ(Spec R, ⊤)`. -/
theorem _root_.AlgebraicGeometry.Scheme.isProjectiveOver_of_isProjective {R : Type u}
    [CommRing R] {X : Scheme.{u}} [X.Over (Spec (.of R))] [IsProjective (X ↘ Spec (.of R))] :
    X.IsProjectiveOver R := by
  obtain ⟨A, _, hA, h, h₀, i, hi, hiX⟩ :=
    IsProjective.exists_isClosedImmersion (f := X ↘ Spec (.of R))
  have := h ⊤ (isAffineOpen_top _)
  have : Module.Finite Γ(Spec (.of R), ⊤) (A.gradedSectionsGrading ⊤ 0) := by
    have := h₀ ⊤ (isAffineOpen_top _)
    -- the degree-zero summand of `⨁ n, Γ(Aₙ, ⊤)` is the image of `Γ(A₀, ⊤)`
    rw [CommMon.gradedSectionsGrading, DirectSum.summand_def]
    infer_instance
  have := GradedAlgebra.finite_grade_one (A.gradedSectionsGrading ⊤)
  obtain ⟨M, _, _, _, g, hg, hgR⟩ := exists_isClosedImmersion_proj_symmetricAlgebra (R := R)
    (A.gradedSectionsGrading ⊤) (CommMon.isGeneratedInDegreeOne_iff.mp hA ⊤ (isAffineOpen_top _))
    (Scheme.ΓSpecIso (.of R)).inv.hom (.of_surjective _ fun s ↦
      ⟨(Scheme.ΓSpecIso (.of R)).hom.hom s, by simp⟩)
  -- Over the affine base, the chart `Proj (⨁ n, Γ(Aₙ, ⊤)) ⟶ Proj_S(A)` is an isomorphism.
  have hU := A.relativeProjCover_f_relativeProjToBase ⟨⊤, isAffineOpen_top _⟩
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at hU
  -- Instance search does not see through the chart `A.relativeProjCover.X ⟨⊤, _⟩` to the
  -- source `Proj (⨁ n, Γ(Aₙ, ⊤))` of `g`, so the composite is supplied by hand.
  have : IsClosedImmersion (inv (A.relativeProjCover.f ⟨⊤, isAffineOpen_top _⟩) ≫ g) :=
    have : IsClosedImmersion (inv (A.relativeProjCover.f ⟨⊤, isAffineOpen_top _⟩)) :=
      inferInstance
    @IsClosedImmersion.comp _ _ _ _ g this hg
  have key : (inv (A.relativeProjCover.f ⟨⊤, isAffineOpen_top _⟩) ≫ g) ≫ projToSpec R M =
      A.relativeProjToBase := by
    refine (Category.assoc _ _ _).trans ((congrArg _ hgR).trans ?_)
    rw [CommRingCat.ofHom_hom]
    exact (IsIso.inv_comp_eq _).mpr hU.symm
  refine ⟨⟨M, inferInstance, inferInstance, inferInstance,
    i ≫ inv (A.relativeProjCover.f ⟨⊤, isAffineOpen_top _⟩) ≫ g, inferInstance, ⟨?_⟩⟩⟩
  rw [over_eq_projToSpec, Category.assoc, key, hiX]

/-- **Projectivity over an affine base is stable under base change along `Spec S ⟶ Spec R`**: if
`f : X ⟶ Spec R` is projective, so is its base change `X ×_R Spec S ⟶ Spec S` for every
`R`-algebra `S`. A closed immersion `X ⟶ Proj (Sym_R M)` over `R`
(`AlgebraicGeometry.Scheme.isProjectiveOver_of_isProjective`) base changes to a closed immersion
into `Proj (Sym_R M) ×_R Spec S`, which is `Proj (Sym_S (S ⊗[R] M))`
(`AlgebraicGeometry.Proj.isPullback_symmetricAlgebra_baseChange`). -/
theorem isProjective_pullback_snd_spec_map_algebraMap {R S : Type u} [CommRing R] [CommRing S]
    [Algebra R S] {X : Scheme.{u}} (f : X ⟶ Spec (.of R)) [IsProjective f] :
    IsProjective (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
  let : X.Over (Spec (.of R)) := ⟨f⟩
  have : IsProjective (X ↘ Spec (.of R)) := ‹IsProjective f›
  have : X.IsProjectiveOver R := Scheme.isProjectiveOver_of_isProjective
  obtain ⟨M, _, _, _, g, hg, hgR⟩ :=
    Scheme.IsProjectiveOver.exists_isClosedImmersion (R := R) (X := X)
  have hgf : g ≫ projToSpec R M = f := by
    rw [← over_eq_projToSpec]
    exact comp_over g (Spec (.of R))
  have hA := Proj.isPullback_symmetricAlgebra_baseChange R S M
  -- The base change of `g` is a closed immersion into `Proj (Sym_S (S ⊗[R] M))`.
  let l := hA.lift (pullback.fst f _ ≫ g) (pullback.snd f _) (by
    rw [Category.assoc, hgf, pullback.condition])
  have hL : IsPullback (pullback.fst f _) l g ((Proj.symmetricAlgebraScalarTensorIso R S M).hom ≫
      Proj.baseChangeProjection (homogeneousSubmodule R M) S) :=
    IsPullback.of_bot (by rw [hA.lift_snd, hgf]; exact IsPullback.of_hasPullback _ _)
      (hA.lift_fst _ _ _).symm hA
  have : IsClosedImmersion l :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion) hL hg
  let : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap R S)))).Over (Spec (.of S)) :=
    ⟨pullback.snd _ _⟩
  have : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap R S)))).IsProjectiveOver S :=
    ⟨⟨TensorProduct R S M, inferInstance, inferInstance, inferInstance, l, inferInstance,
      ⟨by rw [over_eq_projToSpec]; exact hA.lift_snd _ _ _⟩⟩⟩
  exact Scheme.IsProjectiveOver.isProjective (R := S)

/-- **Projectivity over an affine base is stable under affine base change**: if
`f : X ⟶ Spec R` is projective, then so is its base change `X ×_{Spec R} Spec S ⟶ Spec S` along
`Spec φ` for every ring homomorphism `φ : R ⟶ S`. -/
theorem isProjective_pullback_snd_spec_map {R S : CommRingCat.{u}} (φ : R ⟶ S) {X : Scheme.{u}}
    (f : X ⟶ Spec R) [IsProjective f] : IsProjective (pullback.snd f (Spec.map φ)) :=
  letI := φ.hom.toAlgebra
  isProjective_pullback_snd_spec_map_algebraMap (R := R) (S := S) f

/-- **Projectivity is stable under base change to an affine open of the base**: if `f : X ⟶ S` is
projective and `U` is an affine open of `S`, then the base change
`X ×_S Spec Γ(S, U) ⟶ Spec Γ(S, U)` of `f` along `Spec Γ(S, U) ≅ U ⊆ S` is projective.

Write `f` as a closed immersion into the relative `Proj` of `A` followed by its structure
morphism. Over `U` the relative `Proj` is `Proj (⨁ n, Γ(Aₙ, U))`
(`CategoryTheory.CommMon.isPullback_relativeProjCover`), which is projective over `Γ(S, U)`
(`isProjective_toSpecCoeff`), and the base change of the closed immersion is a closed immersion
into it. -/
theorem isProjective_pullback_snd_fromSpec {X S : Scheme.{u}} (f : X ⟶ S) [IsProjective f]
    {U : S.Opens} (hU : IsAffineOpen U) : IsProjective (pullback.snd f hU.fromSpec) := by
  obtain ⟨A, _, hA, h, h₀, i, hi, rfl⟩ := IsProjective.exists_isClosedImmersion (f := f)
  have := h U hU
  have : Module.Finite Γ(S, U) (A.gradedSectionsGrading U 0) := by
    have := h₀ U hU
    -- the degree-zero summand of `⨁ n, Γ(Aₙ, U)` is the image of `Γ(A₀, U)`
    rw [CommMon.gradedSectionsGrading, DirectSum.summand_def]
    infer_instance
  have := isProjective_toSpecCoeff (A.gradedSectionsGrading U)
    (CommMon.isGeneratedInDegreeOne_iff.mp hA U hU)
  -- The chart of the relative `Proj` over `U`, with `U` replaced by `Spec Γ(S, U)`.
  have hP : IsPullback (A.relativeProjCover.f ⟨U, hU⟩)
      (Proj.toSpecCoeff (A.gradedSectionsGrading U)) A.relativeProjToBase hU.fromSpec :=
    ((A.isPullback_relativeProjCover ⟨U, hU⟩).of_iso (Iso.refl _) hU.isoSpec (Iso.refl _)
      (Iso.refl _) (by simp) ((Category.comp_id _).trans (Category.id_comp _).symm)
      (by simp [← IsAffineOpen.isoSpec_inv_ι]) (by simp)).flip
  -- The target of `l` is stated as `Proj (⨁ n, Γ(Aₙ, U))` rather than as the chart, which instance
  -- search does not unfold.
  let l : pullback (i ≫ A.relativeProjToBase) hU.fromSpec ⟶ Proj (A.gradedSectionsGrading U) :=
    hP.lift (pullback.fst _ _ ≫ i) (pullback.snd _ _) (by
      rw [Category.assoc]
      exact pullback.condition)
  have hl : l ≫ Proj.toSpecCoeff (A.gradedSectionsGrading U) = pullback.snd _ _ :=
    hP.lift_snd _ _ _
  have hL : IsPullback (pullback.fst _ _) l i (A.relativeProjCover.f ⟨U, hU⟩) :=
    IsPullback.of_bot (by rw [hl]; exact IsPullback.of_hasPullback _ _)
      (hP.lift_fst _ _ _).symm hP
  have : IsClosedImmersion l :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion) hL hi
  rw [← hl]
  infer_instance

/-- **Projectivity is stable under base change along a morphism from an affine scheme into an
affine open of the base**: if `f : X ⟶ S` is projective, `U` is an affine open of `S` and
`φ : Γ(S, U) ⟶ R` is a ring homomorphism, then the base change of `f` along
`Spec R ⟶ Spec Γ(S, U) ≅ U ⊆ S` is projective. -/
theorem isProjective_pullback_snd_spec_map_fromSpec {X S : Scheme.{u}} (f : X ⟶ S)
    [IsProjective f] {U : S.Opens} (hU : IsAffineOpen U) {R : CommRingCat.{u}} (φ : Γ(S, U) ⟶ R) :
    IsProjective (pullback.snd f (Spec.map φ ≫ hU.fromSpec)) := by
  have := isProjective_pullback_snd_fromSpec f hU
  have := isProjective_pullback_snd_spec_map φ (pullback.snd f hU.fromSpec)
  rw [← pullbackLeftPullbackSndIso_inv_snd_snd f hU.fromSpec (Spec.map φ)]
  infer_instance

/-- **Over an affine base, projectivity is stable under base change along morphisms from affine
schemes**: if `S` is affine and `f : X ⟶ S` is projective, then so is the base change of `f` along
every morphism `Spec R ⟶ S`. -/
theorem isProjective_pullback_snd_of_isAffine {X S : Scheme.{u}} [IsAffine S] (f : X ⟶ S)
    [IsProjective f] {R : CommRingCat.{u}} (g : Spec R ⟶ S) : IsProjective (pullback.snd f g) := by
  have := isProjective_pullback_snd_spec_map_fromSpec f (isAffineOpen_top S)
    (Spec.preimage (g ≫ S.isoSpec.hom))
  rwa [Spec.map_preimage, IsAffineOpen.fromSpec_top, Category.assoc, Iso.hom_inv_id,
    Category.comp_id] at this

/-- **Projectivity over a ring is projectivity over its spectrum**: a scheme `X` over `Spec R` is a
closed subscheme over `R` of `Proj (Sym_R M)` for a finite `R`-module `M` if and only if
`X ⟶ Spec R` is projective. -/
theorem _root_.AlgebraicGeometry.Scheme.isProjectiveOver_iff_isProjective {R : Type u}
    [CommRing R] {X : Scheme.{u}} [X.Over (Spec (.of R))] :
    X.IsProjectiveOver R ↔ IsProjective (X ↘ Spec (.of R)) :=
  ⟨fun _ ↦ inferInstance, fun _ ↦ Scheme.isProjectiveOver_of_isProjective⟩

end TauCeti.AlgebraicGeometry
