module

public import TauCeti.AlgebraicGeometry.LineBundle.GlobalGeneration
public import TauCeti.AlgebraicGeometry.LineBundle.Pullback

/-!
# Global generation of the trivial line bundle and of pullbacks

The trivial line bundle `𝒪_X` is globally generated by its unit section, and the pullback `f^* L`
of a globally generated line bundle `L` along any morphism of schemes `f` is globally generated.
Both are proved through Mathlib's `SheafOfModules.GeneratingSections`: the identity of the free
sheaf on one generator is an epimorphism, and generating sections are carried along the pullback
functor, which preserves colimits and the structure sheaf.

## Main results

* `TauCeti.AlgebraicGeometry.InvertibleSheaf.isGloballyGenerated_trivial`: `𝒪_X` is globally
  generated;
* `TauCeti.AlgebraicGeometry.InvertibleSheaf.IsGloballyGenerated.pullback`: pullbacks of globally
  generated line bundles are globally generated.

## References

* R. Hartshorne, *Algebraic Geometry*, Chapter II, Section 7.
-/

public section

open CategoryTheory Limits AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

variable {X Y : Scheme.{u}}

/-- The trivial line bundle is globally generated: the identity of the free sheaf on one
generator is an epimorphism. -/
theorem isGloballyGenerated_trivial (X : Scheme.{u}) : (trivial X).IsGloballyGenerated :=
  isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨{ I := PUnit
       s := SheafOfModules.freeHomEquiv _ (eqToIso (trivial_obj X).symm).hom
       epi := by
         -- The comparison isomorphism lives in the scheme-module category, so its epimorphism
         -- instance is supplied explicitly.
         have h := (SheafOfModules.freeHomEquiv (trivial X).obj).symm_apply_apply
           (eqToIso (trivial_obj X).symm).hom
         exact (congrArg (fun g ↦ Epi g) h).mpr
           (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom _)) }⟩

/-- The pullback of a globally generated line bundle along any morphism of schemes is globally
generated: generating sections are carried along the pullback functor, which preserves colimits
and the structure sheaf. -/
theorem IsGloballyGenerated.pullback {L : InvertibleSheaf Y} (hL : L.IsGloballyGenerated)
    (f : X ⟶ Y) : ((InvertibleSheaf.pullback f).obj L).IsGloballyGenerated := by
  obtain ⟨σ⟩ := isGloballyGenerated_iff_nonempty_generatingSections.mp hL
  -- The functor is rebound with its type as a functor between categories of sheaves of modules,
  -- where `SheafOfModules.GeneratingSections.map` seeks its colimit-preservation instance.
  let F : SheafOfModules Y.ringCatSheaf ⥤ SheafOfModules X.ringCatSheaf :=
    Scheme.Modules.pullback f
  have : PreservesColimitsOfSize.{u, u} F :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).leftAdjoint_preservesColimits
  exact isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨σ.map F (Scheme.Modules.pullbackObjUnitIso f).symm⟩

end TauCeti.AlgebraicGeometry.InvertibleSheaf
