module

public import TauCeti.AlgebraicGeometry.ModularCurve.NaiveGammaZero.BorelQuotient
import Mathlib.AlgebraicGeometry.Sites.Fpqc
import TauCeti.AlgebraicGeometry.IdealSheaf.FlatLocality
import TauCeti.AlgebraicGeometry.IdealSheaf.Locality

/-!
# The classifying map of a naive `[Γ₀(N)]`-structure

Let `X = (E/S)` be an object of `Ell/B`, where `N` is invertible on `B`, with naive `[Γ(N)]`
carrier `Y` and naive `[Γ₀(N)]` carrier `Y/Borel` (`ModuliProblem.gammaZeroNaiveCarrier`). A naive
`[Γ₀(N)]`-structure `C` on the base change `E_T` of `E` to a scheme `T` over `S` is étale-locally
the cyclic subgroup `⟨P⟩` generated by the first point of a naive `[Γ(N)]`-structure `(P, Q)`
(`ModuliProblem.exists_etale_gammaNaiveToGammaZeroNaive_app_eq_map`). On such an étale cover
`T' ⟶ T`, the basis is a point `T' ⟶ Y`, and its composite with `Y ⟶ Y/Borel` does not depend on
the basis chosen: two bases generating the same cyclic subgroup have the same image in `Y/Borel`
(`ModuliProblem.comp_gammaZeroNaiveCarrierπ_eq_of_gammaNaiveToGammaZeroNaive_app_eq`). It therefore
descends along the étale surjection `T' ⟶ T`, which is an effective epimorphism of schemes, to the
**classifying map** `T ⟶ Y/Borel` of `C` (`ModuliProblem.gammaZeroNaiveCarrierLift`).

The classifying map is characterised by its restrictions: for every `q : T' ⟶ T` and every naive
`[Γ(N)]`-structure `(P, Q)` on `E_{T'}` with `⟨P⟩` the pull-back of `C`, the composite of `q` with
the classifying map of `C` is the image in `Y/Borel` of the point of `Y` classifying `(P, Q)`
(`ModuliProblem.comp_gammaZeroNaiveCarrierLift`). Consequently it is natural in `T`
(`ModuliProblem.gammaZeroNaiveCarrierLift_map`), and the classifying map of `⟨P⟩` is the image of
`(P, Q)` in `Y/Borel` (`ModuliProblem.gammaZeroNaiveCarrierLift_gammaNaiveToGammaZeroNaive_app`).

Conversely, two points of `Y` with the same image in `Y/Borel` generate the same naive cyclic
subgroup (`ModuliProblem.gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq`):
since `Y ⟶ Y/Borel` is a Borel torsor, they differ by a Borel element on each member of an open
cover. As closed subschemes are determined by their base change along an étale surjection
(`Scheme.IdealSheafData.comap_injective_of_flat_of_surjective`), the classifying map is injective
(`ModuliProblem.gammaZeroNaiveCarrierLift_injective`).

## Main definitions

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveCarrierLift`: the classifying map
  `T ⟶ Y/Borel` of a naive `[Γ₀(N)]`-structure on `E_T`.

## Main results

* `TauCeti.AlgebraicGeometry.ModuliProblem.comp_gammaZeroNaiveCarrierLift`: the classifying map
  restricted along `T' ⟶ T` is the image of any basis generating the restricted structure.
* `TauCeti.AlgebraicGeometry.ModuliProblem.eq_gammaZeroNaiveCarrierLift_of_comp_eq`: a morphism
  with these restrictions on an étale cover is the classifying map.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveCarrierLift_map`: the classifying map is
  natural in `T`.
* `ModuliProblem.gammaZeroNaiveCarrierLift_gammaNaiveToGammaZeroNaive_app`: the classifying map of
  the cyclic subgroup `⟨P⟩` of a basis `(P, Q)` is the image of `(P, Q)` in `Y/Borel`.
* `ModuliProblem.gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq`: points of
  `Y` with the same image in `Y/Borel` generate the same naive cyclic subgroup.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveCarrierLift_injective`: the classifying
  map is injective.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §3.7 and §7.1 (7.1.3).
* D. Loeffler, *Modular curves*, lecture notes, Proposition 3.8.2.
-/

public section

open CategoryTheory Limits Opposite AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry.ModuliProblem

variable {B : Scheme.{u}} {N : ℕ} [NeZero N] (hN : ∀ b : B, (N : B.residueField b) ≠ 0)

variable (X : EllObj B)

/-- If `⟨P⟩` is the pull-back of `C` along `q : T₁ ⟶ T` for a basis `(P, Q)` on `E_{T₁}`, then
the cyclic subgroup generated by the restriction of `(P, Q)` along `z : Z ⟶ T₁` is the pull-back
of `C` along `z ≫ q`. -/
theorem gammaNaiveToGammaZeroNaive_app_map_eq {T T₁ Z : Over X.base}
    {α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))} {q : T₁ ⟶ T}
    {β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T₁))}
    (hβ : (gammaNaiveToGammaZeroNaive B N hN).app _ β =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map q).op α) (z : Z ⟶ T₁) :
    (gammaNaiveToGammaZeroNaive B N hN).app _
        ((gammaNaive B N).map (X.baseChangeFunctor.map z).op β) =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map (z ≫ q)).op α := by
  rw [NatTrans.naturality_apply, hβ, ← Functor.map_comp_apply, ← op_comp, ← Functor.map_comp]

/-- Two bases on étale-local pieces generating the restrictions of the same naive
`[Γ₀(N)]`-structure have the same image in the naive `[Γ₀(N)]` carrier wherever both are
defined. -/
theorem comp_gammaZeroNaiveCarrierπ_eq_of_map_eq {T T₁ T₂ Z : Over X.base}
    {α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))} {q₁ : T₁ ⟶ T} {q₂ : T₂ ⟶ T}
    {β₁ : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T₁))}
    {β₂ : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T₂))}
    (hβ₁ : (gammaNaiveToGammaZeroNaive B N hN).app _ β₁ =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map q₁).op α)
    (hβ₂ : (gammaNaiveToGammaZeroNaive B N hN).app _ β₂ =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map q₂).op α)
    {z₁ : Z ⟶ T₁} {z₂ : Z ⟶ T₂} (hz : z₁ ≫ q₁ = z₂ ≫ q₂) :
    z₁ ≫ (gammaNaiveRelRepData.representableBy X).homEquiv.symm β₁ ≫
        gammaZeroNaiveCarrierπ hN X =
      z₂ ≫ (gammaNaiveRelRepData.representableBy X).homEquiv.symm β₂ ≫
        gammaZeroNaiveCarrierπ hN X := by
  rw [← Category.assoc, ← Category.assoc]
  refine comp_gammaZeroNaiveCarrierπ_eq_of_gammaNaiveToGammaZeroNaive_app_eq hN X ?_
  rw [RelRepData.homEquiv_comp_homEquiv_symm, RelRepData.homEquiv_comp_homEquiv_symm]
  simp only [Functor.op_obj, Opposite.unop_op]
  rw [gammaNaiveToGammaZeroNaive_app_map_eq hN X hβ₁,
    gammaNaiveToGammaZeroNaive_app_map_eq hN X hβ₂, hz]

/-- The classifying map of a naive `[Γ₀(N)]`-structure exists: there is a morphism `T ⟶ Y/Borel`
whose composite with every `q : T' ⟶ T` is the image in `Y/Borel` of any basis on `E_{T'}`
generating the pull-back of the structure. -/
theorem exists_gammaZeroNaiveCarrierLift {T : Over X.base}
    (α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))) :
    ∃ l : T ⟶ (gammaZeroNaiveCarrier hN X).obj, ∀ (T' : Over X.base) (q : T' ⟶ T)
      (β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T'))),
      (gammaNaiveToGammaZeroNaive B N hN).app _ β =
          (gammaZeroNaive B N).map (X.baseChangeFunctor.map q).op α →
        q ≫ l = (gammaNaiveRelRepData.representableBy X).homEquiv.symm β ≫
          gammaZeroNaiveCarrierπ hN X := by
  obtain ⟨T₀, q₀, _, _, β₀, hβ₀⟩ := exists_etale_gammaNaiveToGammaZeroNaive_app_eq_map hN X T α
  let x₀ := (gammaNaiveRelRepData.representableBy X).homEquiv.symm β₀ ≫ gammaZeroNaiveCarrierπ hN X
  -- The image of the basis on `T₀` descends along the étale surjection `q₀`.
  let l₀ : T.left ⟶ (gammaZeroNaiveCarrier hN X).obj.left :=
    EffectiveEpi.desc q₀.left x₀.left fun {Z} g₁ g₂ hg ↦ by
      let Z' : Over X.base := Over.mk (g₁ ≫ T₀.hom)
      let z₁ : Z' ⟶ T₀ := Over.homMk g₁
      let z₂ : Z' ⟶ T₀ := Over.homMk g₂ (by
        simp only [Z', Over.mk_hom, ← Over.w q₀, reassoc_of% hg])
      have := comp_gammaZeroNaiveCarrierπ_eq_of_map_eq hN X hβ₀ hβ₀ (z₁ := z₁) (z₂ := z₂)
        (Over.OverMorphism.ext (by simpa [z₁, z₂] using hg))
      simpa [x₀, z₁, z₂] using congr(($this).left)
  have hl₀ : q₀.left ≫ l₀ = x₀.left := EffectiveEpi.fac _ _ _
  let l : T ⟶ (gammaZeroNaiveCarrier hN X).obj := Over.homMk l₀ (by
    rw [← cancel_epi q₀.left, reassoc_of% hl₀, Over.w x₀, Over.w q₀])
  have hl : q₀ ≫ l = x₀ := Over.OverMorphism.ext hl₀
  refine ⟨l, fun T' q β hβ ↦ ?_⟩
  -- Compare with the basis on `T₀` over the fibre product `T' ×_T T₀`, which covers `T'`.
  let Z' : Over X.base := Over.mk (pullback.fst q.left q₀.left ≫ T'.hom)
  let z₁ : Z' ⟶ T' := Over.homMk (pullback.fst q.left q₀.left)
  let z₂ : Z' ⟶ T₀ := Over.homMk (pullback.snd q.left q₀.left) (by
    simp only [Z', Over.mk_hom, ← Over.w q₀, ← Over.w q, pullback.condition_assoc])
  have hz : z₁ ≫ q = z₂ ≫ q₀ := Over.OverMorphism.ext pullback.condition
  have : Etale z₁.left := inferInstanceAs (Etale (pullback.fst q.left q₀.left))
  have : Surjective z₁.left := inferInstanceAs (Surjective (pullback.fst q.left q₀.left))
  have key : z₁ ≫ q ≫ l = z₁ ≫ (gammaNaiveRelRepData.representableBy X).homEquiv.symm β ≫
      gammaZeroNaiveCarrierπ hN X := by
    rw [reassoc_of% hz, hl]
    exact (comp_gammaZeroNaiveCarrierπ_eq_of_map_eq hN X hβ hβ₀ hz).symm
  exact Over.OverMorphism.ext ((cancel_epi z₁.left).mp congr(($key).left))

/-- **The classifying map of a naive `[Γ₀(N)]`-structure** `C` on the base change `E_T` of
`X = (E/S)` to a scheme `T` over `S`, where `N` is invertible on `B`: the morphism `T ⟶ Y/Borel`
to the naive `[Γ₀(N)]` carrier which, on an étale cover `T' ⟶ T` where `C = ⟨P⟩` for a basis
`(P, Q)`, is the image of the point of the naive `[Γ(N)]` carrier `Y` classifying `(P, Q)`
(`comp_gammaZeroNaiveCarrierLift`). -/
noncomputable def gammaZeroNaiveCarrierLift {T : Over X.base}
    (α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))) :
    T ⟶ (gammaZeroNaiveCarrier hN X).obj :=
  (exists_gammaZeroNaiveCarrierLift hN X α).choose

/-- **The classifying map is characterised by its restrictions.** For `q : T' ⟶ T` and a basis
`(P, Q)` on `E_{T'}` with `⟨P⟩` the pull-back along `q` of a naive `[Γ₀(N)]`-structure `C` on
`E_T`, the composite of `q` with the classifying map of `C` is the image in `Y/Borel` of the point
of `Y` classifying `(P, Q)`. -/
theorem comp_gammaZeroNaiveCarrierLift {T T' : Over X.base}
    {α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))} (q : T' ⟶ T)
    {β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T'))}
    (hβ : (gammaNaiveToGammaZeroNaive B N hN).app _ β =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map q).op α) :
    q ≫ gammaZeroNaiveCarrierLift hN X α =
      (gammaNaiveRelRepData.representableBy X).homEquiv.symm β ≫ gammaZeroNaiveCarrierπ hN X :=
  (exists_gammaZeroNaiveCarrierLift hN X α).choose_spec T' q β hβ

/-- **Uniqueness of the classifying map.** A morphism `l : T ⟶ Y/Borel` whose composite with an
étale surjection `q : T' ⟶ T` is the image of a basis `(P, Q)` on `E_{T'}` with `⟨P⟩` the
pull-back of `C` is the classifying map of `C`. -/
theorem eq_gammaZeroNaiveCarrierLift_of_comp_eq {T T' : Over X.base}
    {α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))} (q : T' ⟶ T)
    [Etale q.left] [Surjective q.left] {β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T'))}
    (hβ : (gammaNaiveToGammaZeroNaive B N hN).app _ β =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map q).op α)
    {l : T ⟶ (gammaZeroNaiveCarrier hN X).obj}
    (hl : q ≫ l = (gammaNaiveRelRepData.representableBy X).homEquiv.symm β ≫
      gammaZeroNaiveCarrierπ hN X) :
    l = gammaZeroNaiveCarrierLift hN X α :=
  Over.OverMorphism.ext ((cancel_epi q.left).mp
    congr(($(hl.trans (comp_gammaZeroNaiveCarrierLift hN X q hβ).symm)).left))

/-- **The classifying map of `⟨P⟩` is the image of `(P, Q)`.** For a naive `[Γ(N)]`-structure
`(P, Q)` on `E_T`, the classifying map of the naive cyclic subgroup `⟨P⟩` is the composite of the
point `T ⟶ Y` classifying `(P, Q)` with the quotient map `Y ⟶ Y/Borel`. -/
theorem gammaZeroNaiveCarrierLift_gammaNaiveToGammaZeroNaive_app {T : Over X.base}
    (β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T))) :
    gammaZeroNaiveCarrierLift hN X ((gammaNaiveToGammaZeroNaive B N hN).app _ β) =
      (gammaNaiveRelRepData.representableBy X).homEquiv.symm β ≫ gammaZeroNaiveCarrierπ hN X := by
  rw [← comp_gammaZeroNaiveCarrierLift hN X (α := (gammaNaiveToGammaZeroNaive B N hN).app _ β)
    (𝟙 T) (by simp), Category.id_comp]

/-- **The classifying map is natural.** For a morphism `k : T₁ ⟶ T` of schemes over `S` and a
naive `[Γ₀(N)]`-structure `C` on `E_T`, the classifying map of the pull-back of `C` to `E_{T₁}` is
the composite of `k` with the classifying map of `C`. -/
theorem gammaZeroNaiveCarrierLift_map {T₁ T : Over X.base} (k : T₁ ⟶ T)
    (α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))) :
    gammaZeroNaiveCarrierLift hN X ((gammaZeroNaive B N).map (X.baseChangeFunctor.map k).op α) =
      k ≫ gammaZeroNaiveCarrierLift hN X α := by
  obtain ⟨T₀, q₀, _, _, β₀, hβ₀⟩ := exists_etale_gammaNaiveToGammaZeroNaive_app_eq_map hN X T α
  -- Restrict the basis on `T₀` to the fibre product `T₁ ×_T T₀`, which covers `T₁`.
  let Z' : Over X.base := Over.mk (pullback.fst k.left q₀.left ≫ T₁.hom)
  let z₁ : Z' ⟶ T₁ := Over.homMk (pullback.fst k.left q₀.left)
  let z₂ : Z' ⟶ T₀ := Over.homMk (pullback.snd k.left q₀.left) (by
    simp only [Z', Over.mk_hom, ← Over.w q₀, ← Over.w k, pullback.condition_assoc])
  have hz : z₁ ≫ k = z₂ ≫ q₀ := Over.OverMorphism.ext pullback.condition
  have : Etale z₁.left := inferInstanceAs (Etale (pullback.fst k.left q₀.left))
  have : Surjective z₁.left := inferInstanceAs (Surjective (pullback.fst k.left q₀.left))
  have hβ : (gammaNaiveToGammaZeroNaive B N hN).app _
      ((gammaNaive B N).map (X.baseChangeFunctor.map z₂).op β₀) =
        (gammaZeroNaive B N).map (X.baseChangeFunctor.map z₁).op
          ((gammaZeroNaive B N).map (X.baseChangeFunctor.map k).op α) := by
    rw [gammaNaiveToGammaZeroNaive_app_map_eq hN X hβ₀, ← Functor.map_comp_apply, ← op_comp,
      ← Functor.map_comp, hz]
  have key : z₁ ≫ gammaZeroNaiveCarrierLift hN X
      ((gammaZeroNaive B N).map (X.baseChangeFunctor.map k).op α) =
        z₁ ≫ k ≫ gammaZeroNaiveCarrierLift hN X α := by
    rw [comp_gammaZeroNaiveCarrierLift hN X z₁ hβ, reassoc_of% hz,
      comp_gammaZeroNaiveCarrierLift hN X q₀ hβ₀]
    exact (congrArg (· ≫ gammaZeroNaiveCarrierπ hN X)
      ((gammaNaiveRelRepData.representableBy X).comp_homEquiv_symm β₀ z₂).symm).trans
        (Category.assoc _ _ _)
  exact Over.OverMorphism.ext ((cancel_epi z₁.left).mp congr(($key).left))

/-! ### Injectivity of the classifying map -/

/-- **Points of the `[Γ(N)]` carrier with the same image in the `[Γ₀(N)]` carrier generate the same
naive cyclic subgroup.** For points `x₁` and `x₂` of the naive `[Γ(N)]` carrier `Y` with values in
`T`, classifying bases `(P₁, Q₁)` and `(P₂, Q₂)` on `E_T`, if `x₁` and `x₂` have the same image in
`Y/Borel` then `⟨P₁⟩ = ⟨P₂⟩`. Since `Y ⟶ Y/Borel` is a Borel torsor
(`isPullback_gammaZeroNaiveCarrierπ`), `T` is covered by the open subschemes `T_g` on which
`x₂ = x₁ g` for a Borel element `g`; there `⟨P₂⟩ = ⟨P₁⟩` by Borel invariance, and ideal sheaves
agreeing on an open cover are equal. -/
theorem gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq {T : Over X.base}
    {x₁ x₂ : T ⟶ (gammaNaiveRelRepData (N := N)).rep X}
    (h : x₁ ≫ gammaZeroNaiveCarrierπ hN X = x₂ ≫ gammaZeroNaiveCarrierπ hN X) :
    (gammaNaiveToGammaZeroNaive B N hN).app _
        ((gammaNaiveRelRepData.representableBy X).homEquiv x₁) =
      (gammaNaiveToGammaZeroNaive B N hN).app _
        ((gammaNaiveRelRepData.representableBy X).homEquiv x₂) := by
  let R := (gammaNaiveRelRepData (B := B) (N := N)).representableBy X
  let G := (GL2Borel (ZMod N))ᵐᵒᵖ
  let Y := (gammaNaiveRelRepData (B := B) (N := N)).rep X
  let a (g : G) := (gammaNaiveRelRepData.repAction (gammaNaiveBorelAction B N) X g).asIso.hom
  have hsq := isPullback_gammaZeroNaiveCarrierπ hN X
  -- The pair `(x₁, x₂)` is a point of `Y ×_{Y/Borel} Y = ∐_g Y`.
  let ℓ : T.left ⟶ ∐ fun _ : G ↦ Y.left := hsq.lift x₁.left x₂.left congr(($h).left)
  -- The open subscheme `T_g` of `T` where `ℓ` lands in the copy of `g`.
  let U (g : G) : Over X.base :=
    Over.mk (pullback.snd (Sigma.ι (fun _ : G ↦ Y.left) g) ℓ ≫ T.hom)
  let u (g : G) : U g ⟶ T := Over.homMk (pullback.snd _ _)
  have hℓ₁ : ℓ ≫ Sigma.desc (fun _ ↦ 𝟙 Y.left) = x₁.left := hsq.lift_fst _ _ _
  have hℓ₂ : ℓ ≫ Sigma.desc (fun g ↦ (a g).left) = x₂.left := hsq.lift_snd _ _ _
  have hu (g : G) : (u g).left = pullback.snd _ ℓ := rfl
  have hx₁ (g : G) : (u g).left ≫ x₁.left = pullback.fst _ _ := by
    rw [hu, ← hℓ₁, ← pullback.condition_assoc, Sigma.ι_comp_desc, Category.comp_id]
  have hx₂ (g : G) : (u g).left ≫ x₂.left = pullback.fst _ _ ≫ (a g).left := by
    rw [hu, ← hℓ₂, ← pullback.condition_assoc, Sigma.ι_comp_desc]
  have hux (g : G) : u g ≫ x₂ = (u g ≫ x₁) ≫ a g :=
    Over.OverMorphism.ext (by rw [Over.comp_left, Over.comp_left, Over.comp_left, hx₂, hx₁])
  -- On each `T_g` the two naive cyclic subgroups agree, by Borel invariance.
  have hU (g : G) : (gammaZeroNaive B N).map (X.baseChangeFunctor.map (u g)).op
        ((gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv x₁)) =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map (u g)).op
        ((gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv x₂)) := by
    have e (x : T ⟶ Y) : (gammaZeroNaive B N).map (X.baseChangeFunctor.map (u g)).op
        ((gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv x)) =
          (gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv (u g ≫ x)) :=
      (NatTrans.naturality_apply _ _ _).symm.trans (congrArg _ (R.homEquiv_comp (u g) x).symm)
    rw [e, e, hux]
    exact (gammaNaiveToGammaZeroNaive_app_homEquiv_comp_repAction_hom hN X g (u g ≫ x₁)).symm
  -- The base changes of `E_T` to the `T_g` form an open cover of `E_T`.
  have hopen (g : G) : IsOpenImmersion (X.baseChangeFunctor.map (u g)).total :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion)
      (X.baseChangeFunctor.map (u g)).isPullback.flip
      (inferInstanceAs (IsOpenImmersion (pullback.snd (Sigma.ι (fun _ : G ↦ Y.left) g) ℓ)))
  let 𝒱 : (X.baseChangeFunctor.obj T).curve.carrier.OpenCover :=
    Scheme.Cover.mkOfCovers G (fun g ↦ (X.baseChangeFunctor.obj (U g)).curve.carrier)
      (fun g ↦ (X.baseChangeFunctor.map (u g)).total) (fun e ↦ by
        obtain ⟨g, y, hy⟩ := (sigmaOpenCover fun _ : G ↦ Y.left).exists_eq
          (ℓ ((X.baseChangeFunctor.obj T).curve.structureMap e))
        obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hy
        have hsq' := (X.baseChangeFunctor.map (u g)).isPullback
        have he : e ∈ Set.range (pullback.fst (X.baseChangeFunctor.obj T).curve.structureMap
            (X.baseChangeFunctor.map (u g)).base) := by
          rw [Scheme.Pullback.range_fst]
          exact ⟨z, hz⟩
        obtain ⟨w, rfl⟩ := he
        exact ⟨g, hsq'.isoPullback.inv w, by
          rw [← Scheme.Hom.comp_apply, hsq'.isoPullback_inv_fst]⟩)
      hopen
  refine (gammaZeroNaiveEquiv _).injective
    (Subtype.ext (Scheme.IdealSheafData.ext_of_comap_openCover 𝒱 fun g ↦ ?_))
  exact (gammaZeroNaiveEquiv_map (X.baseChangeFunctor.map (u g)) _).symm.trans
    ((congrArg (fun a ↦ (gammaZeroNaiveEquiv _ a).1) (hU g)).trans (gammaZeroNaiveEquiv_map _ _))

/-- **The classifying map is injective.** Two naive `[Γ₀(N)]`-structures `C₁` and `C₂` on `E_T`
with the same classifying map `T ⟶ Y/Borel` are equal. On a common étale cover `T'' ⟶ T` both are
generated by bases whose points of `Y` have the same image in `Y/Borel`, so they agree on `E_{T''}`
(`gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq`); and closed subschemes of
`E_T` are determined by their base change along the étale surjection `E_{T''} ⟶ E_T`
(`Scheme.IdealSheafData.comap_injective_of_flat_of_surjective`). -/
theorem gammaZeroNaiveCarrierLift_injective (T : Over X.base) :
    Function.Injective (gammaZeroNaiveCarrierLift hN X (T := T)) := by
  intro α₁ α₂ h
  let R := (gammaNaiveRelRepData (B := B) (N := N)).representableBy X
  obtain ⟨T₁, q₁, _, _, β₁, hβ₁⟩ := exists_etale_gammaNaiveToGammaZeroNaive_app_eq_map hN X T α₁
  obtain ⟨T₂, q₂, _, _, β₂, hβ₂⟩ := exists_etale_gammaNaiveToGammaZeroNaive_app_eq_map hN X T α₂
  -- The common refinement `T'' = T₁ ×_T T₂`, étale and surjective over `T`.
  let Z' : Over X.base := Over.mk (pullback.fst q₁.left q₂.left ≫ T₁.hom)
  let z₁ : Z' ⟶ T₁ := Over.homMk (pullback.fst q₁.left q₂.left)
  let z₂ : Z' ⟶ T₂ := Over.homMk (pullback.snd q₁.left q₂.left) (by
    simp only [Z', Over.mk_hom, ← Over.w q₁, ← Over.w q₂, pullback.condition_assoc])
  have hz : z₁ ≫ q₁ = z₂ ≫ q₂ := Over.OverMorphism.ext pullback.condition
  have : Etale (z₁ ≫ q₁).left :=
    inferInstanceAs (Etale (pullback.fst q₁.left q₂.left ≫ q₁.left))
  have : Surjective (z₁ ≫ q₁).left :=
    inferInstanceAs (Surjective (pullback.fst q₁.left q₂.left ≫ q₁.left))
  -- The two bases have the same image in `Y/Borel`, so they generate the same subgroup.
  have hx : (z₁ ≫ R.homEquiv.symm β₁) ≫ gammaZeroNaiveCarrierπ hN X =
      (z₂ ≫ R.homEquiv.symm β₂) ≫ gammaZeroNaiveCarrierπ hN X := by
    rw [Category.assoc, Category.assoc, ← comp_gammaZeroNaiveCarrierLift hN X q₁ hβ₁,
      ← comp_gammaZeroNaiveCarrierLift hN X q₂ hβ₂, reassoc_of% hz, h]
  have key := gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq hN X hx
  rw [RelRepData.homEquiv_comp_homEquiv_symm, RelRepData.homEquiv_comp_homEquiv_symm] at key
  simp only [Functor.op_obj, Opposite.unop_op] at key
  rw [gammaNaiveToGammaZeroNaive_app_map_eq hN X hβ₁,
    gammaNaiveToGammaZeroNaive_app_map_eq hN X hβ₂, ← hz] at key
  -- Closed subschemes of `E_T` are determined by their base change to `E_{T''}`.
  let φ := X.baseChangeFunctor.map (z₁ ≫ q₁)
  have : Etale φ.base := inferInstanceAs (Etale (z₁ ≫ q₁).left)
  have : Surjective φ.base := inferInstanceAs (Surjective (z₁ ≫ q₁).left)
  have : Flat φ.total := MorphismProperty.of_isPullback φ.isPullback.flip inferInstance
  have : Surjective φ.total := MorphismProperty.of_isPullback φ.isPullback.flip inferInstance
  have : LocallyOfFinitePresentation φ.total :=
    MorphismProperty.of_isPullback φ.isPullback.flip inferInstance
  refine (gammaZeroNaiveEquiv _).injective (Subtype.ext
    (Scheme.IdealSheafData.comap_injective_of_flat_of_surjective φ.total ?_))
  exact (gammaZeroNaiveEquiv_map φ _).symm.trans
    ((congrArg (fun a ↦ (gammaZeroNaiveEquiv _ a).1) key).trans (gammaZeroNaiveEquiv_map φ _))

end TauCeti.AlgebraicGeometry.ModuliProblem
