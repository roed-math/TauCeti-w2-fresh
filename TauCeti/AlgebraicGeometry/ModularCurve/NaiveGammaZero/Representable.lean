module

public import TauCeti.AlgebraicGeometry.ModularCurve.NaiveGammaZero.CarrierLift
import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.BaseChange.SubgroupDescent
import TauCeti.AlgebraicGeometry.IdealSheaf.EffectiveDescent

/-!
# The naive moduli problem `[Γ₀(N)]` is relatively representable and étale

Let `X = (E/S)` be an object of `Ell/B`, where `N` is invertible on `B`, with naive `[Γ(N)]`
carrier `Y` and naive `[Γ₀(N)]` carrier `Y/Borel` (`ModuliProblem.gammaZeroNaiveCarrier`). Every
morphism `y : T ⟶ Y/Borel` of schemes over `S` is the classifying map of a naive
`[Γ₀(N)]`-structure on `E_T` (`ModuliProblem.exists_gammaZeroNaiveCarrierLift_eq`). On the finite
étale cover `T' = T ×_{Y/Borel} Y` of `T`, the point `T' ⟶ Y` classifies a basis `(P, Q)` on
`E_{T'}`, and the two pull-backs of `⟨P⟩` to `E_{T' ×_T T'}` agree, since the two points of `Y`
have the same image in `Y/Borel`
(`ModuliProblem.gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq`). As
`E_{T' ×_T T'}` is the fibre product `E_{T'} ×_{E_T} E_{T'}`, the closed subscheme `⟨P⟩` descends
along the finite étale surjection `E_{T'} ⟶ E_T`
(`Scheme.IdealSheafData.exists_comap_eq_of_isPullback`), and the descended closed subscheme is a
naive cyclic subgroup (`EllipticCurveGeom.IsNaiveCyclicSubgroup.of_comap`).

Together with the injectivity of the classifying map
(`ModuliProblem.gammaZeroNaiveCarrierLift_injective`) and its naturality, this shows that
`Y/Borel` represents the naive `[Γ₀(N)]`-structures on base changes of `E`
(`ModuliProblem.gammaZeroNaiveRelRepData`). As `Y/Borel` is finite étale over `S`, the naive
moduli problem `[Γ₀(N)]` is finite and étale over `Ell/B`
(`ModuliProblem.hasProperty_etale_gammaZeroNaiveRelRepData`).

## Main definitions

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveRelRepData`: where `N` is invertible on
  `B`, the naive moduli problem `[Γ₀(N)]` is relatively representable, by the Borel quotient of
  the naive `[Γ(N)]` carrier.

## Main results

* `TauCeti.AlgebraicGeometry.ModuliProblem.exists_gammaZeroNaiveCarrierLift_eq`: every point of
  the naive `[Γ₀(N)]` carrier classifies a naive `[Γ₀(N)]`-structure.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveCarrierLift_bijective`: the classifying
  map is a bijection.
* `ModuliProblem.hasProperty_isFinite_inf_etale_gammaZeroNaiveRelRepData`: the naive moduli
  problem `[Γ₀(N)]` is finite and étale over `Ell/B`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.hasProperty_etale_gammaZeroNaiveRelRepData`: the naive
  moduli problem `[Γ₀(N)]` is étale over `Ell/B`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §3.7 and §7.1 (7.1.3).
* D. Loeffler, *Modular curves*, lecture notes, Proposition 3.8.2.
-/

public section

open CategoryTheory Limits Opposite AlgebraicGeometry

universe u

namespace TauCeti.AlgebraicGeometry.ModuliProblem

variable {B : Scheme.{u}} {N : ℕ} [NeZero N] (hN : ∀ b : B, (N : B.residueField b) ≠ 0)

variable (X : EllObj B)

/-- **Every point of the naive `[Γ₀(N)]` carrier classifies a naive `[Γ₀(N)]`-structure.** For a
morphism `y : T ⟶ Y/Borel` of schemes over `S`, there is a naive `[Γ₀(N)]`-structure on `E_T`
whose classifying map is `y`. It is the descent, along the finite étale cover
`T ×_{Y/Borel} Y ⟶ T`, of the cyclic subgroup `⟨P⟩` generated by the basis `(P, Q)` which the
point `T ×_{Y/Borel} Y ⟶ Y` classifies. -/
theorem exists_gammaZeroNaiveCarrierLift_eq {T : Over X.base}
    (y : T ⟶ (gammaZeroNaiveCarrier hN X).obj) :
    ∃ α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T)),
      gammaZeroNaiveCarrierLift hN X α = y := by
  let R := (gammaNaiveRelRepData (B := B) (N := N)).representableBy X
  let π := gammaZeroNaiveCarrierπ hN X
  -- The finite étale cover `T' = T ×_{Y/Borel} Y` of `T`, with its point `x : T' ⟶ Y`.
  let T' : Over X.base := Over.mk (pullback.fst y.left π.left ≫ T.hom)
  let q : T' ⟶ T := Over.homMk (pullback.fst y.left π.left)
  let x : T' ⟶ (gammaNaiveRelRepData (N := N)).rep X := Over.homMk (pullback.snd y.left π.left)
    (by simp only [T', Over.mk_hom, ← Over.w π, ← Over.w y, pullback.condition_assoc])
  have hq : q ≫ y = x ≫ π := Over.OverMorphism.ext pullback.condition
  have : IsFinite q.left := inferInstanceAs (IsFinite (pullback.fst y.left π.left))
  have : Etale q.left := inferInstanceAs (Etale (pullback.fst y.left π.left))
  have : Surjective q.left := inferInstanceAs (Surjective (pullback.fst y.left π.left))
  let γ := (gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv x)
  -- The fibre product `T'' = T' ×_T T'`, with its two projections `z₁` and `z₂`.
  let T'' : Over X.base := Over.mk (pullback.fst q.left q.left ≫ T'.hom)
  let z₁ : T'' ⟶ T' := Over.homMk (pullback.fst q.left q.left)
  let z₂ : T'' ⟶ T' := Over.homMk (pullback.snd q.left q.left)
    (by simp only [T'', Over.mk_hom, ← Over.w q, pullback.condition_assoc])
  have hz : z₁ ≫ q = z₂ ≫ q := Over.OverMorphism.ext pullback.condition
  -- The two pull-backs of `γ` to `E_{T''}` agree.
  have e (z : T'' ⟶ T') : (gammaZeroNaive B N).map (X.baseChangeFunctor.map z).op γ =
      (gammaNaiveToGammaZeroNaive B N hN).app _ (R.homEquiv (z ≫ x)) :=
    (NatTrans.naturality_apply _ _ _).symm.trans (congrArg _ (R.homEquiv_comp z x).symm)
  have hγ : (gammaZeroNaive B N).map (X.baseChangeFunctor.map z₁).op γ =
      (gammaZeroNaive B N).map (X.baseChangeFunctor.map z₂).op γ := by
    rw [e, e]
    exact gammaNaiveToGammaZeroNaive_app_eq_of_comp_gammaZeroNaiveCarrierπ_eq hN X
      (by rw [Category.assoc, Category.assoc, ← hq, reassoc_of% hz])
  -- `E_{T''}` is the fibre product `E_{T'} ×_{E_T} E_{T'}`.
  let φ := X.baseChangeFunctor.map q
  have hsq := EllObj.isPullback_baseChangeFunctor_map_total (X := X) (a := z₁) (b := z₂) (c := q)
    (d := q) (IsPullback.of_hasPullback q.left q.left)
  -- The closed subscheme `⟨P⟩` of `E_{T'}` descends along `E_{T'} ⟶ E_T`.
  have : IsAffineHom φ.total := MorphismProperty.of_isPullback φ.isPullback.flip
    (inferInstanceAs (IsAffineHom q.left))
  have : Flat φ.total := MorphismProperty.of_isPullback φ.isPullback.flip
    (inferInstanceAs (Flat q.left))
  have : Surjective φ.total := MorphismProperty.of_isPullback φ.isPullback.flip
    (inferInstanceAs (Surjective q.left))
  obtain ⟨I, hI⟩ := (gammaZeroNaiveEquiv _ γ).1.exists_comap_eq_of_isPullback φ.total hsq
    ((gammaZeroNaiveEquiv_map _ _).symm.trans
      ((congrArg (fun a ↦ (gammaZeroNaiveEquiv _ a).1) hγ).trans (gammaZeroNaiveEquiv_map _ _)))
  -- The descended closed subscheme is a naive cyclic subgroup.
  have : Etale φ.base := inferInstanceAs (Etale q.left)
  have : Surjective φ.base := inferInstanceAs (Surjective q.left)
  have : QuasiCompact φ.base := inferInstanceAs (QuasiCompact q.left)
  have hC : (X.baseChangeFunctor.obj T).curve.IsNaiveCyclicSubgroup I N :=
    EllipticCurveGeom.IsNaiveCyclicSubgroup.of_comap φ.isPullback φ.zero_total
      (hI ▸ (gammaZeroNaiveEquiv _ γ).2)
  refine ⟨(gammaZeroNaiveEquiv _).symm ⟨I, hC⟩,
    (eq_gammaZeroNaiveCarrierLift_of_comp_eq hN X q (β := R.homEquiv x) ?_ ?_).symm⟩
  · refine (gammaZeroNaiveEquiv _).injective (Subtype.ext ?_)
    rw [gammaZeroNaiveEquiv_map, Equiv.apply_symm_apply]
    exact hI.symm
  · rw [hq, Equiv.symm_apply_apply]

/-- **The classifying map is a bijection** between the naive `[Γ₀(N)]`-structures on `E_T` and
the morphisms `T ⟶ Y/Borel` of schemes over `S`. -/
theorem gammaZeroNaiveCarrierLift_bijective (T : Over X.base) :
    Function.Bijective (gammaZeroNaiveCarrierLift hN X (T := T)) :=
  ⟨gammaZeroNaiveCarrierLift_injective hN X T, fun y ↦ exists_gammaZeroNaiveCarrierLift_eq hN X y⟩

variable (B N) in
/-- **The naive moduli problem `[Γ₀(N)]` is relatively representable** where `N` is invertible on
`B` (Katz–Mazur 7.1.3; Loeffler, Proposition 3.8.2). Over `X = (E/S)`, the naive
`[Γ₀(N)]`-structures on base changes of `E` are represented by the naive `[Γ₀(N)]` carrier, the
quotient of the naive `[Γ(N)]` carrier by the Borel subgroup; a morphism `T ⟶ Y/Borel` corresponds
to the naive `[Γ₀(N)]`-structure whose classifying map it is. Its body is exposed so that the
representing schemes are the carriers by definition, as the statement of
`gammaZeroNaiveRelRepData_representableBy_homEquiv_symm` requires. -/
@[expose]
noncomputable def gammaZeroNaiveRelRepData : (gammaZeroNaive B N).RelRepData where
  rep X := (gammaZeroNaiveCarrier hN X).obj
  representableBy X :=
    { homEquiv := (Equiv.ofBijective _ (gammaZeroNaiveCarrierLift_bijective hN X _)).symm
      homEquiv_comp k l := (Equiv.symm_apply_eq _).mpr
        ((gammaZeroNaiveCarrierLift_map hN X k _).trans
          (congrArg (k ≫ ·) (Equiv.ofBijective_apply_symm_apply _ _ l))).symm }

/-- The representing scheme of the naive `[Γ₀(N)]` problem over `X` is the naive `[Γ₀(N)]`
carrier. -/
@[simp]
theorem gammaZeroNaiveRelRepData_rep :
    (gammaZeroNaiveRelRepData B N hN).rep X = (gammaZeroNaiveCarrier hN X).obj :=
  (rfl)

/-- The point of the naive `[Γ₀(N)]` carrier classifying a naive `[Γ₀(N)]`-structure is its
classifying map. -/
@[simp]
theorem gammaZeroNaiveRelRepData_representableBy_homEquiv_symm {T : Over X.base}
    (α : (gammaZeroNaive B N).obj (op (X.baseChangeFunctor.obj T))) :
    ((gammaZeroNaiveRelRepData B N hN).representableBy X).homEquiv.symm α =
      gammaZeroNaiveCarrierLift hN X α :=
  (rfl)

/-- **The naive moduli problem `[Γ₀(N)]` is finite and étale over `Ell/B`** where `N` is
invertible on `B`: every representing scheme is the finite étale naive `[Γ₀(N)]` carrier. -/
theorem hasProperty_isFinite_inf_etale_gammaZeroNaiveRelRepData :
    (gammaZeroNaiveRelRepData B N hN).HasProperty (@IsFinite ⊓ @Etale) :=
  (RelRepData.hasProperty_iff _).mpr fun X ↦
    ⟨inferInstanceAs (IsFinite (gammaZeroNaiveCarrier hN X).obj.hom),
      inferInstanceAs (Etale (gammaZeroNaiveCarrier hN X).obj.hom)⟩

/-- **The naive moduli problem `[Γ₀(N)]` is étale over `Ell/B`** where `N` is invertible on `B`
(Loeffler, Proposition 3.8.2). -/
theorem hasProperty_etale_gammaZeroNaiveRelRepData :
    (gammaZeroNaiveRelRepData B N hN).HasProperty @Etale :=
  (RelRepData.hasProperty_iff _).mpr fun X ↦
    inferInstanceAs (Etale (gammaZeroNaiveCarrier hN X).obj.hom)

end TauCeti.AlgebraicGeometry.ModuliProblem
