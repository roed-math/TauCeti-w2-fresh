module

public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.NaiveCyclicSubgroup
public import TauCeti.AlgebraicGeometry.ModularCurve.NaiveLevel
import TauCeti.AlgebraicGeometry.ResidueField

/-!
# The naive moduli problem `[Γ₀(N)]`

Over a base on which `N` is invertible, a naive `[Γ₀(N)]`-structure on an elliptic curve `E/S` is
a finite locally free subgroup scheme of `E` of rank `N`, étale-locally on `S` generated by a
single section of exact order `N` in every fibre (`EllipticCurveGeom.IsNaiveCyclicSubgroup`).
Such subgroups pull back along the arrows of `Ell/B`
(`EllipticCurveGeom.IsNaiveCyclicSubgroup.comap`), so they form a moduli problem over `Ell/B`
(`ModuliProblem.gammaZeroNaive`), recorded by their ideal sheaves as for the Drinfeld problem
`ModuliProblem.gammaZero`.

Where `N` is invertible on `B`, a naive `[Γ₁(N)]`-structure `P` generates the naive cyclic
subgroup `⟨P⟩ = [P] + ⋯ + [NP]`, and this commutes with base change: it is a morphism of moduli
problems `[Γ₁(N)] ⟶ [Γ₀(N)]` (`ModuliProblem.gammaOneNaiveToGammaZeroNaive`). Composing with
`[Γ(N)] ⟶ [Γ₁(N)]`, `(P, Q) ↦ P`, gives `[Γ(N)] ⟶ [Γ₀(N)]`, `(P, Q) ↦ ⟨P⟩`
(`ModuliProblem.gammaNaiveToGammaZeroNaive`). The first point of `(P, Q) g` is `aP + cQ` for the
first column `(a, c)` of `g`, so when `c = 0` it is the unit multiple `aP` of `P`, which generates
the same subgroup (`EllipticCurveGeom.multiplesDivisor_units`): `[Γ(N)] ⟶ [Γ₀(N)]` is invariant
under the Borel subgroup of `GL₂(ℤ/Nℤ)` of matrices with `c = 0`
(`ModuliProblem.gammaNaiveAction_hom_comp_gammaNaiveToGammaZeroNaive`), and `[Γ₁(N)] ⟶ [Γ₀(N)]`
is invariant under the units of `ℤ/Nℤ`
(`ModuliProblem.gammaOneNaiveToGammaZeroNaive_app_eq_of_units`). Conversely, by definition every
naive `[Γ₀(N)]`-structure is étale-locally in the image of `[Γ₁(N)] ⟶ [Γ₀(N)]`
(`ModuliProblem.exists_etale_gammaOneNaiveToGammaZeroNaive_app_eq`): its local generator,
transported to the canonical base change, is a naive `[Γ₁(N)]`-structure there. Since a point
of exact order `N` extends étale-locally to a basis of `E[N]`
(`ModuliProblem.exists_etale_gammaNaiveToGammaOneNaive_app_eq`), every naive
`[Γ₀(N)]`-structure is also étale-locally in the image of `[Γ(N)] ⟶ [Γ₀(N)]`
(`ModuliProblem.exists_etale_gammaNaiveToGammaZeroNaive_app_eq`).

## Main definitions

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaive B N`: the naive moduli problem
  `[Γ₀(N)]` over `Ell/B`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveEquiv`: the naive
  `[Γ₀(N)]`-structures on `(E/S)` are the ideal sheaves on `E` cutting out naive cyclic subgroups
  of order `N`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaOneNaiveToGammaZeroNaive`: where `N` is invertible,
  the morphism `[Γ₁(N)] ⟶ [Γ₀(N)]`, `P ↦ ⟨P⟩`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaNaiveToGammaZeroNaive`: where `N` is invertible,
  the morphism `[Γ(N)] ⟶ [Γ₀(N)]`, `(P, Q) ↦ ⟨P⟩`.

## Main results

* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaZeroNaiveEquiv_map`: pull-back of naive
  `[Γ₀(N)]`-structures is inverse image of ideal sheaves.
* `ModuliProblem.gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app`: the image of `P` is the
  divisor `[P] + ⋯ + [NP]`.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaOneNaiveToGammaZeroNaive_app_eq_of_units`: `P` and
  a unit multiple `uP` have the same image.
* `TauCeti.AlgebraicGeometry.ModuliProblem.exists_etale_gammaOneNaiveToGammaZeroNaive_app_eq`:
  naive `[Γ₀(N)]`-structures are étale-locally generated by naive `[Γ₁(N)]`-structures.
* `TauCeti.AlgebraicGeometry.ModuliProblem.exists_etale_gammaNaiveToGammaZeroNaive_app_eq`:
  naive `[Γ₀(N)]`-structures are étale-locally generated by the first point of a naive
  `[Γ(N)]`-structure.
* `TauCeti.AlgebraicGeometry.ModuliProblem.gammaNaiveAction_hom_comp_gammaNaiveToGammaZeroNaive`:
  `[Γ(N)] ⟶ [Γ₀(N)]` is invariant under the Borel subgroup.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §3.7 (naive level structures
  where `N` is invertible) and §7.1 (the action of `GL₂(ℤ/Nℤ)`).
* D. Loeffler, *Modular curves*, lecture notes, Definition 3.8.1.
-/

public section

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory Opposite AlgebraicGeometry
  MonObj

universe u

namespace TauCeti.AlgebraicGeometry

variable {B : Scheme.{u}}

namespace ModuliProblem

variable (B) (N : ℕ)

/-- **The naive moduli problem `[Γ₀(N)]`** over `Ell/B` (Katz–Mazur, §3.7). A naive
`[Γ₀(N)]`-structure on an object `(E/S)` of `Ell/B` is a naive cyclic subgroup of `E` of order
`N`, a finite locally free subgroup scheme of rank `N` étale-locally generated by a point of exact
order `N` in every fibre, recorded by its ideal sheaf (`gammaZeroNaiveEquiv`). It pulls back along
an arrow of `Ell/B` by inverse image (`gammaZeroNaiveEquiv_map`). It is the naive level structure
of Katz and Mazur over a base on which `N` is invertible. -/
noncomputable def gammaZeroNaive : ModuliProblem B where
  obj X := ULift.{u + 1}
    {I : X.unop.curve.carrier.IdealSheafData // X.unop.curve.IsNaiveCyclicSubgroup I N}
  map φ := TypeCat.ofHom fun I ↦
    ⟨⟨I.down.1.comap φ.unop.total, I.down.2.comap φ.unop.isPullback φ.unop.zero_total⟩⟩
  map_id X := by
    ext I : 5
    exact Scheme.IdealSheafData.comap_id _
  map_comp φ ψ := by
    ext I : 5
    exact Scheme.IdealSheafData.comap_comp _ _ _

variable {B N}

/-- The naive `[Γ₀(N)]`-structures on an object `(E/S)` of `Ell/B` are the ideal sheaves on `E`
cutting out naive cyclic subgroups of order `N`. -/
noncomputable def gammaZeroNaiveEquiv (X : EllObj B) :
    (gammaZeroNaive B N).obj (op X) ≃
      {I : X.curve.carrier.IdealSheafData // X.curve.IsNaiveCyclicSubgroup I N} :=
  Equiv.ulift

/-- The pull-back of a naive `[Γ₀(N)]`-structure along an arrow `φ` of `Ell/B` is the inverse
image of its ideal sheaf along the morphism of total spaces of `φ`. -/
@[simp]
theorem gammaZeroNaiveEquiv_map {X Y : EllObj B} (φ : X ⟶ Y)
    (α : (gammaZeroNaive B N).obj (op Y)) :
    (gammaZeroNaiveEquiv X ((gammaZeroNaive B N).map φ.op α)).1 =
      (gammaZeroNaiveEquiv Y α).1.comap φ.total :=
  (rfl)

/-- The point `P = φ 1` of a naive `[Γ₁(N)]`-structure `φ` has naive exact order `N`. -/
theorem isOfNaiveExactOrder_naiveLevelEquiv_gammaOneNaive (X : EllObj B)
    (α : (gammaOneNaive B N).obj (op X)) :
    X.curve.IsOfNaiveExactOrder ((naiveLevelEquiv X α).1 (.ofAdd 1)) N :=
  EllipticCurveGeom.isFiberwiseInjective_iff_isOfNaiveExactOrder.mp (naiveLevelEquiv X α).2

section Generator

variable [NeZero N] (hN : ∀ b : B, (N : B.residueField b) ≠ 0)

variable (B N) in
/-- **The naive cyclic subgroup generated by a point of exact order `N`**, as a morphism of naive
moduli problems `[Γ₁(N)] ⟶ [Γ₀(N)]` where `N` is invertible on `B`: it sends a naive
`[Γ₁(N)]`-structure `φ` with point `P = φ 1` to the naive cyclic subgroup
`⟨P⟩ = [P] + ⋯ + [NP]` (`gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app`). -/
noncomputable def gammaOneNaiveToGammaZeroNaive : gammaOneNaive B N ⟶ gammaZeroNaive B N where
  app X := TypeCat.ofHom fun α ↦ (gammaZeroNaiveEquiv X.unop).symm
    ⟨X.unop.curve.multiplesDivisor ((naiveLevelEquiv X.unop α).1 (.ofAdd 1)) N,
      (isOfNaiveExactOrder_naiveLevelEquiv_gammaOneNaive X.unop
        α).isNaiveCyclicSubgroup_multiplesDivisor fun _ ↦
          X.unop.structureMap.natCast_residueField_ne_zero (hN _)⟩
  naturality X Y φ := by
    ext α : 3
    -- Both sides are divisors `[Q] + ⋯ + [NQ]`: on the left `Q` is the pull-back of `P`, on the
    -- right the divisor of `P` is pulled back, and `multiplesDivisor_pointsPullback` equates them.
    have h := congrArg (fun ψ ↦ ψ (.ofAdd 1)) (naiveLevelEquiv_map (A := Multiplicative (ZMod N))
      φ.unop α)
    simp only [Quiver.Hom.op_unop, MonoidHom.comp_apply] at h
    exact (gammaZeroNaiveEquiv _).injective <| Subtype.ext <|
      (congrArg (fun Q ↦ Y.unop.curve.multiplesDivisor Q N) h).trans
        (EllipticCurveGeom.multiplesDivisor_pointsPullback φ.unop.isPullback φ.unop.zero_total _ N)

/-- The image of a naive `[Γ₁(N)]`-structure `φ` under `gammaOneNaiveToGammaZeroNaive` is the
divisor `[P] + ⋯ + [NP]` of its point `P = φ 1`. -/
@[simp]
theorem gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app (X : EllObj B)
    (α : (gammaOneNaive B N).obj (op X)) :
    (gammaZeroNaiveEquiv X ((gammaOneNaiveToGammaZeroNaive B N hN).app (op X) α)).1 =
      X.curve.multiplesDivisor ((naiveLevelEquiv X α).1 (.ofAdd 1)) N :=
  (rfl)

/-- **A point and its unit multiples generate the same naive cyclic subgroup.** If the naive
`[Γ₁(N)]`-structure `α'` is `α` precomposed with multiplication by a unit `u` of `ℤ/Nℤ`, so that
its point is `uP` for the point `P` of `α`, then `α` and `α'` have the same image in `[Γ₀(N)]`. -/
theorem gammaOneNaiveToGammaZeroNaive_app_eq_of_units (X : EllObj B)
    (α α' : (gammaOneNaive B N).obj (op X)) (u : (ZMod N)ˣ)
    (h : ∀ z : ZMod N,
      (naiveLevelEquiv X α').1 (.ofAdd z) = (naiveLevelEquiv X α).1 (.ofAdd (u * z))) :
    (gammaOneNaiveToGammaZeroNaive B N hN).app (op X) α' =
      (gammaOneNaiveToGammaZeroNaive B N hN).app (op X) α := by
  refine (gammaZeroNaiveEquiv X).injective (Subtype.ext ?_)
  rw [gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app,
    gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app, h, _root_.mul_one]
  exact EllipticCurveGeom.multiplesDivisor_units _ u

/-- **Naive `[Γ₀(N)]`-structures are étale-locally generated by naive `[Γ₁(N)]`-structures.**
For a naive `[Γ₀(N)]`-structure `C` on `(E/S)` there is an étale surjection `T ⟶ S` and a naive
`[Γ₁(N)]`-structure on the base change `E_T` whose image in `[Γ₀(N)]` is the pull-back of `C`. -/
theorem exists_etale_gammaOneNaiveToGammaZeroNaive_app_eq (X : EllObj B)
    (α : (gammaZeroNaive B N).obj (op X)) :
    ∃ (T : Over X.base) (_ : Etale T.hom) (_ : Surjective T.hom)
      (β : (gammaOneNaive B N).obj (op (X.baseChangeFunctor.obj T))),
      (gammaOneNaiveToGammaZeroNaive B N hN).app _ β =
        (gammaZeroNaive B N).map (X.baseChangeFunctorHom T).op α := by
  obtain ⟨T, t, ht, hts, E', g, hg, h0, P, hP, hI⟩ := (gammaZeroNaiveEquiv X α).2.exists_etale
  let φ := X.baseChangeFunctorHom (Over.mk t)
  -- The canonical base change of `E` along `t` maps isomorphically to `E'` over `T`.
  have hφ : 𝟙 T ≫ t = φ.base := by
    rw [Category.id_comp, EllObj.baseChangeFunctorHom_base]
    rfl
  have hk := EllipticCurveGeom.isPullback_baseChangeLift hg φ.isPullback hφ
  have h0k := EllipticCurveGeom.zero_baseChangeLift hg φ.isPullback.toCommSq hφ h0 φ.zero_total
  let P' := EllipticCurveGeom.pointsPullback hk h0k P
  have hP' : (X.baseChangeFunctor.obj (Over.mk t)).curve.IsOfNaiveExactOrder P' N :=
    hP.pointsPullback hk h0k
  let ψ := (zmodMonoidHomEquiv N _).symm ⟨P', hP'.pow_eq_one⟩
  have hψ1 : ψ (.ofAdd 1) = P' := zmodMonoidHomEquiv_symm_apply_ofAdd_one _
  have hψ : (X.baseChangeFunctor.obj (Over.mk t)).curve.IsFiberwiseInjective ψ :=
    EllipticCurveGeom.isFiberwiseInjective_iff_isOfNaiveExactOrder.mpr (by rwa [hψ1])
  refine ⟨Over.mk t, ht, hts, (naiveLevelEquiv _).symm ⟨ψ, hψ⟩, ?_⟩
  refine (gammaZeroNaiveEquiv _).injective (Subtype.ext ?_)
  rw [gammaZeroNaiveEquiv_gammaOneNaiveToGammaZeroNaive_app, Equiv.apply_symm_apply, hψ1,
    gammaZeroNaiveEquiv_map, EllipticCurveGeom.multiplesDivisor_pointsPullback hk h0k, ← hI,
    ← Scheme.IdealSheafData.comap_comp]
  exact congrArg _ (EllipticCurveGeom.baseChangeLift_fst _ _ _)

variable (B N) in
/-- The morphism `[Γ(N)] ⟶ [Γ₀(N)]` of naive moduli problems, where `N` is invertible on `B`,
sending a naive `[Γ(N)]`-structure `(P, Q)` to the naive cyclic subgroup `⟨P⟩` generated by its
first point. -/
noncomputable def gammaNaiveToGammaZeroNaive : gammaNaive B N ⟶ gammaZeroNaive B N :=
  gammaNaiveToGammaOneNaive B N ≫ gammaOneNaiveToGammaZeroNaive B N hN

/-- The image of a naive `[Γ(N)]`-structure `φ` under `gammaNaiveToGammaZeroNaive` is the divisor
`[P] + ⋯ + [NP]` of its first point `P = φ (1, 0)`. -/
@[simp]
theorem gammaZeroNaiveEquiv_gammaNaiveToGammaZeroNaive_app (X : EllObj B)
    (α : (gammaNaive B N).obj (op X)) :
    (gammaZeroNaiveEquiv X ((gammaNaiveToGammaZeroNaive B N hN).app (op X) α)).1 =
      X.curve.multiplesDivisor ((naiveLevelEquiv X α).1 (.ofAdd (1, 0))) N := by
  simp [gammaNaiveToGammaZeroNaive]

/-- **Naive `[Γ₀(N)]`-structures are étale-locally generated by the first point of a naive
`[Γ(N)]`-structure.** For a naive `[Γ₀(N)]`-structure `C` on `(E/S)` there is an étale surjection
`T ⟶ S` and a naive `[Γ(N)]`-structure `(P, Q)` on the base change `E_T` with `⟨P⟩` the pull-back
of `C`: étale-locally `C = ⟨P⟩` (`exists_etale_gammaOneNaiveToGammaZeroNaive_app_eq`), and
étale-locally again `P` is the first point of a basis
(`exists_etale_gammaNaiveToGammaOneNaive_app_eq`). -/
theorem exists_etale_gammaNaiveToGammaZeroNaive_app_eq (X : EllObj B)
    (α : (gammaZeroNaive B N).obj (op X)) :
    ∃ (T : Over X.base) (_ : Etale T.hom) (_ : Surjective T.hom)
      (β : (gammaNaive B N).obj (op (X.baseChangeFunctor.obj T))),
      (gammaNaiveToGammaZeroNaive B N hN).app _ β =
        (gammaZeroNaive B N).map (X.baseChangeFunctorHom T).op α := by
  obtain ⟨T, hTe, hTs, β₁, hβ₁⟩ := exists_etale_gammaOneNaiveToGammaZeroNaive_app_eq hN X α
  obtain ⟨T', hT'e, hT's, β, hβ⟩ := exists_etale_gammaNaiveToGammaOneNaive_app_eq hN _ β₁
  -- The base change of `E_T` to `T'` is the base change of `E` to `T'`, viewed over `S`.
  let f := X.baseChangeFunctorHom T
  let e := (EllObj.baseChangeFunctorIso f).app T'
  have he : e.inv ≫ (X.baseChangeFunctor.obj T).baseChangeFunctorHom T' ≫ f =
      X.baseChangeFunctorHom ((Over.map f.base).obj T') := by
    rw [Iso.inv_comp_eq, Iso.app_hom, EllObj.baseChangeFunctorIso_hom_app_comp]
  have hT : ((Over.map f.base).obj T').hom = T'.hom ≫ T.hom := by
    rw [Over.map_obj_hom, EllObj.baseChangeFunctorHom_base]
  refine ⟨(Over.map f.base).obj T', hT ▸ MorphismProperty.comp_mem _ _ _ hT'e hTe,
    hT ▸ ⟨hTs.surj.comp hT's.surj⟩, (gammaNaive B N).map e.inv.op β, ?_⟩
  rw [← he, op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply, ← hβ₁,
    ← NatTrans.naturality_apply, ← hβ, ← NatTrans.naturality_apply,
    ← NatTrans.naturality_apply (gammaNaiveToGammaOneNaive B N)]
  simp [gammaNaiveToGammaZeroNaive]

/-- **`[Γ(N)] ⟶ [Γ₀(N)]` is invariant under the Borel subgroup.** For a matrix
`g = !![a, b; 0, d]` of `GL₂(ℤ/Nℤ)`, the first point of `(P, Q) g` is `aP` with `a` a unit, which
generates the same naive cyclic subgroup as `P`. -/
theorem gammaNaiveAction_hom_comp_gammaNaiveToGammaZeroNaive {g : GL (Fin 2) (ZMod N)}
    (h₁₀ : g 1 0 = 0) :
    (gammaNaiveAction B N (.op g)).asIso.hom ≫ gammaNaiveToGammaZeroNaive B N hN =
      gammaNaiveToGammaZeroNaive B N hN := by
  -- The determinant `a d` of `g` is a unit, so `a` is a unit.
  have hdet : IsUnit (g 0 0 * g 1 1) := by
    have := Matrix.isUnits_det_units g
    rwa [Matrix.det_fin_two, h₁₀, mul_zero, sub_zero] at this
  let a : (ZMod N)ˣ := (isUnit_of_mul_isUnit_left hdet).unit
  ext ⟨X⟩ : 2
  refine ConcreteCategory.hom_ext _ _ fun α ↦ ?_
  -- The `[Γ₁(N)]`-structure of `(P, Q) g` is that of `(P, Q)` precomposed with multiplication by
  -- the unit `a`.
  exact gammaOneNaiveToGammaZeroNaive_app_eq_of_units hN X
    ((gammaNaiveToGammaOneNaive B N).app (op X) α)
    ((gammaNaiveToGammaOneNaive B N).app (op X)
      ((gammaNaiveAction B N (.op g)).asIso.hom.app (op X) α)) a
    fun z ↦ by simp [h₁₀, a, mul_comm]

end Generator

end ModuliProblem

end TauCeti.AlgebraicGeometry
