module

public import TauCeti.AlgebraicGeometry.Blowup.IdealSheaf
public import TauCeti.AlgebraicGeometry.Morphisms.Projective.Basic
import TauCeti.AlgebraicGeometry.Blowup.ExceptionalDivisor

/-!
# Blowups are projective

The Rees algebra `⨁ₙ Iⁿ` of an ideal sheaf `I` on a scheme `X` is generated in degree one: over an
affine open `U` it is the Rees algebra `Γ(X, U)[I(U)t]`, generated by the monomials `r t` with
`r ∈ I(U)`. So the twisting sheaf `𝒪(1)` of the blowup `Bl_I X` is invertible and relatively
ample, and when `I` is of finite type the blowup `Bl_I X ⟶ X` is projective. Blowing up the unit
ideal sheaf gives an isomorphism, so every closed immersion is projective.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.isGeneratedInDegreeOne_reesAlgebra`: the Rees algebra of
  an ideal sheaf is generated in degree one;
* `AlgebraicGeometry.Scheme.IdealSheafData.isProjective_blowupToBase`: the blowup along an ideal
  sheaf of finite type is projective;
* `IdealSheafData.isRelativelyAmple_relativeProjTwistingSheafOne_reesAlgebra`:
  `𝒪(1)` is relatively ample on the blowup along an ideal sheaf of finite type; it is relatively
  very ample for every ideal sheaf
  (`IdealSheafData.isRelativelyVeryAmple_relativeProjTwistingSheaf_reesAlgebra`);
* `TauCeti.AlgebraicGeometry.isProjective_of_isClosedImmersion`: closed immersions, in particular
  isomorphisms, are projective.

## References

* [The Stacks Project, Lemma 02NS](https://stacks.math.columbia.edu/tag/02NS): the blowing up along
  a quasi-coherent ideal of finite type is projective.
* R. Hartshorne, *Algebraic Geometry*, Proposition II.7.13.
-/

public section

open CategoryTheory DirectSum Polynomial

namespace AlgebraicGeometry.Scheme.IdealSheafData

open TauCeti.AlgebraicGeometry

universe u

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- Over an affine open `U`, the sections `⨁ n, Γ(Iⁿ, U)` of the Rees algebra are generated over
`Γ(X, U)` by the degree-one sections: under `reesAlgebraSectionsEquiv` they correspond to the
monomials `r t`, `r ∈ I(U)`, which generate the Rees algebra of `I(U)`. -/
theorem adjoin_gradedSectionsGrading_one_reesAlgebra {U : X.Opens} (hU : IsAffineOpen U) :
    Algebra.adjoin Γ(X, U)
      (I.reesAlgebra.obj.gradedSectionsGrading U 1 :
        Set (⨁ n, Γ(I.reesAlgebra.obj.X n, U))) = ⊤ := by
  let e := I.reesAlgebraSectionsEquiv hU
  let J := I.ideal ⟨U, hU⟩
  let S := Algebra.adjoin Γ(X, U)
    (I.reesAlgebra.obj.gradedSectionsGrading U 1 : Set (⨁ n, Γ(I.reesAlgebra.obj.X n, U)))
  -- The image of `S` in `Γ(X, U)[X]` contains the generators `r t` of the Rees algebra of `I(U)`.
  have hle : _root_.reesAlgebra J ≤ (S.map e.toAlgHom).map (_root_.reesAlgebra J).val := by
    refine (adjoin_monomial_eq_reesAlgebra (I := J)).symm.trans_le (Algebra.adjoin_le ?_)
    rintro _ ⟨r, hr, rfl⟩
    have hmem : monomial 1 r ∈ _root_.reesAlgebra J :=
      reesAlgebra.monomial_mem.mpr (by rwa [pow_one])
    refine ⟨⟨_, hmem⟩, ⟨e.symm ⟨_, hmem⟩, Algebra.subset_adjoin ?_, e.apply_symm_apply _⟩, rfl⟩
    rw [SetLike.mem_coe, ← I.reesAlgebraSectionsEquiv_mem_grade_iff hU, AlgEquiv.apply_symm_apply]
    exact reesAlgebra.mem_grade_iff.mpr ⟨r, by rwa [pow_one], rfl⟩
  rw [eq_top_iff]
  rintro w -
  obtain ⟨p, ⟨q, hq, hqp⟩, hp⟩ := hle (e w).2
  obtain rfl : q = w := e.injective (Subtype.ext ((congrArg Subtype.val hqp).trans hp))
  exact hq

/-- **The Rees algebra of an ideal sheaf is generated in degree one.** -/
theorem isGeneratedInDegreeOne_reesAlgebra : I.reesAlgebra.obj.IsGeneratedInDegreeOne :=
  CommMon.isGeneratedInDegreeOne_of_adjoin_eq_top fun _ hU ↦
    I.adjoin_gradedSectionsGrading_one_reesAlgebra hU

/-- **The blowup along an ideal sheaf of finite type is projective.** If the ideal `I(U)` is
finitely generated for every affine open `U` of `X`, then `Bl_I X ⟶ X` is projective. -/
@[stacks 02NS]
theorem isProjective_blowupToBase (hI : ∀ U : X.affineOpens, (I.ideal U).FG) :
    IsProjective I.blowupToBase :=
  isProjective_relativeProjToBase _ I.isGeneratedInDegreeOne_reesAlgebra
    (fun _ hU ↦ I.finiteType_sections_reesAlgebra hU (hI ⟨_, hU⟩))
    (fun U _ ↦ I.finite_sections_reesAlgebra_zero U)

/-- **`𝒪(1)` is relatively very ample on a blowup**: the twisting sheaf `𝒪(1)` of the blowup
along an ideal sheaf is relatively very ample for `Bl_I X ⟶ X`. -/
theorem isRelativelyVeryAmple_relativeProjTwistingSheaf_reesAlgebra :
    (I.reesAlgebra.obj.relativeProjTwistingSheafOne
      I.isGeneratedInDegreeOne_reesAlgebra).IsRelativelyVeryAmple I.blowupToBase :=
  InvertibleSheaf.isRelativelyVeryAmple_relativeProjTwistingSheaf _ _

/-- **`𝒪(1)` is relatively ample on a blowup**: the twisting sheaf `𝒪(1)` of the blowup along an
ideal sheaf of finite type is relatively ample for `Bl_I X ⟶ X`. -/
theorem isRelativelyAmple_relativeProjTwistingSheafOne_reesAlgebra
    (hI : ∀ U : X.affineOpens, (I.ideal U).FG) :
    (LineBundleClass.mk (I.reesAlgebra.obj.relativeProjTwistingSheafOne
      I.isGeneratedInDegreeOne_reesAlgebra)).IsRelativelyAmple I.blowupToBase :=
  have := I.isProper_blowupToBase hI
  LineBundleClass.isRelativelyAmple_relativeProjTwistingSheafOne _ _

end AlgebraicGeometry.Scheme.IdealSheafData

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry

universe u

/-- **Closed immersions are projective**, in particular isomorphisms and identities are. The
blowup along the unit ideal sheaf `⊤` of `S` is projective, and it is an isomorphism because the
empty closed subscheme is an effective Cartier divisor. So `f` is the closed immersion
`f ≫ (Bl_⊤ S ⟶ S)⁻¹` followed by a projective morphism. -/
instance isProjective_of_isClosedImmersion {X S : Scheme.{u}} (f : X ⟶ S)
    [IsClosedImmersion f] : IsProjective f := by
  have := (Scheme.IdealSheafData.isIso_blowupToBase_iff ⊤).2
    (Scheme.IdealSheafData.isEffectiveCartier_top S)
  have := (⊤ : S.IdealSheafData).isProjective_blowupToBase fun _ ↦
    ⟨{1}, by rw [Finset.coe_singleton]; exact Ideal.span_singleton_one⟩
  simpa using (inferInstance : IsProjective
    ((f ≫ inv (⊤ : S.IdealSheafData).blowupToBase) ≫ (⊤ : S.IdealSheafData).blowupToBase))

end TauCeti.AlgebraicGeometry
