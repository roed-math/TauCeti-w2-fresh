module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.Finite
public import TauCeti.CategoryTheory.Limits.ConcreteCategory.Filtered
public import TauCeti.Algebra.Category.Ring.Pushout
public import TauCeti.AlgebraicGeometry.Limits.BaseChange
public import TauCeti.CategoryTheory.MorphismProperty.Limits

/-!
# Closed immersions, finite morphisms and cofiltered limits of affine schemes

Let `S = lim Sⱼ` be a cofiltered limit of affine schemes and `Y` a scheme of finite type,
quasi-compact and quasi-separated over a member `Sᵢ`. If the base change `Y ×_{Sᵢ} S ⟶ S` is a
closed immersion, respectively finite, then so is `Y ×_{Sᵢ} Sⱼ ⟶ Sⱼ` for some `j` (Stacks,
Lemmas 32.8.5 (01ZP) and 32.8.3 (01ZO), over a cofiltered limit of affine schemes).

Both properties imply affineness, so `Y ×_{Sᵢ} S` is affine, hence so is some `Y ×_{Sᵢ} Sⱼ`
(Stacks, Lemma 32.4.13 (01Z6)), and it suffices to treat affine `Y`
(`TauCeti.AlgebraicGeometry.Scheme.exists_pullback_fst_of_isLimit_of_le_isAffineHom`). For affine
`Y` both follow one pattern. The ring `Γ(Y ×_{Sᵢ} Sₗ) = Γ(Sₗ) ⊗ Γ(Y)` is generated by the
images of `Γ(Sₗ)` and `Γ(Y)`, and `Γ(Y)` is generated over `Γ(Sᵢ)` by finitely many sections. So
it is enough that each of these finitely many sections pulls back, at some stage `l`, into the
image of `Γ(Sₗ)`,
respectively into the integral closure of `Γ(Sₗ)`
(`TauCeti.AlgebraicGeometry.Scheme.exists_forall_appTop_snd_mem`). Over `S` this holds by
assumption; the witnesses (a section of `S`, or a monic polynomial over `Γ(S)`) come from some
`Sⱼ`, and since `Y ×_{Sᵢ} S` is the limit of the `Y ×_{Sᵢ} Sₗ`, the required equation between
sections already holds at some stage.

## Main declarations

* `TauCeti.AlgebraicGeometry.Scheme.exists_forall_appTop_snd_mem`: if every section of `Y` pulls
  back into a compatible family of subrings `R l ⊆ Γ(Y ×_{Sᵢ} Sₗ)` containing the image of
  `Γ(Sₗ)` at some stage, then all of them do at a single stage.
* `TauCeti.AlgebraicGeometry.Scheme.exists_isClosedImmersion_pullback_fst_of_isLimit_of_isAffine`,
  `TauCeti.AlgebraicGeometry.Scheme.exists_isFinite_pullback_fst_of_isLimit_of_isAffine`: the
  affine case.
* `TauCeti.AlgebraicGeometry.Scheme.exists_pullback_fst_of_isLimit_of_le_isAffineHom`: a property
  implying affineness that is inherited in the affine case is inherited for quasi-compact
  quasi-separated `Y`.
* `Scheme.exists_isClosedImmersion_pullback_fst_of_isLimit_of_forall_isAffine`,
  `Scheme.exists_isFinite_pullback_fst_of_isLimit_of_forall_isAffine`: closed immersions and
  finite morphisms are inherited from a finite stage over a cofiltered limit of affine schemes.
-/

public section

universe u

open CategoryTheory Limits AlgebraicGeometry Polynomial

namespace TauCeti.AlgebraicGeometry.Scheme

variable {I : Type u} [Category.{u} I] [IsCofiltered I] {D : I ⥤ Scheme.{u}}

/-- Let `q : Y ⟶ Sᵢ` be a morphism of finite type from an affine scheme to an affine member of a
cofiltered diagram of schemes, and `R l ⊆ Γ(Y ×_{Sᵢ} Sₗ)` subrings, for `l` over `i`, that
contain the image of `Γ(Sₗ)` and are carried into each other by the transition maps. If every
section of `Y` pulls back into `R l` for some `l`, then all sections of `Y` do for a single `l`. -/
theorem exists_forall_appTop_snd_mem {i : I} [IsAffine (D.obj i)] {Y : Scheme.{u}} [IsAffine Y]
    (q : Y ⟶ D.obj i) [LocallyOfFiniteType q]
    (R : ∀ l : Over i, Subring Γ(pullback (D.map l.hom) q, ⊤))
    (range_le : ∀ l, (pullback.fst (D.map l.hom) q).appTop.hom.range ≤ R l)
    (map_mem : ∀ {l m : Over i} (f : m ⟶ l) (x), x ∈ R l →
      ((D.pullbackOver q).map f).appTop x ∈ R m)
    (h : ∀ y, ∃ l, (pullback.snd (D.map l.hom) q).appTop y ∈ R l) :
    ∃ l, ∀ y, (pullback.snd (D.map l.hom) q).appTop y ∈ R l := by
  -- The sections of `Y` whose pullback to `Y ×_{Sᵢ} Sₗ` lies in `R l`.
  let T (l : Over i) : Subring Γ(Y, ⊤) := (R l).comap (pullback.snd (D.map l.hom) q).appTop.hom
  have range_le' (l : Over i) : q.appTop.hom.range ≤ T l := by
    rintro _ ⟨a, rfl⟩
    refine range_le l ⟨(D.map l.hom).appTop a, ?_⟩
    simp only [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, pullback.condition]
  have mono {l m : Over i} (f : m ⟶ l) : T l ≤ T m := by
    intro y hy
    have h₂ := congr((Scheme.Hom.appTop $(D.pullbackOver_map_snd q f)).hom y)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₂
    rw [Subring.mem_comap, ← h₂]
    exact map_mem f _ hy
  -- Finitely many sections lie in a common `T l`.
  have fin (s : Finset Γ(Y, ⊤)) : ∃ l, ∀ y ∈ s, y ∈ T l := by
    classical
    induction s using Finset.induction_on with
    | empty => exact ⟨Over.mk (𝟙 i), by simp⟩
    | insert y s _ ih =>
      obtain ⟨l, hl⟩ := ih
      obtain ⟨l', hl'⟩ := h y
      refine ⟨IsCofiltered.min l l', Finset.forall_mem_insert _ _ _ |>.mpr
        ⟨mono (IsCofiltered.minToRight l l') hl', fun z hz ↦ mono (IsCofiltered.minToLeft l l')
          (hl z hz)⟩⟩
  -- `Γ(Y)` is generated over `Γ(Sᵢ)` by finitely many sections, which lie in a common `T l`.
  algebraize [q.appTop.hom]
  obtain ⟨s, hs⟩ := (HasRingHomProperty.appTop @LocallyOfFiniteType q ‹_›).out
  obtain ⟨l, hl⟩ := fin s
  refine ⟨l, fun y ↦ ?_⟩
  rw [← Subring.mem_comap]
  have hy : y ∈ Algebra.adjoin Γ(D.obj i, ⊤) (s : Set Γ(Y, ⊤)) := hs ▸ Algebra.mem_top
  induction hy using Algebra.adjoin_induction with
  | mem x hx => exact hl x hx
  | algebraMap r => exact range_le' l ⟨r, rfl⟩
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy => exact mul_mem hx hy

variable [∀ i, IsAffine (D.obj i)] {c : Cone D} (hc : IsLimit c)

include hc in
/-- Let `S = lim Sⱼ` be a cofiltered limit of affine schemes, and `Y` an affine scheme of finite
type over a member `Sᵢ`. If the base change `Y ×_{Sᵢ} S ⟶ S` is a closed immersion, then so is
`Y ×_{Sᵢ} Sⱼ ⟶ Sⱼ` for some `j`. Stacks, Lemma 32.8.5 (01ZP), affine case. -/
theorem exists_isClosedImmersion_pullback_fst_of_isLimit_of_isAffine {i : I} {Y : Scheme.{u}}
    [IsAffine Y] (q : Y ⟶ D.obj i) [LocallyOfFiniteType q]
    [IsClosedImmersion (pullback.fst (c.π.app i) q)] :
    ∃ (j : I) (hji : j ⟶ i), IsClosedImmersion (pullback.fst (D.map hji) q) := by
  have : IsAffine (((Functor.const I).obj c.pt).obj i) := Scheme.isAffine_of_isLimit c hc
  have map_mem {l m : Over i} (f : m ⟶ l) (b : Γ(D.obj l.left, ⊤)) :
      ((D.pullbackOver q).map f).appTop ((pullback.fst (D.map l.hom) q).appTop b) ∈
        (pullback.fst (D.map m.hom) q).appTop.hom.range := by
    refine ⟨(D.map f.left).appTop b, ?_⟩
    have h₁ := congr((Scheme.Hom.appTop $(D.pullbackOver_map_fst q f)).hom b)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₁
    exact h₁.symm
  have one (y : Γ(Y, ⊤)) :
      ∃ l : Over i, (pullback.snd (D.map l.hom) q).appTop y ∈
        (pullback.fst (D.map l.hom) q).appTop.hom.range := by
    -- Over `S` the pullback of `y` comes from a section of `S`, which comes from some `Sⱼ`.
    obtain ⟨a, ha⟩ := (IsClosedImmersion.isAffine_surjective_of_isAffine
      (pullback.fst (c.π.app i) q)).2 ((pullback.snd (c.π.app i) q).appTop y)
    obtain ⟨j, b, rfl⟩ := exists_appTop_π_eq_of_isLimit D c hc a
    let l : Over i := Over.mk (IsCofiltered.minToRight j i)
    let b' := (D.map (IsCofiltered.minToLeft j i)).appTop b
    -- The two pullbacks to `Y ×_{Sᵢ} Sₗ` agree on the limit, hence at some later stage.
    have hzero : ((c.pullbackOver q).π.app l).appTop
        ((pullback.fst (D.map l.hom) q).appTop b' - (pullback.snd (D.map l.hom) q).appTop y) =
          0 := by
      have h₁ := congr((Scheme.Hom.appTop $(c.pullbackOver_π_app_fst q l)).hom b')
      have h₂ := congr((Scheme.Hom.appTop $(c.pullbackOver_π_app_snd q l)).hom y)
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₁ h₂
      rw [map_sub, h₁, h₂, sub_eq_zero, ← ha]
      congr 1
      simp only [b', l, ← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, c.w]
    obtain ⟨m, f, hm⟩ := exists_appTop_map_eq_zero_of_isLimit (D.pullbackOver q)
      (c.pullbackOver q) (hc.pullbackOver q) _ hzero
    have h₂ := congr((Scheme.Hom.appTop $(D.pullbackOver_map_snd q f)).hom y)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₂
    rw [map_sub, sub_eq_zero] at hm
    exact ⟨m, h₂ ▸ hm ▸ map_mem f b'⟩
  obtain ⟨l, hl⟩ := exists_forall_appTop_snd_mem q
    (fun l ↦ (pullback.fst (D.map l.hom) q).appTop.hom.range) (fun _ ↦ le_rfl)
    (by rintro l m f _ ⟨b, rfl⟩; exact map_mem f b) one
  refine ⟨l.left, l.hom, IsClosedImmersion.of_surjective_of_isAffine _ ?_⟩
  refine TauCeti.CommRingCat.surjective_of_isPushout
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback _ _)) ?_
  rintro _ ⟨y, rfl⟩
  exact hl y

include hc in
/-- Let `S = lim Sⱼ` be a cofiltered limit of affine schemes, and `Y` an affine scheme of finite
type over a member `Sᵢ`. If the base change `Y ×_{Sᵢ} S ⟶ S` is finite, then so is
`Y ×_{Sᵢ} Sⱼ ⟶ Sⱼ` for some `j`. Stacks, Lemma 32.8.3 (01ZO), affine case. -/
theorem exists_isFinite_pullback_fst_of_isLimit_of_isAffine {i : I} {Y : Scheme.{u}} [IsAffine Y]
    (q : Y ⟶ D.obj i) [LocallyOfFiniteType q] [IsFinite (pullback.fst (c.π.app i) q)] :
    ∃ (j : I) (hji : j ⟶ i), IsFinite (pullback.fst (D.map hji) q) := by
  have : IsAffine (((Functor.const I).obj c.pt).obj i) := Scheme.isAffine_of_isLimit c hc
  -- The sections of `Y ×_{Sᵢ} Sₗ` integral over `Γ(Sₗ)`.
  let R (l : Over i) : Subring Γ(pullback (D.map l.hom) q, ⊤) :=
    { carrier := {x | (pullback.fst (D.map l.hom) q).appTop.hom.IsIntegralElem x}
      mul_mem' := fun hx hy ↦ hx.mul _ hy
      one_mem' := RingHom.isIntegralElem_one _
      add_mem' := fun hx hy ↦ RingHom.IsIntegralElem.add _ hx hy
      zero_mem' := RingHom.isIntegralElem_zero _
      neg_mem' := fun hx ↦ hx.neg }
  -- The transition maps of `D` over `i` and of its base change to `Y` are compatible.
  have comp_eq {l m : Over i} (f : m ⟶ l) :
      ((D.pullbackOver q).map f).appTop.hom.comp (pullback.fst (D.map l.hom) q).appTop.hom =
        (pullback.fst (D.map m.hom) q).appTop.hom.comp (D.map f.left).appTop.hom := by
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop,
      ← Scheme.Hom.comp_appTop, D.pullbackOver_map_fst]
  have map_mem {l m : Over i} (f : m ⟶ l) (x) (hx : x ∈ R l) :
      ((D.pullbackOver q).map f).appTop x ∈ R m :=
    RingHom.IsIntegralElem.of_comp (f := (D.map f.left).appTop.hom) (comp_eq f ▸ hx.map _)
  have one (y : Γ(Y, ⊤)) : ∃ l : Over i, (pullback.snd (D.map l.hom) q).appTop y ∈ R l := by
    -- Over `S` the pullback of `y` is a root of a monic polynomial, which comes from some `Sⱼ`.
    obtain ⟨p, hp, hpy⟩ := (pullback.fst (c.π.app i) q).finite_appTop.to_isIntegral
      ((pullback.snd (c.π.app i) q).appTop y)
    obtain ⟨hΓ⟩ := nonempty_isColimit_Γ_mapCocone D c hc
    obtain ⟨⟨j⟩, hj⟩ :=
      TauCeti.CategoryTheory.Limits.Concrete.exists_subset_range_of_isColimit hΓ
        p.coeffs.finite_toSet
    obtain ⟨pj, hpj, -, hpj₁⟩ := lifts_and_natDegree_eq_and_monic
      (f := (c.π.app j).appTop.hom) ((lifts_iff_coeff_lifts p).mpr fun n ↦ by
        by_cases hn : p.coeff n = 0
        · exact hn ▸ ⟨0, map_zero _⟩
        · exact hj (coeff_mem_coeffs hn)) hp
    let l : Over i := Over.mk (IsCofiltered.minToRight j i)
    let pl := pj.map (D.map (IsCofiltered.minToLeft j i)).appTop.hom
    -- Its evaluation at the pullback of `y` to `Y ×_{Sᵢ} Sₗ` vanishes on the limit, hence at
    -- some later stage.
    have hzero : ((c.pullbackOver q).π.app l).appTop
        (pl.eval₂ (pullback.fst (D.map l.hom) q).appTop.hom
          ((pullback.snd (D.map l.hom) q).appTop y)) = 0 := by
      have h₁ : ((c.pullbackOver q).π.app l).appTop.hom.comp
          (pullback.fst (D.map l.hom) q).appTop.hom =
            (pullback.fst (c.π.app i) q).appTop.hom.comp (c.π.app l.left).appTop.hom := by
        rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop,
          ← Scheme.Hom.comp_appTop, c.pullbackOver_π_app_fst]
      have h₂ := congr((Scheme.Hom.appTop $(c.pullbackOver_π_app_snd q l)).hom y)
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₂
      rw [hom_eval₂, h₁, h₂, ← eval₂_map, ← hpy, ← hpj, map_map]
      congr 2
      rw [← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, c.w]
    obtain ⟨m, f, hm⟩ := exists_appTop_map_eq_zero_of_isLimit (D.pullbackOver q)
      (c.pullbackOver q) (hc.pullbackOver q) _ hzero
    have h₂ := congr((Scheme.Hom.appTop $(D.pullbackOver_map_snd q f)).hom y)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h₂
    refine ⟨m, h₂ ▸ RingHom.IsIntegralElem.of_comp (f := (D.map f.left).appTop.hom)
      (comp_eq f ▸ ⟨pl, hpj₁.map _, by rw [← hom_eval₂]; exact hm⟩)⟩
  obtain ⟨l, hl⟩ := exists_forall_appTop_snd_mem q R
    (by rintro l _ ⟨b, rfl⟩; exact RingHom.isIntegralElem_map _) map_mem one
  have : IsFinite (Spec.map (pullback.fst (D.map l.hom) q).appTop) :=
    (IsFinite.SpecMap_iff _).mpr <| RingHom.IsIntegral.to_finite
      (TauCeti.CommRingCat.isIntegral_of_isPushout
        (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback _ _)) hl)
      (HasRingHomProperty.appTop @LocallyOfFiniteType (pullback.fst _ _) inferInstance)
  refine ⟨l.left, l.hom, ?_⟩
  rw [← Iso.hom_inv_id_assoc (pullback (D.map l.hom) q).isoSpec (pullback.fst _ _),
    ← Scheme.isoSpec_inv_naturality]
  infer_instance

include hc in
/-- Let `S = lim Sⱼ` be a cofiltered limit of affine schemes and `P` a property of morphisms,
closed under isomorphisms and implying affineness, that is inherited from a finite stage by base
changes of affine schemes of finite type over a member. Then `P` is inherited from a finite stage
by base changes of schemes of finite type, quasi-compact and quasi-separated over a member: if
`Y ×_{Sᵢ} S ⟶ S` has `P`, then `Y ×_{Sᵢ} Sⱼ` is affine for some `j` (Stacks, Lemma 32.4.13 (01Z6)),
and the affine case applies over `Sⱼ`. -/
theorem exists_pullback_fst_of_isLimit_of_le_isAffineHom (P : MorphismProperty Scheme.{u})
    [P.RespectsIso] (hP : P ≤ @IsAffineHom)
    (H : ∀ {j : I} {Y : Scheme.{u}} [IsAffine Y] (q : Y ⟶ D.obj j) [LocallyOfFiniteType q],
      P (pullback.fst (c.π.app j) q) → ∃ (k : I) (hkj : k ⟶ j), P (pullback.fst (D.map hkj) q))
    {i : I} {Y : Scheme.{u}} (q : Y ⟶ D.obj i) [QuasiCompact q] [QuasiSeparated q]
    [LocallyOfFiniteType q] (hq : P (pullback.fst (c.π.app i) q)) :
    ∃ (j : I) (hji : j ⟶ i), P (pullback.fst (D.map hji) q) := by
  have : IsAffine (((Functor.const I).obj c.pt).obj i) := Scheme.isAffine_of_isLimit c hc
  have := hP _ hq
  have : IsAffine (pullback (c.π.app i) q) := isAffine_of_isAffineHom (pullback.fst _ _)
  -- Some base change `Y ×_{Sᵢ} Sⱼ` is affine.
  obtain ⟨⟨j, _, hji⟩, hj⟩ := Scheme.exists_isAffine_of_isLimit (D.pullbackOver q)
    (c.pullbackOver q) (hc.pullbackOver q)
  have : IsAffine (pullback (D.map hji) q) := hj
  -- Base changes along `Sₖ ⟶ Sⱼ ⟶ Sᵢ` are base changes along the composite.
  obtain ⟨k, hkj, hk⟩ := H (pullback.fst (D.map hji) q)
    ((P.pullback_fst_pullback_fst_iff _ _ _ (c.w hji)).mpr hq)
  exact ⟨k, hkj ≫ hji, (P.pullback_fst_pullback_fst_iff _ _ _ (D.map_comp hkj hji).symm).mp hk⟩

include hc in
/-- Let `S = lim Sⱼ` be a cofiltered limit of affine schemes, and `Y` a scheme of finite type,
quasi-compact and quasi-separated over a member `Sᵢ`. If the base change `Y ×_{Sᵢ} S ⟶ S` is a
closed immersion, then so is `Y ×_{Sᵢ} Sⱼ ⟶ Sⱼ` for some `j`. Stacks, Lemma 32.8.5 (01ZP), over a
cofiltered limit of affine schemes. -/
theorem exists_isClosedImmersion_pullback_fst_of_isLimit_of_forall_isAffine {i : I}
    {Y : Scheme.{u}} (q : Y ⟶ D.obj i) [QuasiCompact q] [QuasiSeparated q]
    [LocallyOfFiniteType q]
    [IsClosedImmersion (pullback.fst (c.π.app i) q)] :
    ∃ (j : I) (hji : j ⟶ i), IsClosedImmersion (pullback.fst (D.map hji) q) :=
  exists_pullback_fst_of_isLimit_of_le_isAffineHom hc @IsClosedImmersion
    (fun _ _ _ _ ↦ inferInstance)
    (fun q _ hq ↦ have := hq; exists_isClosedImmersion_pullback_fst_of_isLimit_of_isAffine hc q) q
    ‹_›

include hc in
/-- Let `S = lim Sⱼ` be a cofiltered limit of affine schemes, and `Y` a scheme of finite type,
quasi-compact and quasi-separated over a member `Sᵢ`. If the base change `Y ×_{Sᵢ} S ⟶ S` is
finite, then so is `Y ×_{Sᵢ} Sⱼ ⟶ Sⱼ` for some `j`. Stacks, Lemma 32.8.3 (01ZO), over a cofiltered
limit of affine schemes. -/
theorem exists_isFinite_pullback_fst_of_isLimit_of_forall_isAffine {i : I} {Y : Scheme.{u}}
    (q : Y ⟶ D.obj i) [QuasiCompact q] [QuasiSeparated q] [LocallyOfFiniteType q]
    [IsFinite (pullback.fst (c.π.app i) q)] :
    ∃ (j : I) (hji : j ⟶ i), IsFinite (pullback.fst (D.map hji) q) :=
  -- Instance search does not find `RespectsIso @IsFinite` through `HasAffineProperty`.
  have : MorphismProperty.RespectsIso @IsFinite.{u} :=
    MorphismProperty.respectsIso_of_isStableUnderComposition fun _ _ f
      (_ : MorphismProperty.isomorphisms _ f) ↦ inferInstance
  exists_pullback_fst_of_isLimit_of_le_isAffineHom hc @IsFinite (fun _ _ _ _ ↦ inferInstance)
    (fun q _ hq ↦ have := hq; exists_isFinite_pullback_fst_of_isLimit_of_isAffine hc q) q ‹_›

end TauCeti.AlgebraicGeometry.Scheme
