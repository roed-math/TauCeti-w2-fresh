/-!
# The conductor of an algebra

For an algebra `B` over a commutative ring `A`, the **conductor** of `B` over `A` is the ideal

`𝔠 = {a ∈ A | a B ⊆ A} = Ann_A(B / A)`

of elements of `A` carrying all of `B` into the image of `A`. Here `B / A` is the quotient of `B`
by the image of `A`, an `A`-module but not in general a ring. When `A → B` is the normalization of
a reduced one-dimensional ring, this is the classical conductor of its singularities. Mathlib's
`conductor R x` is a different object: for `x` in an `R`-algebra `S` it is the largest ideal of
`S` contained in `R<x>`, an ideal of the larger ring, and it is defined only for the subalgebra
generated by one element.

When `B` is finite over `A`, the conductor commutes with localization: for a submonoid `S` of `A`,
the conductor of `S⁻¹B` over `S⁻¹A` is the extension of the conductor of `B` over `A`. This is the
compatibility that lets the conductors of a finite morphism of schemes over the affine opens of
its target glue to an ideal sheaf. Without finiteness only one inclusion holds.

## Main definitions

* `TauCeti.Algebra.conductor A B`: the conductor of `B` over `A`, the annihilator of `B / A`.

## Main results

* `TauCeti.Algebra.conductor_eq_annihilator`: the conductor is the annihilator of `B / A`.
* `TauCeti.Algebra.mem_conductor_iff`: `a` lies in the conductor exactly when `a • b` lies in the
  image of `A` for every `b : B`.
* `TauCeti.Algebra.conductor_eq_colon`: the conductor is the colon ideal `(A : B)`.
* `TauCeti.Algebra.conductor_eq_top_iff`: the conductor is the unit ideal exactly when
  `A → B` is surjective.
* `TauCeti.Algebra.ker_algebraMap_le_conductor`: the kernel of `A → B` lies in the conductor.
* `TauCeti.Algebra.map_conductor_le`: the extension of the conductor to a localization
  lies in the conductor of the localization.
* `TauCeti.Algebra.conductor_eq_map`: for `B` finite over `A`, the conductor of a
  localization `S⁻¹B` over `S⁻¹A` is the extension of the conductor of `B` over `A`.
* `TauCeti.Algebra.map_conductor_le_one`: the extension of the conductor to `B` lies in the image
  of `A`.
* `TauCeti.Algebra.quotientOneEquivOfLE`: modulo an ideal of `B` lying in the image of `A`, the
  cokernel of `A → B` is unchanged; with the conductor this is the conductor square of a
  normalization.

## References

* J.-P. Serre, *Algebraic Groups and Class Fields*, Chapter IV, §1, for the conductor of the
  normalization of a singular curve.
-/

public section

noncomputable section

namespace TauCeti.Algebra

variable (A B : Type*) [CommRing A] [Ring B] [Algebra A B]

/-- The **conductor** of an `A`-algebra `B`: the annihilator of the `A`-module `B / A`, the
quotient of `B` by the image of `A`. Its elements are the `a : A` with `a • B ⊆ A`
(`TauCeti.Algebra.mem_conductor_iff`). -/
def conductor : Ideal A :=
  Module.annihilator A (B ⧸ (1 : Submodule A B))

/-- The conductor is the annihilator of the quotient of `B` by the image of `A`. Under the module
system the body of `conductor` is not exported, so this is how importers unfold it. -/
theorem conductor_eq_annihilator :
    conductor A B = Module.annihilator A (B ⧸ (1 : Submodule A B)) :=
  (rfl)

/-- The conductor is the colon ideal `(A : B)` of `A` in `B`. -/
theorem conductor_eq_colon : conductor A B = (1 : Submodule A B).colon Set.univ :=
  Submodule.annihilator_quotient

variable {A B}

/-- An element `a : A` lies in the conductor exactly when it carries every element of `B` into
the image of `A`. -/
@[simp]
theorem mem_conductor_iff {a : A} :
    a ∈ conductor A B ↔ ∀ b : B, ∃ c : A, algebraMap A B c = algebraMap A B a * b := by
  simp [conductor_eq_colon, Submodule.mem_colon, Submodule.mem_one, Algebra.smul_def]

/-- The conductor is the unit ideal exactly when `A → B` is surjective. -/
@[simp]
theorem conductor_eq_top_iff : conductor A B = ⊤ ↔ Function.Surjective (algebraMap A B) := by
  simp [Ideal.eq_top_iff_one, Function.Surjective]

/-- The kernel of `A → B` lies in the conductor: an element mapping to zero carries `B` to
zero. -/
theorem ker_algebraMap_le_conductor : RingHom.ker (algebraMap A B) ≤ conductor A B :=
  fun a ha ↦ mem_conductor_iff.mpr fun _ ↦ ⟨0, by simp [(RingHom.mem_ker).mp ha]⟩

section Localization

variable {B : Type*} [CommRing B] [Algebra A B]
variable (S : Submonoid A) (A' B' : Type*) [CommRing A'] [CommRing B'] [Algebra A A']
  [IsLocalization S A'] [Algebra B B'] [IsLocalization (Algebra.algebraMapSubmonoid B S) B']
  [Algebra A' B'] [Algebra A B'] [IsScalarTower A A' B'] [IsScalarTower A B B']

include S in
/-- The extension of the conductor of `B` over `A` to a localization `A'` of `A` lies in the
conductor of the corresponding localization `B'` of `B`. No finiteness is needed for this
inclusion. -/
theorem map_conductor_le :
    (conductor A B).map (algebraMap A A') ≤ conductor A' B' := by
  have h := IsLocalizedModule.map_annihilator_le S A'
    ((1 : Submodule A B).toLocalizedQuotient' A' S (IsScalarTower.toAlgHom A B B').toLinearMap)
  rwa [Submodule.localized'_one S A' B'] at h

include S in
/-- **The conductor commutes with localization.** If `B` is finite over `A`, `A'` is the
localization of `A` at a submonoid `S` and `B'` the localization of `B` at the image of `S`, then
the conductor of `B'` over `A'` is the extension of the conductor of `B` over `A`. -/
theorem conductor_eq_map [Module.Finite A B] :
    conductor A' B' = (conductor A B).map (algebraMap A A') := by
  have h := IsLocalizedModule.annihilator_eq_map S A'
    ((1 : Submodule A B).toLocalizedQuotient' A' S (IsScalarTower.toAlgHom A B B').toLinearMap)
  rwa [Submodule.localized'_one S A' B'] at h

end Localization

section Quotient

variable {B : Type*} [CommRing B] [Algebra A B]

/-- The extension of the conductor to `B` lies in the image of `A`: it is the largest ideal of `B`
contained in `A`. -/
theorem map_conductor_le_one :
    ((conductor A B).map (algebraMap A B) : Set B) ⊆ (1 : Submodule A B) := by
  intro b hb
  -- Every element of the extension still carries all of `B` into the image of `A`.
  suffices h : ∀ b' : B, b * b' ∈ (1 : Submodule A B) by simpa using h 1
  refine Submodule.span_induction (p := fun z _ ↦ ∀ b' : B, z * b' ∈ (1 : Submodule A B))
    ?_ (fun _ ↦ by simp) (fun _ _ _ _ h₁ h₂ b' ↦ by simpa [add_mul] using add_mem (h₁ b') (h₂ b'))
    (fun c z _ hz b' ↦ by simpa [smul_eq_mul, mul_assoc, mul_left_comm] using hz (c * b')) hb
  rintro _ ⟨a, ha, rfl⟩ b'
  obtain ⟨c, hc⟩ := mem_conductor_iff.mp ha b'
  exact Submodule.mem_one.mpr ⟨c, hc⟩

/-- The cokernel of `A → B / I` as a quotient of `B`. -/
private abbrev quotientOneMk (I : Ideal B) : B →ₗ[A] (B ⧸ I) ⧸ (1 : Submodule A (B ⧸ I)) :=
  (1 : Submodule A (B ⧸ I)).mkQ ∘ₗ (Ideal.Quotient.mkₐ A I).toLinearMap

private theorem ker_quotientOneMk (I : Ideal B) (hI : (I : Set B) ⊆ (1 : Submodule A B)) :
    LinearMap.ker (quotientOneMk I) = (1 : Submodule A B) := by
  ext b
  simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_one, AlgHom.toLinearMap_apply,
    Ideal.Quotient.mkₐ_eq_mk]
  refine ⟨fun ⟨a, ha⟩ ↦ ?_, fun ⟨a, ha⟩ ↦ ⟨a, by rw [← ha]; rfl⟩⟩
  rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq] at ha
  obtain ⟨c, hc⟩ := Submodule.mem_one.mp (hI ha)
  exact ⟨a - c, by rw [map_sub, hc]; ring⟩

/-- **Cokernels modulo an ideal inside `A`.** If an ideal `I` of `B` lies in the image of `A`, for
instance the extension of the conductor (`TauCeti.Algebra.map_conductor_le_one`), then the
cokernel `B / A` of `A → B` is the cokernel of `A → B / I`. For the normalization of a curve and
the conductor this identifies the functions on the normalization modulo those on the curve with
the functions on the preimage of the singular locus modulo those on the singular locus. -/
def quotientOneEquivOfLE (I : Ideal B) (hI : (I : Set B) ⊆ (1 : Submodule A B)) :
    (B ⧸ (1 : Submodule A B)) ≃ₗ[A] (B ⧸ I) ⧸ (1 : Submodule A (B ⧸ I)) :=
  Submodule.quotEquivOfEq _ _ (ker_quotientOneMk I hI).symm ≪≫ₗ
    (quotientOneMk I).quotKerEquivOfSurjective
      ((Submodule.mkQ_surjective _).comp Ideal.Quotient.mk_surjective)

/-- `TauCeti.Algebra.quotientOneEquivOfLE` sends the class of `b` to the class of its image
in `B / I`. -/
@[simp]
theorem quotientOneEquivOfLE_mk (I : Ideal B) (hI : (I : Set B) ⊆ (1 : Submodule A B)) (b : B) :
    quotientOneEquivOfLE I hI (Submodule.Quotient.mk b) =
      Submodule.Quotient.mk (Ideal.Quotient.mk I b) := by
  rw [quotientOneEquivOfLE, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk]
  rfl

end Quotient

end TauCeti.Algebra
