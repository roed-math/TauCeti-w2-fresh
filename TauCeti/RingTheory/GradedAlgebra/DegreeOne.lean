module

public import TauCeti.RingTheory.GradedAlgebra.FiniteType

/-!
# The degree-one part of an `ℕ`-graded algebra

Let `A = ⨁ n, 𝒜 n` be an `ℕ`-graded `R`-algebra. This file records two facts about the degree-one
part `𝒜 1`, used to embed projective spectra into projective spaces.

If `A` is of finite type over `R` and `𝒜 0` is finite over `R`, then `𝒜 1` is finite over `R`:
writing `A` as generated over `𝒜 0` by finitely many homogeneous elements of positive degree, the
generators of degree one span `𝒜 1` over `𝒜 0`, since a product of generators has degree one only
if it is a single generator of degree one.

If `A` is generated over `𝒜 0` by `𝒜 1`, then every homogeneous element of positive degree is a sum
of products of elements of degree one: the coefficients in `𝒜 0` are absorbed into a factor of
degree one. So a ring homomorphism into `A` whose image contains `𝒜 1` is surjective in positive
degrees.

## Main results

* `TauCeti.GradedAlgebra.finite_grade_one`: `𝒜 1` is finite over `R` if `A` is of finite type
  over `R` and `𝒜 0` is finite over `R`.
* `TauCeti.GradedAlgebra.mem_closure_grade_one`: if `A` is generated over `𝒜 0` by `𝒜 1`, then the
  homogeneous elements of positive degree lie in the subsemiring generated by `𝒜 1`.
-/

public section

open DirectSum

namespace TauCeti.GradedAlgebra

variable {R A : Type*} [CommSemiring R] [CommSemiring A] [Algebra R A]
  (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]

/-- A product of homogeneous elements of positive degree is homogeneous; it is `1` if its degree
is zero, and it is one of the factors if its degree is one. -/
theorem exists_mem_grade_of_mem_closure {s : Set A} (hs : ∀ x ∈ s, ∃ n ≠ 0, x ∈ 𝒜 n) {m : A}
    (hm : m ∈ Submonoid.closure s) : ∃ d, m ∈ 𝒜 d ∧ (d = 0 → m = 1) ∧ (d = 1 → m ∈ s) := by
  induction hm using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨n, hn, hxn⟩ := hs x hx
    exact ⟨n, hxn, fun h ↦ absurd h hn, fun _ ↦ hx⟩
  | one => exact ⟨0, SetLike.GradedOne.one_mem, fun _ ↦ rfl, fun h ↦ absurd h zero_ne_one⟩
  | mul x y _ _ hx hy =>
    obtain ⟨d, hxd, hx0, hx1⟩ := hx
    obtain ⟨e, hye, hy0, hy1⟩ := hy
    refine ⟨d + e, SetLike.GradedMul.mul_mem hxd hye, fun h ↦ ?_, fun h ↦ ?_⟩
    · rw [hx0 (by omega), hy0 (by omega), one_mul]
    · obtain ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ : d = 0 ∧ e = 1 ∨ d = 1 ∧ e = 0 := by omega
      · rw [hx0 rfl, one_mul]
        exact hy1 rfl
      · rw [hy0 rfl, mul_one]
        exact hx1 rfl

/-- If `𝒜 0` and homogeneous elements `s` of positive degree generate `A`, then the elements of `s`
of degree one span `𝒜 1` over `𝒜 0`. -/
theorem mem_span_inter_grade_one {s : Set A} (hs : ∀ x ∈ s, ∃ n ≠ 0, x ∈ 𝒜 n)
    (htop : Algebra.adjoin (𝒜 0) s = ⊤) {x : A} (hx : x ∈ 𝒜 1) :
    x ∈ Submodule.span (𝒜 0) (s ∩ 𝒜 1) := by
  have hx' : x ∈ Submodule.span (𝒜 0) (Submonoid.closure s : Set A) := by
    rw [← Algebra.adjoin_eq_span, htop]
    trivial
  rw [← decompose_of_mem_same 𝒜 hx]
  clear hx
  induction hx' using Submodule.span_induction with
  | mem m hm =>
    obtain ⟨d, hmd, -, hd1⟩ := exists_mem_grade_of_mem_closure 𝒜 hs hm
    by_cases h : d = 1
    · subst h
      rw [decompose_of_mem_same 𝒜 hmd]
      exact Submodule.subset_span ⟨hd1 rfl, hmd⟩
    · rw [decompose_of_mem_ne 𝒜 hmd h]
      exact zero_mem _
  | zero => simp
  | add y z _ _ hy hz =>
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact add_mem hy hz
  | smul c y _ hy =>
    rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply,
      coe_decompose_mul_of_left_mem_zero 𝒜 c.2]
    exact Submodule.smul_mem _ c hy

/-- The degree-one part of a graded algebra of finite type over `R` whose degree-zero part is
finite over `R` is finite over `R`. -/
theorem finite_grade_one [Algebra.FiniteType R A] [Module.Finite R (𝒜 0)] :
    Module.Finite R (𝒜 1) := by
  obtain ⟨s, hs, hdeg⟩ := exists_finset_adjoin_eq_top_and_mem_grade_ne_zero 𝒜
  have key : (Submodule.span (𝒜 0) ((s : Set A) ∩ 𝒜 1)).restrictScalars R = 𝒜 1 := by
    refine le_antisymm (fun x hx ↦ ?_) fun x hx ↦ mem_span_inter_grade_one 𝒜 hdeg hs hx
    induction hx using Submodule.span_induction with
    | mem y hy => exact hy.2
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | smul c y _ hy =>
      rw [Algebra.smul_def]
      simpa using SetLike.GradedMul.mul_mem c.2 hy
  rw [Module.Finite.iff_fg, ← key]
  exact (Submodule.fg_span (s.finite_toSet.inter_of_left _)).restrictScalars

/-- If `A` is generated over `𝒜 0` by `𝒜 1`, then every homogeneous element of positive degree is
a sum of products of elements of degree one. -/
theorem mem_closure_grade_one {i : ℕ} (hi : 0 < i)
    (htop : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤) {x : A} (hx : x ∈ 𝒜 i) :
    x ∈ Subsemiring.closure (𝒜 1 : Set A) := by
  -- A product of elements of degree one absorbs a factor of degree zero, unless it is empty.
  have habs {m : A} (hm : m ∈ Submonoid.closure (𝒜 1 : Set A)) :
      m = 1 ∨ ∀ c ∈ 𝒜 0, c * m ∈ Subsemiring.closure (𝒜 1 : Set A) := by
    induction hm using Submonoid.closure_induction with
    | mem y hy =>
      refine .inr fun c hc ↦ Subsemiring.subset_closure ?_
      simpa using SetLike.GradedMul.mul_mem hc hy
    | one => exact .inl rfl
    | mul y z hy hz hy' hz' =>
      obtain rfl | hy' := hy'
      · obtain rfl | hz' := hz'
        · exact .inl (one_mul 1)
        · exact .inr fun c hc ↦ by simpa using hz' c hc
      · refine .inr fun c hc ↦ ?_
        rw [← mul_assoc]
        exact Subsemiring.mul_mem _ (hy' c hc) (Submonoid.closure_le.mpr
          Subsemiring.subset_closure hz)
  have hx' : x ∈ Submodule.span (𝒜 0) (Submonoid.closure (𝒜 1 : Set A) : Set A) := by
    rw [← Algebra.adjoin_eq_span, htop]
    trivial
  rw [← decompose_of_mem_same 𝒜 hx, ← one_mul (decompose 𝒜 x i : A)]
  have h1 : (1 : A) ∈ 𝒜 0 := SetLike.GradedOne.one_mem
  generalize (1 : A) = c at h1 ⊢
  clear hx
  induction hx' using Submodule.span_induction generalizing c with
  | mem m hm =>
    obtain rfl | hm' := habs hm
    · rw [decompose_of_mem_ne 𝒜 SetLike.GradedOne.one_mem hi.ne, mul_zero]
      exact zero_mem _
    obtain ⟨d, hmd, -, -⟩ := exists_mem_grade_of_mem_closure 𝒜
      (fun y hy ↦ ⟨1, one_ne_zero, hy⟩) hm
    by_cases hd : d = i
    · subst hd
      rw [decompose_of_mem_same 𝒜 hmd]
      exact hm' c h1
    · rw [decompose_of_mem_ne 𝒜 hmd hd, mul_zero]
      exact zero_mem _
  | zero => simp
  | add y z _ _ hy hz =>
    rw [decompose_add, DirectSum.add_apply, Submodule.coe_add, mul_add]
    exact add_mem (hy c h1) (hz c h1)
  | smul c' y _ hy =>
    rw [Algebra.smul_def, SetLike.GradeZero.algebraMap_apply,
      coe_decompose_mul_of_left_mem_zero 𝒜 c'.2, ← mul_assoc]
    exact hy _ (by simpa using SetLike.GradedMul.mul_mem h1 c'.2)

end TauCeti.GradedAlgebra
