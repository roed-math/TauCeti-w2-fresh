module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.LinearAlgebra.Basis.SMul
public import Mathlib.LinearAlgebra.Dimension.Free
public import Mathlib.RingTheory.Spectrum.Prime.FreeLocus
public import Mathlib.RingTheory.Spectrum.Prime.Topology

/-!
# Free complements of rank one over a local ring

Let `R` be a local ring and `N` a submodule of an `R`-module `M` such that `M ⧸ N` is finite and
flat of rank one at the closed point. Then `M ⧸ N` is free of rank one, and lifting a basis
vector gives `s : M` with `M = N ⊕ R s` and `R ⟶ R s` injective.

Over a general ring, a finite projective module of rank one at a prime `p` is generated by a
single element away from some `g ∉ p`: a generator of the free stalk at `p` spreads out to a
basic open neighbourhood of `p`.

This is how a line bundle quotient of a filtration is split by a single element after
localising, e.g. the choice of the Weierstrass coordinates `x` and `y` in the pole filtration of
an elliptic curve, first at a point of the base and then on a neighbourhood of it.

## Main results

* `TauCeti.IsLocalRing.exists_isCompl_span_singleton_of_rankAtStalk_eq_one`: a submodule whose
  quotient is finite flat of rank one has a complement spanned by one linearly independent
  element.
* `TauCeti.Module.exists_notMem_bijective_localizedModule_map_toSpanSingleton`: a finite
  projective module of rank one at `p` is free on one element `x` after inverting some `g ∉ p`.
-/

public section

namespace TauCeti.IsLocalRing

variable {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]

/-- Over a local ring `R`, a submodule `N` of `M` whose quotient `M ⧸ N` is finite and flat of
rank one at the closed point has a complement `R ∙ s` spanned by a linearly independent element:
`M = N ⊕ R s`. -/
theorem exists_isCompl_span_singleton_of_rankAtStalk_eq_one (N : Submodule R M)
    [Module.Finite R (M ⧸ N)] [Module.Flat R (M ⧸ N)]
    (h : Module.rankAtStalk (M ⧸ N) (IsLocalRing.closedPoint R) = 1) :
    ∃ s : M, IsCompl N (R ∙ s) ∧ LinearIndependent R ![s] := by
  have := Module.free_of_flat_of_isLocalRing (R := R) (P := M ⧸ N)
  have hr : Module.finrank R (M ⧸ N) = 1 := by
    rw [← h, Module.rankAtStalk_eq_finrank_of_free]
    rfl
  let b := Module.finBasisOfFinrankEq R (M ⧸ N) hr
  obtain ⟨s, hs⟩ := N.mkQ_surjective (b 0)
  have hmk (x : M) : N.mkQ x = b.repr (N.mkQ x) 0 • b 0 := by
    conv_lhs => rw [← b.sum_repr (N.mkQ x)]
    simp
  have hind (r : R) (hr : r • s ∈ N) : r = 0 := by
    have : b.repr (r • b 0) 0 = r := by simp
    rw [← this, ← hs, ← map_smul, Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).2 hr]
    simp
  refine ⟨s, ⟨?_, ?_⟩, ?_⟩
  · rw [Submodule.disjoint_def]
    intro x hxN hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hx
    rw [hind r hxN, zero_smul]
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    rw [← sub_add_cancel x (b.repr (N.mkQ x) 0 • s)]
    refine Submodule.add_mem_sup ?_
      (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self s))
    rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul,
      ← Submodule.mkQ_apply, ← Submodule.mkQ_apply, hs, ← hmk, sub_self]
  · have hb : N.mkQ ∘ ![s] = b := by
      ext i
      fin_cases i
      simp [hs]
    exact .of_comp N.mkQ (hb ▸ b.linearIndependent)

end TauCeti.IsLocalRing

namespace TauCeti.Module

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- A finite projective `R`-module `M` of rank one at a prime `p` is free of rank one on a single
element `x : M` away from some `g ∉ p`: the map `R ⟶ M`, `r ↦ r • x`, becomes bijective after
inverting `g`. The element `x` lifts a basis vector of the free stalk `M_p`, and the bijection at
`p` spreads out by `Module.FinitePresentation.exists_notMem_bijective`. -/
theorem exists_notMem_bijective_localizedModule_map_toSpanSingleton
    [Module.Finite R M] [Module.Projective R M] (p : PrimeSpectrum R)
    (h : Module.rankAtStalk M p = 1) :
    ∃ x : M, ∃ g ∉ p.asIdeal,
      Function.Bijective (LocalizedModule.map (.powers g) (LinearMap.toSpanSingleton R M x)) := by
  let S := p.asIdeal.primeCompl
  let Rₚ := Localization.AtPrime p.asIdeal
  let Mₚ := LocalizedModule S M
  have := Module.free_of_flat_of_isLocalRing (R := Rₚ) (P := Mₚ)
  let b := Module.finBasisOfFinrankEq Rₚ Mₚ h
  obtain ⟨x, t, hxt⟩ : ∃ x t, LocalizedModule.mk x t = b 0 :=
    LocalizedModule.induction_on (fun x t ↦ ⟨x, t, rfl⟩) (b 0)
  have ht : IsUnit (algebraMap R Rₚ t) := IsLocalization.map_units Rₚ t
  have hx : LocalizedModule.mk x 1 = (algebraMap R Rₚ t) • b 0 := by
    rw [← hxt, algebraMap_smul, LocalizedModule.smul'_mk, LocalizedModule.mk_eq]
    exact ⟨1, by simp [Submonoid.smul_def]⟩
  let b' := b.unitsSMul fun _ ↦ ht.unit
  let fR := Algebra.linearMap R Rₚ
  let fM := LocalizedModule.mkLinearMap S M
  let φ := IsLocalizedModule.mapExtendScalars S fR fM Rₚ (LinearMap.toSpanSingleton R M x)
  have hφ (a : Rₚ) : φ a = b'.equivFun.symm (fun _ ↦ a) := by
    rw [Module.Basis.equivFun_symm_apply, Fin.sum_univ_one, Module.Basis.unitsSMul_apply,
      Units.smul_def, IsUnit.unit_spec, ← hx]
    conv_lhs => rw [← mul_one a, ← smul_eq_mul, map_smul]
    congr 1
    rw [show (1 : Rₚ) = fR 1 from (map_one (algebraMap R Rₚ)).symm]
    change IsLocalizedModule.map S fR fM (LinearMap.toSpanSingleton R M x) (fR 1) = _
    rw [IsLocalizedModule.map_apply]
    simp [fM]
  have hbij : Function.Bijective
      (IsLocalizedModule.map S fR fM (LinearMap.toSpanSingleton R M x)) := by
    have : ⇑(IsLocalizedModule.map S fR fM (LinearMap.toSpanSingleton R M x)) = ⇑φ := rfl
    rw [this, funext hφ]
    exact b'.equivFun.symm.bijective.comp (Equiv.funUnique (Fin 1) Rₚ).symm.bijective
  have := Module.finitePresentation_of_projective R M
  obtain ⟨g, hg, H⟩ := Module.FinitePresentation.exists_notMem_bijective
    (LinearMap.toSpanSingleton R M x) p.asIdeal fR fM hbij
  exact ⟨x, g, hg, H⟩

end TauCeti.Module
