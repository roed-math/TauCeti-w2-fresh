/-!
# The quadratic relation at a node

Let `A` be the local ring at a node of a curve over a field `K`. By
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`, `A` is a quotient `P ⧸ (f)` of a
formally smooth, hence regular, local ring `P` whose maximal ideal is generated by two
coordinates, with `f ∈ 𝔪_P²` and the Hessian determinant of `f` a unit. By
`TauCeti.exists_quadratic_relation_of_isUnit_det_hessian`, the maximal ideal of `A` is then
`(x, y)`, not principal, with `x` a nonzerodivisor, `a x² + b x y + y² = 0` and `b² - 4a` a unit:
the shape in which `TauCeti.RingTheory.Node.Resolution` resolves a node by one blowup. In
particular the integral closure of `A` in `A_x` is the blowup chart `A[𝔪/x]`, which is finite over
`A` and all of whose localizations at maximal ideals are discrete valuation rings.

## Main results

* `TauCeti.exists_quadratic_relation_mul_unit`: the shape survives multiplying `x` by a unit.
* `TauCeti.radical_span_singleton_eq_maximalIdeal`: in that shape, `𝔪` is the radical of `(x)`,
  so `A_x` is the ring of functions on the punctured spectrum.
* `TauCeti.exists_quadratic_relation_of_formallyUnramified` and
  `Algebra.Presentation.exists_quadratic_relation_of_formallyUnramified`: the shape holds at a node
  of a curve over a field, presented locally or globally.
* `TauCeti.exists_integralClosure_eq_affineBlowup_of_formallyUnramified`: at a node of a curve over
  a field, one blowup at the closed point is the integral closure of `A` in `A_x`, and it is
  finite over `A` with regular local rings, indeed discrete valuation rings, at maximal ideals.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
-/

public section

noncomputable section

open IsLocalRing KaehlerDifferential

namespace TauCeti

section Normalize

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- The quadratic relation at a node, with `x` a nonzerodivisor and `𝔪` not principal, is
transported along a ring isomorphism. -/
theorem exists_quadratic_relation_of_ringEquiv {B : Type*} [CommRing B] [IsLocalRing B]
    (e : A ≃+* B) (h : ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧
      x ∈ nonZeroDivisors A ∧ ¬ (maximalIdeal A).IsPrincipal ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1)) :
    ∃ x y a b : B, maximalIdeal B = Ideal.span {x, y} ∧ x ∈ nonZeroDivisors B ∧
      ¬ (maximalIdeal B).IsPrincipal ∧ a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧
      IsUnit (discrim a b 1) := by
  obtain ⟨x, y, a, b, hm, hx, hprin, hrel, hd⟩ := h
  refine ⟨e x, e y, e a, e b, ?_,
    MulEquivClass.map_nonZeroDivisors e ▸ Submonoid.mem_map_of_mem e hx, ?_,
    by simpa using congr_arg e hrel, by simpa [discrim, map_ofNat] using hd.map e⟩
  · rw [← map_maximalIdeal_of_surjective (e : A →+* B) e.surjective, hm, Ideal.map_span,
      Set.image_pair]
    rfl
  · rintro ⟨t, ht⟩
    refine hprin ⟨e.symm t, ?_⟩
    rw [← map_maximalIdeal_of_surjective (e.symm : B →+* A) e.symm.surjective, ht,
      Ideal.submodule_span_eq, Ideal.map_span, Set.image_singleton]
    rfl

/-- The quadratic relation at a node survives multiplying the first generator by a unit `w`: the
relation `a x² + b x y + y² = 0` becomes `(a w⁻²) (x w)² + (b w⁻¹) (x w) y + y² = 0`. -/
theorem exists_quadratic_relation_mul_unit {x y a b : A} (hm : maximalIdeal A = Ideal.span {x, y})
    (hx : x ∈ nonZeroDivisors A) (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
    (hd : IsUnit (discrim a b 1)) (w : Aˣ) :
    ∃ a' b' : A, maximalIdeal A = Ideal.span {x * w, y} ∧ x * w ∈ nonZeroDivisors A ∧
      a' * (x * w) ^ 2 + b' * (x * w) * y + y ^ 2 = 0 ∧ IsUnit (discrim a' b' 1) := by
  refine ⟨a * ↑(w⁻¹ ^ 2), b * ↑w⁻¹, ?_, mul_mem hx (Units.isUnit w).mem_nonZeroDivisors, ?_, ?_⟩
  · rw [hm, Set.insert_eq, Set.insert_eq, Ideal.span_union, Ideal.span_union,
      Ideal.span_singleton_mul_right_unit (Units.isUnit w)]
  · simp only [Units.val_pow_eq_pow_val]
    linear_combination hrel + (a * x ^ 2 * (↑w⁻¹ * w + 1) + b * x * y) * w.inv_mul
  · have : discrim (a * ↑(w⁻¹ ^ 2)) (b * ↑w⁻¹) 1 = discrim a b 1 * ↑(w⁻¹ ^ 2) := by
      simp only [discrim, Units.val_pow_eq_pow_val]
      ring
    rw [this]
    exact hd.mul (Units.isUnit _)

/-- If the maximal ideal `(x, y)` of a local ring satisfies `a x² + b x y + y² = 0`, then `𝔪` is the
radical of `(x)`, since `y² = -(a x + b y) x`. So the punctured spectrum of `A` is `D(x)`, and the
ring of functions on it is `A_x`. -/
theorem radical_span_singleton_eq_maximalIdeal {x y a b : A}
    (hm : maximalIdeal A = Ideal.span {x, y}) (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0) :
    (Ideal.span {x}).radical = maximalIdeal A := by
  refine le_antisymm ((Ideal.radical_mono ?_).trans (maximalIdeal.isMaximal A).isPrime.radical.le)
    ?_
  · rw [hm]
    exact Ideal.span_mono (by simp)
  rw [hm, Ideal.span_le, Set.pair_subset_iff]
  refine ⟨Ideal.le_radical (Ideal.mem_span_singleton_self _), 2, ?_⟩
  rw [show y ^ 2 = -(a * x + b * y) * x by linear_combination hrel]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

end Normalize

section Node

variable {K : Type*} [Field K]

/-- Transport `TauCeti.exists_quadratic_relation_of_isUnit_det_hessian` along a `K`-algebra
isomorphism `P ⧸ (f) ≃ A`, for `P` formally smooth with coordinates `y` whose differentials form
the basis `b`; `P` is then a regular local ring. -/
private theorem exists_quadratic_relation_of_algEquiv {P A : Type*} [CommRing P] [Algebra K P]
    [IsLocalRing P] [Algebra.EssFiniteType K P] [Algebra.FormallySmooth K P] [CommRing A]
    [Algebra K A] [IsLocalRing A] {y : Fin 2 → P} (b : Module.Basis (Fin 2) P Ω[P⁄K])
    (hy : maximalIdeal P = Ideal.span (Set.range y)) (hb : ∀ j, b j = D K P (y j)) {f : P}
    (hf : f ∈ maximalIdeal P ^ 2)
    (hH : IsUnit (hessian (fun i ↦ (b.coord i).compDer (D K P)) f).det)
    (φ : (P ⧸ Ideal.span {f}) ≃ₐ[K] A) :
    ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧ x ∈ nonZeroDivisors A ∧
      ¬ (maximalIdeal A).IsPrincipal ∧ a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧
      IsUnit (discrim a b 1) := by
  have : IsRegularLocalRing P := IsRegularLocalRing.of_formallySmooth (R := K)
  exact exists_quadratic_relation_of_isUnit_det_hessian hy
    (fun i j ↦ by simp [← hb, Finsupp.single_apply, eq_comm]) hf hH
    ((φ : P ⧸ Ideal.span {f} →+* A).comp (Ideal.Quotient.mk _))
    (φ.surjective.comp Ideal.Quotient.mk_surjective)
    ((RingHom.ker_comp_of_injective _ φ.injective).trans Ideal.mk_ker)

variable {Q A ι σ : Type*} [CommRing Q] [Algebra K Q] [IsLocalRing Q]
  [Algebra.EssFiniteType K Q] [Algebra.FormallySmooth K Q] [CommRing A] [Algebra K A]
  [IsLocalRing A] [Algebra.EssFiniteType K A] [Fintype ι] [Fintype σ]
  [Algebra.FormallyUnramified K (A ⧸ fittingIdeal A Ω[A⁄K] 1)]

/-- **The quadratic relation at a node.** In the setting of
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`, the local ring at a node of a
curve over a field: `A` is a quotient of a formally smooth local `K`-algebra `Q` with `|ι|`
coordinates by `|ι| - 1` relations, `A ⧸ Fitt₁(Ω[A⁄K])` is unramified over `K`, and
`Fitt₁(Ω[A⁄K])` is proper. Then the maximal ideal of `A` is `(x, y)`, not principal, with `x` a
nonzerodivisor, `a x² + b x y + y² = 0` and `b² - 4a` a unit. -/
theorem exists_quadratic_relation_of_formallyUnramified (bQ : Module.Basis ι Q Ω[Q⁄K])
    (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) :
    ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧ x ∈ nonZeroDivisors A ∧
      ¬ (maximalIdeal A).IsPrincipal ∧ a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧
      IsUnit (discrim a b 1) := by
  obtain ⟨s₀, _, y, b', _, hm, hb', hf, hdet, φ, -⟩ :=
    exists_hypersurface_presentation_of_formallyUnramified bQ π hπ hg hσ hsing
  exact exists_quadratic_relation_of_algEquiv b' hm hb' hf hdet φ

/-- **One blowup normalizes a node of a curve over a field.** In the setting of
`TauCeti.exists_quadratic_relation_of_formallyUnramified`, the maximal ideal of the local ring `A`
at a node is `(x, y)`, and the blowup chart `A[𝔪/x]` is finite over `A`, is the integral closure
of `A` in `A_x`, and has regular localizations at its maximal ideals, which are discrete valuation
rings by `TauCeti.isDiscreteValuationRing_localization_affineBlowup`. -/
theorem exists_integralClosure_eq_affineBlowup_of_formallyUnramified
    (bQ : Module.Basis ι Q Ω[Q⁄K]) (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧
      Module.Finite A ((maximalIdeal A).affineBlowup x (Localization.Away x)) ∧
      integralClosure A (Localization.Away x) =
        (maximalIdeal A).affineBlowup x (Localization.Away x) ∧
      ∀ (𝔫 : Ideal ((maximalIdeal A).affineBlowup x (Localization.Away x))) [𝔫.IsMaximal],
        IsRegularLocalRing (Localization.AtPrime 𝔫) := by
  obtain ⟨x, y, a, b, hm, -, -, hrel, hd⟩ :=
    exists_quadratic_relation_of_formallyUnramified bQ π hπ hg hσ hsing
  have : IsNoetherianRing A := Algebra.EssFiniteType.isNoetherianRing K A
  exact ⟨x, y, hm, finite_affineBlowup (S := Localization.Away x) hm hrel,
    integralClosure_eq_affineBlowup hm hrel hd,
    fun 𝔫 _ ↦ isRegularLocalRing_localization_affineBlowup hm hrel hd 𝔫⟩

end Node

end TauCeti

namespace Algebra.Presentation

open TauCeti

variable {K S ι σ : Type*} [Field K] [CommRing S] [Algebra K S] [Algebra.EssFiniteType K S]
  [Fintype ι] [Fintype σ] [Algebra.FormallyUnramified K (S ⧸ fittingIdeal S Ω[S⁄K] 1)]

/-- **The quadratic relation at a node of a presented curve.** Let `S` be presented over a field
`K` by `c + 1` generators and `c` relations, with `S ⧸ Fitt₁(Ω[S⁄K])` unramified over `K`, and let
`q` be a prime of `S` containing `Fitt₁(Ω[S⁄K])`. Then the maximal ideal of `S_q` is `(x, y)`, not
principal, with `x` a nonzerodivisor, `a x² + b x y + y² = 0` and `b² - 4a` a unit. -/
theorem exists_quadratic_relation_of_formallyUnramified (P : Presentation K S ι σ)
    (hP : Fintype.card σ + 1 = Fintype.card ι) (q : Ideal S) [q.IsPrime]
    (hq : fittingIdeal S Ω[S⁄K] 1 ≤ q) :
    ∃ x y a b : Localization.AtPrime q, maximalIdeal _ = Ideal.span {x, y} ∧
      x ∈ nonZeroDivisors _ ∧ ¬ (maximalIdeal (Localization.AtPrime q)).IsPrincipal ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1) := by
  obtain ⟨s₀, _, y, b', _, hm, hb', hf, hdet, φ, -⟩ :=
    P.exists_hypersurface_presentation_of_formallyUnramified hP q hq
      (Localization.AtPrime (q.comap (algebraMap P.Ring S)))
  exact exists_quadratic_relation_of_algEquiv b' hm hb' hf hdet φ

end Algebra.Presentation
