/-!
# The quadratic relation at a node

Let `A` be the local ring at a node of a curve over a field `K`. By
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`, `A` is a quotient `P ⧸ (f)` of a
local ring `P` whose maximal ideal is generated by two coordinates `s, t`, with `f ∈ 𝔪_P²` and the
Hessian determinant of `f` a unit. Writing `f = a s² + b s t + c t²`, this says that the
discriminant `b² - 4ac` is a unit (`TauCeti.isUnit_det_hessian_iff_isUnit_discrim`).

This file normalizes that relation: after a linear change of coordinates, which is possible over
any local ring because a nondegenerate binary quadratic form has some unit coefficient among `a`,
`c` and `a - b + c`, the coefficient of `t²` becomes one. Thus the maximal ideal of `A` is
`(x, y)` with `a x² + b x y + y² = 0` and `b² - 4a` a unit, the shape in which
`TauCeti.RingTheory.Node.Resolution` resolves a node by one blowup. In particular the integral
closure of `A` in `A_x` is the blowup chart `A[𝔪/x]`, which is finite over `A` and all of whose
localizations at maximal ideals are discrete valuation rings.

## Main results

* `TauCeti.exists_quadratic_relation_of_isUnit_discrim`: a local ring whose maximal ideal
  `(s, t)` satisfies a quadratic relation with unit discriminant has generators `x, y` of its
  maximal ideal with `a x² + b x y + y² = 0` and `b² - 4a` a unit.
* `TauCeti.exists_quadratic_relation_of_isUnit_det_hessian`: the same holds for `P ⧸ (f)` when
  `f ∈ 𝔪_P²` has a unit Hessian determinant with respect to coordinates of `P`.
* `TauCeti.mem_nonZeroDivisors_of_maximalIdeal_notMem_associatedPrimes`: in that shape, `x` is a
  nonzerodivisor when `A` has positive depth.
* `TauCeti.exists_quadratic_relation_of_formallyUnramified` and
  `Algebra.Presentation.exists_quadratic_relation_of_formallyUnramified`: the shape holds at a node
  of a curve over a field, presented locally or globally.
* `TauCeti.exists_integralClosure_eq_affineBlowup_of_formallyUnramified`: at a node of a curve over
  a field, one blowup at the closed point is the integral closure of `A` in `A_x`, and it is
  finite over `A` with regular local rings, indeed discrete valuation rings, at maximal ideals.
* `TauCeti.exists_conductor_affineBlowup_eq_maximalIdeal_of_formallyUnramified`: if moreover `A` is
  reduced and not a field, the conductor of this normalization is `𝔪` and its cokernel is the
  residue field.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves, defined by a nondegenerate quadratic form in two variables.
-/

public section

noncomputable section

open IsLocalRing KaehlerDifferential

namespace TauCeti

section Normalize

variable {A : Type*} [CommRing A] [IsLocalRing A]

/-- The case of `TauCeti.exists_quadratic_relation_of_isUnit_discrim` where the coefficient
of `t²` is a unit: divide by it. -/
private theorem exists_quadratic_relation_of_isUnit_discrim_of_isUnit {s t a b c : A}
    (hm : maximalIdeal A = Ideal.span {s, t}) (hf : a * s ^ 2 + b * s * t + c * t ^ 2 = 0)
    (hd : IsUnit (discrim a b c)) (hc : IsUnit c) :
    ∃ x y a' b' : A, maximalIdeal A = Ideal.span {x, y} ∧
      a' * x ^ 2 + b' * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a' b' 1) := by
  obtain ⟨u, rfl⟩ := hc
  refine ⟨s, t, a * ↑u⁻¹, b * ↑u⁻¹, hm, ?_, ?_⟩
  · linear_combination (↑u⁻¹ : A) * hf - t ^ 2 * u.inv_mul
  · have : discrim (a * ↑u⁻¹) (b * ↑u⁻¹) 1 = discrim a b u * ↑(u⁻¹ ^ 2) := by
      simp only [discrim, Units.val_pow_eq_pow_val]
      linear_combination (4 * a * ↑u⁻¹ : A) * u.inv_mul
    rw [this]
    exact hd.mul (Units.isUnit _)

/-- **Normalizing the quadratic relation at a node.** Let `A` be a local ring whose maximal ideal
`(s, t)` satisfies `a s² + b s t + c t² = 0` with `b² - 4ac` a unit. Then the maximal ideal has
generators `x, y` satisfying `a' x² + b' x y + y² = 0` with `b'² - 4a'` a unit. -/
theorem exists_quadratic_relation_of_isUnit_discrim {s t a b c : A}
    (hm : maximalIdeal A = Ideal.span {s, t}) (hf : a * s ^ 2 + b * s * t + c * t ^ 2 = 0)
    (hd : IsUnit (discrim a b c)) :
    ∃ x y a' b' : A, maximalIdeal A = Ideal.span {x, y} ∧
      a' * x ^ 2 + b' * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a' b' 1) := by
  by_cases hc : IsUnit c
  · exact exists_quadratic_relation_of_isUnit_discrim_of_isUnit hm hf hd hc
  by_cases ha : IsUnit a
  · -- Exchange `s` and `t`.
    refine exists_quadratic_relation_of_isUnit_discrim_of_isUnit (s := t) (t := s)
      (a := c) (b := b) (c := a) (by rw [hm, Set.pair_comm]) (by linear_combination hf)
      (by convert hd using 1; simp only [discrim]; ring) ha
  · -- Both `a` and `c` lie in `𝔪`, so `b` is a unit, and then so is the coefficient
    -- `a - b + c` of `t²` in the coordinates `s + t, t`.
    rw [← mem_nonunits_iff, ← mem_maximalIdeal] at ha hc
    have hb : IsUnit b := by
      by_contra hb
      rw [← mem_nonunits_iff, ← mem_maximalIdeal] at hb
      refine (mem_maximalIdeal _).mp ?_ hd
      rw [discrim, sq]
      exact sub_mem (Ideal.mul_mem_left _ _ hb) (Ideal.mul_mem_left _ _ hc)
    refine exists_quadratic_relation_of_isUnit_discrim_of_isUnit (s := s + t) (t := t)
      (a := a) (b := b - 2 * a) (c := a - b + c) ?_ (by linear_combination hf)
      (by convert hd using 1; simp only [discrim]; ring) ?_
    · rw [hm]
      refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_) <;>
        rintro _ (rfl | rfl) <;> rw [SetLike.mem_coe, Ideal.mem_span_pair]
      exacts [⟨1, -1, by ring⟩, ⟨0, 1, by ring⟩, ⟨1, 1, by ring⟩, ⟨0, 1, by ring⟩]
    · by_contra h
      rw [← mem_nonunits_iff, ← mem_maximalIdeal] at h
      refine (mem_maximalIdeal _).mp ?_ hb
      have := sub_mem (add_mem ha hc) h
      rwa [show a + c - (a - b + c) = b by ring] at this

/-- The quadratic relation at a node is transported along a ring isomorphism. -/
theorem exists_quadratic_relation_of_ringEquiv {B : Type*} [CommRing B] [IsLocalRing B]
    (e : A ≃+* B) (h : ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1)) :
    ∃ x y a b : B, maximalIdeal B = Ideal.span {x, y} ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1) := by
  obtain ⟨x, y, a, b, hm, hrel, hd⟩ := h
  refine ⟨e x, e y, e a, e b, ?_, by simpa using congr_arg e hrel,
    by simpa [discrim, map_ofNat] using hd.map e⟩
  rw [← map_maximalIdeal_of_surjective (e : A →+* B) e.surjective, hm, Ideal.map_span,
    Set.image_pair]
  rfl

end Normalize

section Hessian

variable {R P A : Type*} [CommSemiring R] [CommRing P] [Algebra R P] [IsLocalRing P] [CommRing A]
  [IsLocalRing A]

omit [IsLocalRing P] in
/-- An element of `(s, t)²` is a binary quadratic form in `s, t`. -/
private theorem exists_eq_quadratic_of_mem_span_pair_sq {s t f : P}
    (hf : f ∈ Ideal.span {s, t} ^ 2) : ∃ a b c : P, f = a * s ^ 2 + b * s * t + c * t ^ 2 := by
  rw [sq] at hf
  refine Submodule.mul_induction_on hf (fun m hm n hn ↦ ?_) ?_
  · obtain ⟨p, q, rfl⟩ := Ideal.mem_span_pair.mp hm
    obtain ⟨p', q', rfl⟩ := Ideal.mem_span_pair.mp hn
    exact ⟨p * p', p * q' + q * p', q * q', by ring⟩
  · rintro _ _ ⟨a, b, c, rfl⟩ ⟨a', b', c', rfl⟩
    exact ⟨a + a', b + b', c + c', by ring⟩

/-- **The quadratic relation of a plane curve singularity.** Let `P` be a local ring with
coordinates `x 0, x 1` generating its maximal ideal and dual derivations `D`, and let
`f ∈ 𝔪_P²` have a unit Hessian determinant. If `φ : P → A` is a surjection onto a local ring
killing `f`, then the maximal ideal of `A` is `(x, y)` with `a x² + b x y + y² = 0` and
`b² - 4a` a unit. -/
theorem exists_quadratic_relation_of_isUnit_det_hessian {x : Fin 2 → P}
    {D : Fin 2 → Derivation R P P} (hm : maximalIdeal P = Ideal.span (Set.range x))
    (hD : ∀ i j, D i (x j) = if i = j then 1 else 0) {f : P} (hf : f ∈ maximalIdeal P ^ 2)
    (hdet : IsUnit (hessian D f).det) (φ : P →+* A) (hφ : Function.Surjective φ)
    (hφf : φ f = 0) :
    ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1) := by
  have hrange : Set.range x = {x 0, x 1} := by
    ext z
    simp [Fin.exists_fin_two, eq_comm]
  rw [hrange] at hm
  obtain ⟨a, b, c, rfl⟩ := exists_eq_quadratic_of_mem_span_pair_sq (hm ▸ hf)
  have hx (i : Fin 2) : x i ∈ maximalIdeal P := by
    rw [hm]
    fin_cases i
    exacts [Ideal.subset_span (by simp), Ideal.subset_span (by simp)]
  have hd := (isUnit_det_hessian_iff_isUnit_discrim hx hD a b c).mp hdet
  have : IsLocalHom φ := .of_surjective φ hφ
  refine exists_quadratic_relation_of_isUnit_discrim (s := φ (x 0)) (t := φ (x 1))
    (a := φ a) (b := φ b) (c := φ c) ?_ (by simpa using hφf)
    (by simpa [discrim, map_ofNat] using hd.map φ)
  rw [← map_maximalIdeal_of_surjective φ hφ, hm, Ideal.map_span, Set.image_pair]

end Hessian

section NonZeroDivisor

variable {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]

/-- If the maximal ideal `(x, y)` of a Noetherian local ring satisfies `a x² + b x y + y² = 0`,
then `x` is a nonzerodivisor as soon as `𝔪` is not an associated prime, that is, as soon as `A`
has positive depth: an associated prime containing `x` contains `y² = -(a x + b y) x`, hence `y`,
hence `𝔪`. -/
theorem mem_nonZeroDivisors_of_maximalIdeal_notMem_associatedPrimes {x y a b : A}
    (hm : maximalIdeal A = Ideal.span {x, y}) (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
    (h : maximalIdeal A ∉ associatedPrimes A A) : x ∈ nonZeroDivisors A := by
  by_contra hx
  have hx' : x ∈ ⋃ p ∈ associatedPrimes A A, (p : Set A) := by
    rw [biUnion_associatedPrimes_eq_compl_nonZeroDivisors]
    exact hx
  obtain ⟨p, hp, hxp⟩ : ∃ p ∈ associatedPrimes A A, x ∈ p := by simpa using hx'
  have := hp.isPrime
  have hyp : y ∈ p := this.mem_of_pow_mem 2 <| by
    rw [show y ^ 2 = -((a * x + b * y) * x) by linear_combination hrel]
    exact neg_mem (Ideal.mul_mem_left _ _ hxp)
  refine h ((le_maximalIdeal this.ne_top).antisymm ?_ ▸ hp)
  rw [hm, Ideal.span_le]
  rintro _ (rfl | rfl)
  exacts [hxp, hyp]

end NonZeroDivisor

section Node

variable {K Q A ι σ : Type*} [Field K] [CommRing Q] [Algebra K Q] [IsLocalRing Q]
  [Algebra.EssFiniteType K Q] [Algebra.FormallySmooth K Q] [CommRing A] [Algebra K A]
  [IsLocalRing A] [Algebra.EssFiniteType K A] [Fintype ι] [Fintype σ]
  [Algebra.FormallyUnramified K (A ⧸ fittingIdeal A Ω[A⁄K] 1)]

/-- **The quadratic relation at a node.** In the setting of
`TauCeti.exists_hypersurface_presentation_of_formallyUnramified`, the local ring at a node of a
curve over a field: `A` is a quotient of a formally smooth local `K`-algebra `Q` with `|ι|`
coordinates by `|ι| - 1` relations, `A ⧸ Fitt₁(Ω[A⁄K])` is unramified over `K`, and
`Fitt₁(Ω[A⁄K])` is proper. Then the maximal ideal of `A` is `(x, y)` with
`a x² + b x y + y² = 0` and `b² - 4a` a unit. -/
theorem exists_quadratic_relation_of_formallyUnramified (bQ : Module.Basis ι Q Ω[Q⁄K])
    (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) :
    ∃ x y a b : A, maximalIdeal A = Ideal.span {x, y} ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1) := by
  obtain ⟨s₀, _, y, b', -, hm, hb', hf, hdet, φ, -⟩ :=
    exists_hypersurface_presentation_of_formallyUnramified bQ π hπ hg hσ hsing
  let ψ := φ.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {Ideal.Quotient.mk _ (g s₀)}))
  have hψ : Function.Surjective ψ := φ.surjective.comp Ideal.Quotient.mk_surjective
  have hψf : ψ (Ideal.Quotient.mk _ (g s₀)) = 0 := by
    simp [ψ]
  refine exists_quadratic_relation_of_isUnit_det_hessian (x := Ideal.Quotient.mk _ ∘ y)
    (D := fun i ↦ (b'.coord i).compDer (D K _)) hm (fun i j ↦ ?_) hf hdet ψ hψ hψf
  simp [← hb', Finsupp.single_apply, eq_comm]

/-- **One blowup normalizes a node of a curve over a field.** In the setting of
`TauCeti.exists_quadratic_relation_of_formallyUnramified`, the maximal ideal of the local ring `A`
at a node is `(x, y)`, and the blowup chart `A[𝔪/x]` is finite over `A`, is the integral closure
of `A` in `A_x`, and has regular localizations at its maximal ideals, which are discrete valuation
rings by `TauCeti.isDiscreteValuationRing_localization_affineBlowup`. -/
theorem exists_integralClosure_eq_affineBlowup_of_formallyUnramified
    (bQ : Module.Basis ι Q Ω[Q⁄K]) (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧
      Module.Finite A ((maximalIdeal A).affineBlowup x (Localization.Away x)) ∧
      integralClosure A (Localization.Away x) =
        (maximalIdeal A).affineBlowup x (Localization.Away x) ∧
      ∀ (𝔫 : Ideal ((maximalIdeal A).affineBlowup x (Localization.Away x))) [𝔫.IsMaximal],
        IsRegularLocalRing (Localization.AtPrime 𝔫) := by
  obtain ⟨x, y, a, b, hm, hrel, hd⟩ :=
    exists_quadratic_relation_of_formallyUnramified bQ π hπ hg hσ hsing
  have : IsNoetherianRing A := Algebra.EssFiniteType.isNoetherianRing K A
  exact ⟨x, y, hm, finite_affineBlowup (S := Localization.Away x) hm hrel,
    integralClosure_eq_affineBlowup hm hrel hd,
    fun 𝔫 _ ↦ isRegularLocalRing_localization_affineBlowup hm hrel hd 𝔫⟩

/-- **The conductor and cokernel of the normalization at a node.** In the setting of
`TauCeti.exists_integralClosure_eq_affineBlowup_of_formallyUnramified`, suppose moreover that `A`
is reduced and not a field, as at a node of a reduced curve. Then `x` is a nonzerodivisor, so `A_x`
is a ring of fractions of `A`, the conductor of the normalization `A[𝔪/x]` over `A` is `𝔪`, and
its cokernel `A[𝔪/x] / A` is the residue field `A / 𝔪`. -/
theorem exists_conductor_affineBlowup_eq_maximalIdeal_of_formallyUnramified [IsReduced A]
    (bQ : Module.Basis ι Q Ω[Q⁄K]) (π : Q →ₐ[K] A) (hπ : Function.Surjective π) {g : σ → Q}
    (hg : RingHom.ker π = Ideal.span (Set.range g)) (hσ : Fintype.card σ + 1 = Fintype.card ι)
    (hsing : fittingIdeal A Ω[A⁄K] 1 ≠ ⊤) (hdim : maximalIdeal A ∉ minimalPrimes A) :
    ∃ x y : A, maximalIdeal A = Ideal.span {x, y} ∧ x ∈ nonZeroDivisors A ∧
      integralClosure A (Localization.Away x) =
        (maximalIdeal A).affineBlowup x (Localization.Away x) ∧
      Algebra.conductor A ((maximalIdeal A).affineBlowup x (Localization.Away x)) =
        maximalIdeal A ∧
      Nonempty (((maximalIdeal A).affineBlowup x (Localization.Away x) ⧸
        (1 : Submodule A ((maximalIdeal A).affineBlowup x (Localization.Away x)))) ≃ₗ[A]
          A ⧸ maximalIdeal A) := by
  obtain ⟨x, y, a, b, hm, hrel, hd⟩ :=
    exists_quadratic_relation_of_formallyUnramified bQ π hπ hg hσ hsing
  have : IsNoetherianRing A := Algebra.EssFiniteType.isNoetherianRing K A
  have hx := mem_nonZeroDivisors_of_maximalIdeal_notMem_associatedPrimes hm hrel
    fun h ↦ hdim (IsAssociatedPrime.mem_minimalPrimes_of_isReduced h)
  have hprin : ¬ (maximalIdeal A).IsPrincipal := by
    rw [← finrank_cotangentSpace_le_one_iff, finrank_cotangentSpace_eq_two hsing]
    decide
  exact ⟨x, y, hm, hx, integralClosure_eq_affineBlowup hm hrel hd,
    conductor_affineBlowup_eq_maximalIdeal hm hrel hx hprin,
    ⟨affineBlowupQuotientEquiv hm hrel hx hprin⟩⟩

end Node

end TauCeti

namespace Algebra.Presentation

open TauCeti

variable {K S ι σ : Type*} [Field K] [CommRing S] [Algebra K S] [Algebra.EssFiniteType K S]
  [Fintype ι] [Fintype σ] [Algebra.FormallyUnramified K (S ⧸ fittingIdeal S Ω[S⁄K] 1)]

/-- **The quadratic relation at a node of a presented curve.** Let `S` be presented over a field
`K` by `c + 1` generators and `c` relations, with `S ⧸ Fitt₁(Ω[S⁄K])` unramified over `K`, and let
`q` be a prime of `S` containing `Fitt₁(Ω[S⁄K])`. Then the maximal ideal of `S_q` is `(x, y)` with
`a x² + b x y + y² = 0` and `b² - 4a` a unit. -/
theorem exists_quadratic_relation_of_formallyUnramified (P : Presentation K S ι σ)
    (hP : Fintype.card σ + 1 = Fintype.card ι) (q : Ideal S) [q.IsPrime]
    (hq : fittingIdeal S Ω[S⁄K] 1 ≤ q) :
    ∃ x y a b : Localization.AtPrime q, maximalIdeal _ = Ideal.span {x, y} ∧
      a * x ^ 2 + b * x * y + y ^ 2 = 0 ∧ IsUnit (discrim a b 1) := by
  obtain ⟨s₀, _, y, b', -, hm, hb', hf, hdet, φ, -⟩ :=
    P.exists_hypersurface_presentation_of_formallyUnramified hP q hq
      (Localization.AtPrime (q.comap (algebraMap P.Ring S)))
  let ψ := φ.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {(Ideal.Quotient.mk _
    (algebraMap P.Ring (Localization.AtPrime (q.comap (algebraMap P.Ring S))) (P.relation s₀)))}))
  have hψ : Function.Surjective ψ := φ.surjective.comp Ideal.Quotient.mk_surjective
  refine exists_quadratic_relation_of_isUnit_det_hessian (x := Ideal.Quotient.mk _ ∘ y)
    (D := fun i ↦ (b'.coord i).compDer (D K _)) hm
    (fun i j ↦ by simp [← hb', Finsupp.single_apply, eq_comm]) hf hdet ψ hψ ?_
  simp only [ψ, RingHom.comp_apply]
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]

end Algebra.Presentation
