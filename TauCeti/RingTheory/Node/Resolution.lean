/-!
# Resolving a node by one blowup

Let `A` be a local ring whose maximal ideal `𝔪 = (x, y)` satisfies a quadratic relation
`a x² + b x y + y² = 0`, with `x` a nonzerodivisor and `𝔪` not principal: the shape of the local
ring at a node of a curve, split or not. Let `B = A[𝔪/x]` be the affine blowup algebra of `𝔪` at
`x`, the ring of the blowup of `Spec A` at its closed point. It is `A + A w` for `w = y/x`
(`TauCeti.toSubmodule_affineBlowup_eq_span`), and `w` satisfies `w² + b w + a = 0`.

This file computes the local terms of the normalization exact sequence at such a node:

* the conductor of `B` over `A` is the maximal ideal `𝔪`;
* `A → B` is injective (`Ideal.algebraMap_affineBlowup_injective`), and its cokernel `B / A` is
  the residue field `κ = A / 𝔪`, generated by the class of `w`;
* the same cokernel is the cokernel of `A → B / 𝔪 B`, the functions on the exceptional fibre,
  by `TauCeti.Algebra.quotientOneEquivOfLE` applied to the conductor.

Thus `0 → A → B → κ → 0` is exact as a sequence of `A`-modules: the blowup at a node adds exactly
one dimension of functions, the slope `y/x`, and the local `δ`-invariant of the node is one. For
the split node over an integrally closed domain this is the branch sequence
`TauCeti.NodeAlgebra.branchModuleSequence`, whose last term is the base ring.

When `A` is Noetherian and the discriminant `b² - 4a` is a unit, one blowup resolves the node:
`𝔪 B = x B`, the fibre `B / x B` is étale over `κ` (`TauCeti.etale_tensor_affineBlowup`) and so
reduced, and every maximal ideal of `B` is minimal over `x`. Hence every localization of `B` at a
maximal ideal is a discrete valuation ring with uniformizer `x`, and `B` is the integral closure
of `A` in `A_x`. For a reduced one-dimensional `A`, as at a node of a curve, `A_x` is the total ring
of fractions of `A`, so `B` is the normalization of `A` and the sequence above is the local
normalization exact sequence at the node.

## Main results

* `TauCeti.maximalIdeal_le_conductor_affineBlowup`: every element of `𝔪` carries `A[𝔪/x]` into
  `A`.
* `TauCeti.conductor_affineBlowup_eq_maximalIdeal`: the conductor of `A[𝔪/x]` over `A` is `𝔪`.
* `TauCeti.affineBlowupQuotientEquiv`: the cokernel `A[𝔪/x] / A` is `A / 𝔪` as an `A`-module,
  and `TauCeti.affineBlowupQuotientEquiv_mk_divBy` identifies the class of `y/x` with `1`.
* `TauCeti.affineBlowupQuotientEquivFiber`: the same cokernel is that of `A` into the functions
  on the exceptional fibre `A[𝔪/x] / 𝔪 A[𝔪/x]`.
* `TauCeti.isRegularLocalRing_localization_affineBlowup` and
  `TauCeti.isDiscreteValuationRing_localization_affineBlowup`: for `A` Noetherian and `b² - 4a`
  a unit, the localizations of `A[𝔪/x]` at its maximal ideals are regular, indeed discrete
  valuation rings.
* `TauCeti.integralClosure_eq_affineBlowup`: under the same hypotheses, `A[𝔪/x]` is the integral
  closure of `A` in `A_x`.

## References

* [Stacks Project, Section 53.19, Tag 0C46](https://stacks.math.columbia.edu/tag/0C46): nodes of
  curves and their `δ`-invariant.
* J.-P. Serre, *Algebraic Groups and Class Fields*, Chapter IV, §1, for the conductor of the
  normalization of a singular curve.
-/

public section

noncomputable section

open IsLocalRing TensorProduct TauCeti.Localization

namespace TauCeti

variable {A : Type*} [CommRing A] [IsLocalRing A] {x y a b : A}
  {S : Type*} [CommRing S] [Algebra A S] [IsLocalization.Away x S]

section Conductor

variable (hm : maximalIdeal A = Ideal.span {x, y}) (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
include hm hrel

omit [IsLocalRing A] hm in
/-- In the localization at `x`, `y · (y/x) = -(a x + b y)`: the relation divided by `x`. -/
private theorem algebraMap_mul_divBy_eq :
    algebraMap A S y * divBy y x =
      -(algebraMap A S a * algebraMap A S x + algebraMap A S b * algebraMap A S y) := by
  linear_combination algebraMap A S x * divBy_sq_add_mul_add_eq_zero S hrel -
    (divBy y x + algebraMap A S b) * algebraMap_mul_divBy (S := S) y x

/-- **The maximal ideal conducts the blowup chart into the node.** If `𝔪 = (x, y)` with
`a x² + b x y + y² = 0`, every element of `𝔪` carries `A[𝔪/x]` into `A`: `x · (y/x) = y` and
`y · (y/x) = -(a x + b y)`. -/
theorem maximalIdeal_le_conductor_affineBlowup :
    maximalIdeal A ≤ Algebra.conductor A ((maximalIdeal A).affineBlowup x S) := by
  intro m hmem
  rw [hm, Ideal.mem_span_pair] at hmem
  obtain ⟨r, s, rfl⟩ := hmem
  refine Algebra.mem_conductor_iff.mpr fun u ↦ ?_
  have hu : (u : S) ∈ Subalgebra.toSubmodule ((maximalIdeal A).affineBlowup x S) := u.2
  rw [toSubmodule_affineBlowup_eq_span hm hrel, Submodule.mem_span_pair] at hu
  obtain ⟨p, q, hpq⟩ := hu
  refine ⟨(r * x + s * y) * p + r * q * y - s * q * (a * x + b * y), Subtype.ext ?_⟩
  rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap, ← hpq]
  simp only [Algebra.smul_def, mul_one, map_add, map_sub, map_mul]
  linear_combination -(algebraMap A S r * algebraMap A S q) * algebraMap_mul_divBy (S := S) y x -
    algebraMap A S s * algebraMap A S q * algebraMap_mul_divBy_eq (S := S) hrel

omit hrel in
/-- The fraction `y/x` does not come from `A`: otherwise `y = x r` and `𝔪 = (x)` would be
principal. -/
private theorem not_exists_algebraMap_eq_divBy (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    ¬ ∃ r : A, algebraMap A S r = divBy y x := by
  rintro ⟨r, hr⟩
  have hyx : y = x * r := IsLocalization.injective S (Submonoid.powers_le.mpr hx) <| by
    rw [map_mul, hr, algebraMap_mul_divBy]
  refine hprin ⟨x, ?_⟩
  rw [hm, Set.pair_comm]
  exact Submodule.span_insert_eq_span (Ideal.mem_span_singleton'.mpr ⟨r, by rw [hyx, mul_comm]⟩)

omit hrel in
/-- The fraction `y/x` as an element of the blowup chart `A[𝔪/x]`. -/
private def divByMem : (maximalIdeal A).affineBlowup x S :=
  ⟨divBy y x, Ideal.divBy_mem_affineBlowup (hm ▸ Ideal.subset_span (Set.mem_insert_of_mem x rfl))⟩

omit hrel in
/-- The class of `y/x` in `A[𝔪/x] / A` is not zero. -/
private theorem divByMem_notMem_one (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    divByMem (S := S) hm ∉ (1 : Submodule A ((maximalIdeal A).affineBlowup x S)) := by
  rw [Submodule.mem_one]
  rintro ⟨r, hr⟩
  exact not_exists_algebraMap_eq_divBy hm hx hprin
    ⟨r, by simpa [divByMem] using congr_arg Subtype.val hr⟩

/-- **The conductor of the blowup chart at a node.** Let `𝔪 = (x, y)` be generated by a
nonzerodivisor `x` and an element `y` with `a x² + b x y + y² = 0`, and suppose that `𝔪` is not
principal. Then the conductor of `A[𝔪/x]` over `A` is the maximal ideal `𝔪`. -/
theorem conductor_affineBlowup_eq_maximalIdeal (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    Algebra.conductor A ((maximalIdeal A).affineBlowup x S) = maximalIdeal A := by
  refine le_antisymm (le_maximalIdeal fun htop ↦ ?_)
    (maximalIdeal_le_conductor_affineBlowup hm hrel)
  obtain ⟨r, hr⟩ := Algebra.conductor_eq_top_iff.mp htop (divByMem (S := S) hm)
  exact divByMem_notMem_one hm hx hprin (Submodule.mem_one.mpr ⟨r, hr⟩)

omit hrel in
/-- Multiplying the class of `y/x` in `A[𝔪/x] / A` by elements of `A`. -/
private abbrev divByMemSpan : A →ₗ[A]
    (maximalIdeal A).affineBlowup x S ⧸ (1 : Submodule A ((maximalIdeal A).affineBlowup x S)) :=
  LinearMap.toSpanSingleton A _ (Submodule.Quotient.mk (divByMem (S := S) hm))

private theorem divByMemSpan_surjective : Function.Surjective (divByMemSpan (S := S) hm) := by
  intro z
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  have hu : (u : S) ∈ Subalgebra.toSubmodule ((maximalIdeal A).affineBlowup x S) := u.2
  rw [toSubmodule_affineBlowup_eq_span hm hrel, Submodule.mem_span_pair] at hu
  obtain ⟨p, q, hpq⟩ := hu
  have hu' : u = algebraMap A _ p + q • divByMem (S := S) hm :=
    Subtype.ext (by simpa [divByMem, Algebra.smul_def] using hpq.symm)
  refine ⟨q, ?_⟩
  rw [hu', Submodule.Quotient.mk_add,
    (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_one.mpr ⟨p, rfl⟩), zero_add,
    Submodule.Quotient.mk_smul]
  simp

private theorem ker_divByMemSpan (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    LinearMap.ker (divByMemSpan (S := S) hm) = maximalIdeal A := by
  refine le_antisymm (le_maximalIdeal fun htop ↦ ?_) fun r hr ↦ ?_
  · have h1 : (1 : A) ∈ LinearMap.ker (divByMemSpan (S := S) hm) := htop ▸ Submodule.mem_top
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, one_smul,
      Submodule.Quotient.mk_eq_zero] at h1
    exact divByMem_notMem_one hm hx hprin h1
  · obtain ⟨c, hc⟩ := Algebra.mem_conductor_iff.mp
      (maximalIdeal_le_conductor_affineBlowup (S := S) hm hrel hr) (divByMem hm)
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, ← Submodule.Quotient.mk_smul,
      Submodule.Quotient.mk_eq_zero]
    exact Submodule.mem_one.mpr ⟨c, by rw [hc, Algebra.smul_def]⟩

/-- **The cokernel of the blowup chart at a node is the residue field.** Let `𝔪 = (x, y)` be
generated by a nonzerodivisor `x` and an element `y` with `a x² + b x y + y² = 0`, and suppose that
`𝔪` is not principal. Then the quotient `A[𝔪/x] / A` of the blowup chart by the image of `A` is
`A / 𝔪` as an `A`-module, the class of `y/x` corresponding to `1`
(`TauCeti.affineBlowupQuotientEquiv_mk_divBy`). -/
def affineBlowupQuotientEquiv (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    ((maximalIdeal A).affineBlowup x S ⧸ (1 : Submodule A ((maximalIdeal A).affineBlowup x S)))
      ≃ₗ[A] A ⧸ maximalIdeal A :=
  (LinearMap.quotKerEquivOfSurjective _ (divByMemSpan_surjective (S := S) hm hrel)).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (ker_divByMemSpan hm hrel hx hprin)

/-- The identification `TauCeti.affineBlowupQuotientEquiv` sends the class of `y/x` to `1`. -/
@[simp]
theorem affineBlowupQuotientEquiv_mk_divBy (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    affineBlowupQuotientEquiv (S := S) hm hrel hx hprin
        (Submodule.Quotient.mk ⟨divBy y x,
          Ideal.divBy_mem_affineBlowup (hm ▸ Ideal.subset_span (Set.mem_insert_of_mem x rfl))⟩) =
      Submodule.Quotient.mk 1 := by
  have h : divByMemSpan (S := S) hm 1 =
      Submodule.Quotient.mk ⟨divBy y x,
        Ideal.divBy_mem_affineBlowup (hm ▸ Ideal.subset_span (Set.mem_insert_of_mem x rfl))⟩ := by
    simp [divByMem]
  rw [← h, affineBlowupQuotientEquiv, LinearEquiv.trans_apply,
    LinearMap.quotKerEquivOfSurjective_symm_apply, Submodule.quotEquivOfEq_mk]

/-- **The cokernel of the blowup chart through its exceptional fibre.** Under the hypotheses of
`TauCeti.conductor_affineBlowup_eq_maximalIdeal`, the ideal `𝔪 A[𝔪/x]` is the extension of the
conductor, so the cokernel `A[𝔪/x] / A` is the cokernel of `A → A[𝔪/x] / 𝔪 A[𝔪/x]`: the functions
on the exceptional fibre modulo the constants at the node. This is the local form of the
normalization sequence with its last term supported on the preimage of the singular point. -/
def affineBlowupQuotientEquivFiber (hx : x ∈ nonZeroDivisors A)
    (hprin : ¬ (maximalIdeal A).IsPrincipal) :
    ((maximalIdeal A).affineBlowup x S ⧸ (1 : Submodule A ((maximalIdeal A).affineBlowup x S)))
      ≃ₗ[A] ((maximalIdeal A).affineBlowup x S ⧸
          (maximalIdeal A).map (algebraMap A ((maximalIdeal A).affineBlowup x S))) ⧸
        (1 : Submodule A ((maximalIdeal A).affineBlowup x S ⧸
          (maximalIdeal A).map (algebraMap A ((maximalIdeal A).affineBlowup x S)))) :=
  Algebra.quotientOneEquivOfLE _ <| by
    have h := Algebra.map_conductor_le_one (A := A) (B := (maximalIdeal A).affineBlowup x S)
    rwa [conductor_affineBlowup_eq_maximalIdeal (S := S) hm hrel hx hprin] at h

end Conductor

section Regular

variable [IsNoetherianRing A] (hm : maximalIdeal A = Ideal.span {x, y})
  (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
include hm hrel

omit [IsNoetherianRing A] hrel in
/-- In the blowup chart the extension of `𝔪 = (x, y)` is principal, generated by `x`. -/
private theorem span_algebraMap_eq_map_maximalIdeal :
    Ideal.span {algebraMap A ((maximalIdeal A).affineBlowup x S) x} =
      (maximalIdeal A).map (algebraMap A ((maximalIdeal A).affineBlowup x S)) := by
  have h : (maximalIdeal A).map (algebraMap A ((maximalIdeal A).affineBlowup x S)) =
      Ideal.span (algebraMap A ((maximalIdeal A).affineBlowup x S) '' {x, y}) := by
    rw [← Ideal.map_span, ← hm]
  rw [h, Set.image_pair, Set.pair_comm]
  refine (Submodule.span_insert_eq_span (Ideal.mem_span_singleton'.mpr
    ⟨divByMem (S := S) hm, Subtype.ext ?_⟩)).symm
  simp [divByMem]

omit [IsNoetherianRing A] in
/-- If `b² - 4a` is a unit, the chart modulo `x` is reduced: it is the exceptional fibre
`κ ⊗[A] A[𝔪/x]`, which is étale over `κ`. -/
private theorem isReduced_quotient_span_algebraMap (hd : IsUnit (discrim a b 1)) :
    IsReduced (((maximalIdeal A).affineBlowup x S) ⧸
      Ideal.span {algebraMap A ((maximalIdeal A).affineBlowup x S) x}) := by
  have := etale_tensor_affineBlowup (S := S) hm hrel hd
  have := Algebra.FormallyUnramified.isReduced_of_field (ResidueField A)
    (ResidueField A ⊗[A] (maximalIdeal A).affineBlowup x S)
  rw [span_algebraMap_eq_map_maximalIdeal hm]
  -- The residue field is the quotient `A ⧸ 𝔪`, so this is the fibre in Mathlib's form.
  have : IsReduced ((A ⧸ maximalIdeal A) ⊗[A] (maximalIdeal A).affineBlowup x S) := this
  exact isReduced_of_injective
    (Algebra.TensorProduct.quotIdealMapEquivQuotTensor _ (maximalIdeal A)).toRingHom
    (AlgEquiv.injective _)

omit [IsNoetherianRing A] in
/-- Every maximal ideal of the chart is minimal over `x`: the primes containing `x` lie over `𝔪`,
so they are maximal since the chart is finite over `A`. -/
private theorem mem_minimalPrimes_span_algebraMap
    (𝔫 : Ideal ((maximalIdeal A).affineBlowup x S)) [𝔫.IsMaximal] :
    𝔫 ∈ (Ideal.span {algebraMap A ((maximalIdeal A).affineBlowup x S) x}).minimalPrimes := by
  have := finite_affineBlowup (S := S) hm hrel
  have hmax (𝔮 : Ideal ((maximalIdeal A).affineBlowup x S)) [𝔮.IsPrime]
      (h𝔮 : Ideal.span {algebraMap A ((maximalIdeal A).affineBlowup x S) x} ≤ 𝔮) :
      𝔮.IsMaximal := by
    refine Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _
      (Algebra.IsIntegral.isIntegral (R := A)) 𝔮 ?_
    rw [span_algebraMap_eq_map_maximalIdeal hm, Ideal.map_le_iff_le_comap] at h𝔮
    rw [← (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le (Ideal.IsPrime.ne_top inferInstance) h𝔮]
    infer_instance
  refine ⟨⟨inferInstance, ?_⟩, fun 𝔮 ⟨_, h𝔮⟩ h𝔮𝔫 ↦ ?_⟩
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    have h := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _
      (Algebra.IsIntegral.isIntegral (R := A)) 𝔫
    exact (IsLocalRing.eq_maximalIdeal h).ge (hm ▸ Ideal.subset_span (Set.mem_insert x _))
  · exact ((hmax 𝔮 h𝔮).eq_of_le (Ideal.IsPrime.ne_top inferInstance) h𝔮𝔫).ge

/-- **The blowup of a node is regular.** Let `A` be a Noetherian local ring whose maximal ideal
`𝔪 = (x, y)` satisfies `a x² + b x y + y² = 0` with `b² - 4a` a unit, as at a node of a curve.
Then every localization of the blowup chart `A[𝔪/x]` at a maximal ideal is a regular local ring,
with maximal ideal generated by `x`. Indeed `𝔪 A[𝔪/x] = (x)`, the fibre `A[𝔪/x] / (x)` is étale
over the residue field and hence reduced, and every maximal ideal of the finite `A`-algebra
`A[𝔪/x]` lies over `𝔪` and is therefore minimal over `(x)`. -/
theorem isRegularLocalRing_localization_affineBlowup (hd : IsUnit (discrim a b 1))
    (𝔫 : Ideal ((maximalIdeal A).affineBlowup x S)) [𝔫.IsMaximal] :
    IsRegularLocalRing (Localization.AtPrime 𝔫) := by
  have := finite_affineBlowup (S := S) hm hrel
  have := IsNoetherianRing.of_finite A ((maximalIdeal A).affineBlowup x S)
  have := isReduced_quotient_span_algebraMap (S := S) hm hrel hd
  have hx := (Ideal.isRegular_algebraMap_affineBlowup (I := maximalIdeal A) (a := x)
    (S := S)).mem_nonZeroDivisors
  exact isRegularLocalRing_of_mem_minimalPrimes _
    hx
    (mem_minimalPrimes_span_algebraMap (S := S) hm hrel 𝔫)

/-- **The local rings of the blowup of a node are discrete valuation rings.** Under the
hypotheses of `TauCeti.isRegularLocalRing_localization_affineBlowup`, every localization of
`A[𝔪/x]` at a maximal ideal is a discrete valuation ring, with uniformizer `x`. -/
theorem isDiscreteValuationRing_localization_affineBlowup (hd : IsUnit (discrim a b 1))
    (𝔫 : Ideal ((maximalIdeal A).affineBlowup x S)) [𝔫.IsMaximal] :
    haveI := isRegularLocalRing_localization_affineBlowup hm hrel hd 𝔫
    IsDiscreteValuationRing (Localization.AtPrime 𝔫) := by
  have := isRegularLocalRing_localization_affineBlowup (S := S) hm hrel hd 𝔫
  have := finite_affineBlowup (S := S) hm hrel
  have := IsNoetherianRing.of_finite A ((maximalIdeal A).affineBlowup x S)
  have := isReduced_quotient_span_algebraMap (S := S) hm hrel hd
  have hx := (Ideal.isRegular_algebraMap_affineBlowup (I := maximalIdeal A) (a := x)
    (S := S)).mem_nonZeroDivisors
  exact isDiscreteValuationRing_of_mem_minimalPrimes _
    hx
    (mem_minimalPrimes_span_algebraMap (S := S) hm hrel 𝔫)

end Regular

section Normalization

variable [IsNoetherianRing A] (hm : maximalIdeal A = Ideal.span {x, y})
  (hrel : a * x ^ 2 + b * x * y + y ^ 2 = 0)
include hm hrel

/-- The local step of `TauCeti.integralClosure_eq_affineBlowup`: an element of `A_x` integral over
`A` is carried into `A[𝔪/x]` by some element outside a given maximal ideal `𝔫` of `A[𝔪/x]`. Its
image in the fraction field of the discrete valuation ring `A[𝔪/x]_𝔫` is integral, so lies in
`A[𝔪/x]_𝔫`. -/
private theorem exists_mul_mem_affineBlowup (hd : IsUnit (discrim a b 1))
    (𝔫 : Ideal ((maximalIdeal A).affineBlowup x S)) [𝔫.IsMaximal] {s : S} (hs : IsIntegral A s) :
    ∃ t ∉ 𝔫, (t : S) * s ∈ (maximalIdeal A).affineBlowup x S := by
  have := isRegularLocalRing_localization_affineBlowup (S := S) hm hrel hd 𝔫
  have := isDiscreteValuationRing_localization_affineBlowup (S := S) hm hrel hd 𝔫
  -- Map everything to the fraction field `K` of `R = A[𝔪/x]_𝔫`, where `x` becomes a unit.
  let ψ : (maximalIdeal A).affineBlowup x S →+* FractionRing (Localization.AtPrime 𝔫) :=
    (algebraMap _ _).comp (algebraMap _ (Localization.AtPrime 𝔫))
  have hψx : IsUnit (ψ.comp (algebraMap A _) x) := by
    have hx := (Ideal.isRegular_algebraMap_affineBlowup (I := maximalIdeal A) (a := x)
      (S := S)).mem_nonZeroDivisors
    have h := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
      (R := Localization.AtPrime 𝔫) (K := FractionRing (Localization.AtPrime 𝔫))
      (IsLocalization.nonZeroDivisors_le_comap 𝔫.primeCompl (Localization.AtPrime 𝔫) hx)
    exact isUnit_iff_ne_zero.mpr h
  let φ : S →+* FractionRing (Localization.AtPrime 𝔫) := IsLocalization.Away.lift x hψx
  have hφ (z : (maximalIdeal A).affineBlowup x S) : φ z = ψ z := by
    obtain ⟨⟨r, _, k, rfl⟩, hr⟩ := IsLocalization.surj (Submonoid.powers x) (z : S)
    have hzB : z * algebraMap A _ (x ^ k) = algebraMap A _ r := Subtype.ext (by simpa using hr)
    have hu : IsUnit (ψ (algebraMap A _ (x ^ k))) := by simpa [map_pow] using hψx.pow k
    have h1 := congr_arg φ hr
    have h2 := congr_arg ψ hzB
    simp only [map_mul, IsLocalization.Away.lift_eq, RingHom.comp_apply, φ] at h1
    rw [map_mul] at h2
    exact hu.mul_left_inj.mp (h1.trans h2.symm)
  -- The image of `s` is integral over `R`, hence lies in `R`.
  obtain ⟨p, hpm, hp⟩ := hs
  have hint : IsIntegral (Localization.AtPrime 𝔫) (φ s) := by
    refine ⟨p.map ((algebraMap _ (Localization.AtPrime 𝔫)).comp
      (algebraMap A ((maximalIdeal A).affineBlowup x S))), hpm.map _, ?_⟩
    have := congr_arg φ hp
    rw [Polynomial.hom_eval₂, map_zero] at this
    rw [Polynomial.eval₂_map, ← this]
    congr 1
    ext r
    simp [φ, ψ]
  obtain ⟨ρ, hρ⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  obtain ⟨⟨c, u⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔫.primeCompl ρ
  -- So `u s - c` vanishes in `K`; clearing `x` and a further element outside `𝔫` gives `t`.
  have h0 : φ ((u : S) * s - c) = 0 := by
    rw [map_sub, map_mul, hφ, hφ, ← hρ]
    simp only [ψ, RingHom.coe_comp, Function.comp_apply]
    rw [← map_mul, IsLocalization.mk'_spec', sub_self]
  obtain ⟨⟨r, _, k, rfl⟩, hr⟩ := IsLocalization.surj (Submonoid.powers x) ((u : S) * s - c)
  have hr' : ((u : S) * s - c) * algebraMap A S x ^ k = algebraMap A S r := by simpa using hr
  have hr0 : ψ (algebraMap A _ r) = 0 := by
    rw [← hφ]
    simpa [h0] using (congr_arg φ hr').symm
  have hinj : Function.Injective
      (algebraMap (Localization.AtPrime 𝔫) (FractionRing (Localization.AtPrime 𝔫))) :=
    IsLocalization.injective (FractionRing (Localization.AtPrime 𝔫)) le_rfl
  obtain ⟨v, hv⟩ := (IsLocalization.map_eq_zero_iff 𝔫.primeCompl (Localization.AtPrime 𝔫)
    (algebraMap A _ r)).mp ((map_eq_zero_iff _ hinj).mp hr0)
  refine ⟨v * u, (v * u).2, ?_⟩
  -- In `A_x`, `v x^k (u s - c) = 0` and `x` is a unit, so `v u s = v c`.
  have hvs : (v : S) * ((u : S) * s - c) = 0 := by
    have hvr := congr_arg Subtype.val hv
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ZeroMemClass.coe_zero] at hvr
    rw [← hr', ← mul_assoc] at hvr
    exact ((IsLocalization.Away.algebraMap_isUnit (S := S) x).pow k).mul_left_eq_zero.mp hvr
  have : (v : S) * (u : S) * s = v * c := by linear_combination hvs
  simpa [this] using mul_mem v.1.2 c.2

/-- **One blowup normalizes a node.** Let `A` be a Noetherian local ring whose maximal ideal
`𝔪 = (x, y)` satisfies `a x² + b x y + y² = 0` with `b² - 4a` a unit. Then the blowup chart
`A[𝔪/x]` is the integral closure of `A` in its localization `A_x`. When `A` is reduced of
dimension one, as at a node of a curve, `A_x` is the total ring of fractions of `A`, and
`A[𝔪/x]` is the normalization of `A`. -/
theorem integralClosure_eq_affineBlowup (hd : IsUnit (discrim a b 1)) :
    integralClosure A S = (maximalIdeal A).affineBlowup x S := by
  have := finite_affineBlowup (S := S) hm hrel
  refine le_antisymm (fun s hs ↦ ?_) fun z hz ↦
    (Algebra.IsIntegral.isIntegral (R := A) (⟨z, hz⟩ : (maximalIdeal A).affineBlowup x S)).map
      ((maximalIdeal A).affineBlowup x S).val
  -- The elements of `A[𝔪/x]` carrying `s` into `A[𝔪/x]` form an ideal, contained in no
  -- maximal ideal by `exists_mul_mem_affineBlowup`.
  let J : Ideal ((maximalIdeal A).affineBlowup x S) :=
    { carrier := {t | (t : S) * s ∈ (maximalIdeal A).affineBlowup x S}
      add_mem' := fun ha hb ↦ by simpa [add_mul] using add_mem ha hb
      zero_mem' := by simp
      smul_mem' := fun c t ht ↦ by simpa [mul_assoc] using mul_mem c.2 ht }
  by_contra hns
  obtain ⟨𝔫, h𝔫, hJ𝔫⟩ := J.exists_le_maximal fun h ↦ hns <| by
    simpa [J] using (h ▸ Submodule.mem_top : (1 : (maximalIdeal A).affineBlowup x S) ∈ J)
  obtain ⟨t, ht, hts⟩ := exists_mul_mem_affineBlowup (S := S) hm hrel hd 𝔫 hs
  exact ht (hJ𝔫 hts)

end Normalization

