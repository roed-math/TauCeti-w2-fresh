module

public import Mathlib.Algebra.Ring.Subring.Basic
public import Mathlib.RingTheory.Localization.Defs

/-!
# Subrings generated by fractions in a localization

Let `T` be the localization of a commutative ring `S` at a submonoid `M`, and let `B` be a subring
of `S` containing `M`. If every element of a set `G ⊆ T` becomes the image of an element of `B`
after multiplication by some element of `M`, then so does every element of the subring generated
by `G`. In particular an element `x` of `S` whose image lies in that subring has a multiple
`m * x`, `m ∈ M`, in `B`.

This is the algebraic step behind the locality of generation statements on the basic opens of an
affine scheme: a subring that is everything after inverting each element of a family generating
the unit ideal is everything.

## Main statements

* `TauCeti.IsLocalization.exists_mul_mem_of_mem_closure`: the multiple `m * x ∈ B` above.
-/

public section

namespace TauCeti.IsLocalization

variable {S T : Type*} [CommRing S] [CommRing T] [Algebra S T] {M : Submonoid S}
  {B : Subring S} {G : Set T}

/-- Every element of the subring generated by a set `G` of fractions with numerators in `B` is
again such a fraction, if `B` contains the denominators. -/
theorem exists_mul_eq_algebraMap_of_mem_closure (hM : M ≤ B.toSubmonoid)
    (hG : ∀ z ∈ G, ∃ m ∈ M, ∃ y ∈ B, algebraMap S T y = algebraMap S T m * z) {z : T}
    (hz : z ∈ Subring.closure G) :
    ∃ m ∈ M, ∃ y ∈ B, algebraMap S T y = algebraMap S T m * z := by
  induction hz using Subring.closure_induction with
  | mem z hz => exact hG z hz
  | zero => exact ⟨1, one_mem _, 0, zero_mem _, by rw [map_zero, mul_zero]⟩
  | one => exact ⟨1, one_mem _, 1, one_mem _, by rw [map_one, one_mul]⟩
  | neg z _ h =>
    obtain ⟨m, hm, y, hy, e⟩ := h
    exact ⟨m, hm, -y, neg_mem hy, by rw [map_neg, e, mul_neg]⟩
  | add z₁ z₂ _ _ h₁ h₂ =>
    obtain ⟨m₁, hm₁, y₁, hy₁, e₁⟩ := h₁
    obtain ⟨m₂, hm₂, y₂, hy₂, e₂⟩ := h₂
    refine ⟨m₁ * m₂, mul_mem hm₁ hm₂, m₂ * y₁ + m₁ * y₂,
      add_mem (mul_mem (hM hm₂) hy₁) (mul_mem (hM hm₁) hy₂), ?_⟩
    rw [map_add, map_mul, map_mul, e₁, e₂, map_mul]
    ring
  | mul z₁ z₂ _ _ h₁ h₂ =>
    obtain ⟨m₁, hm₁, y₁, hy₁, e₁⟩ := h₁
    obtain ⟨m₂, hm₂, y₂, hy₂, e₂⟩ := h₂
    refine ⟨m₁ * m₂, mul_mem hm₁ hm₂, y₁ * y₂, mul_mem hy₁ hy₂, ?_⟩
    rw [map_mul, e₁, e₂, map_mul]
    ring

/-- If a subring `B` of `S` contains the submonoid `M`, and every element of a set `G` of the
localization `T` becomes the image of an element of `B` after multiplication by an element of `M`,
then every `x ∈ S` whose image lies in the subring generated by `G` has a multiple `m * x ∈ B` with
`m ∈ M`. -/
theorem exists_mul_mem_of_mem_closure [IsLocalization M T] (hM : M ≤ B.toSubmonoid)
    (hG : ∀ z ∈ G, ∃ m ∈ M, ∃ y ∈ B, algebraMap S T y = algebraMap S T m * z) {x : S}
    (hx : algebraMap S T x ∈ Subring.closure G) : ∃ m ∈ M, m * x ∈ B := by
  obtain ⟨m, hm, y, hy, e⟩ := exists_mul_eq_algebraMap_of_mem_closure hM hG hx
  obtain ⟨c, hc⟩ := _root_.IsLocalization.exists_of_eq (M := M) (S := T) (x := y) (y := m * x)
    (e.trans (map_mul _ _ _).symm)
  refine ⟨c * m, mul_mem c.2 hm, ?_⟩
  rw [mul_assoc, ← hc]
  exact mul_mem (hM c.2) hy

end TauCeti.IsLocalization
