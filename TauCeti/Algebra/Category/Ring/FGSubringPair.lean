module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.CategoryTheory.Limits.Types.Filtered
public import Mathlib.RingTheory.Adjoin.FG

/-!
# Finitely generated subrings along a cofiltered system of rings

Let `F : Iᵒᵖ ⥤ CommRingCat` be a system of rings indexed by a cofiltered category `I`, and let
`s j ⊆ F j` be finite subsets. The pairs `(j, C)` of an index `j` and a finitely generated subring
`C ⊆ F j` containing `s j` form a cofiltered category `FGSubringPair F s`, with a morphism
`(j', C') ⟶ (j, C)` a morphism `j' ⟶ j` of `I` along which `F j ⟶ F j'` maps `C` into `C'`.
The subrings themselves form a functor `FGSubringPair.ring F s : (FGSubringPair F s)ᵒᵖ ⥤
CommRingCat`.

This is the index category of the extension step in the proof of Stacks, Proposition 32.5.4
(01ZA): there, `F j` is the fibre product `R ×_{Γ(V)} Γ(Vⱼ)` of the ring `R` of an affine open
`W = Spec R` and the global sections of the members `Vⱼ` of a cofiltered system of models of
`V = U ∩ W`, and `s j` makes `Vⱼ` an open of `Spec C`
(`TauCeti.AlgebraicGeometry.Scheme.exists_finset_isPullback_toSpecΓ_comp_SpecMap`).

## Main declarations

* `TauCeti.CommRingCat.FGSubringPair`: the category of pairs.
* `TauCeti.CommRingCat.FGSubringPair.isCofiltered`: it is cofiltered.
* `TauCeti.CommRingCat.FGSubringPair.ring`: the functor of subrings.
* `TauCeti.CommRingCat.FGSubringPair.isColimitCocone`: if a cocone on `F` is a colimit in the
  sense that every element of its point comes from some `F j` and every element of `F j` mapping
  to zero vanishes in some later `F j'`, then the induced cocone on the subrings is a colimit.
-/

@[expose] public section

universe u

open CategoryTheory Limits Opposite

namespace TauCeti.CommRingCat

variable {I : Type u} [Category.{u} I] (F : Iᵒᵖ ⥤ CommRingCat.{u})
  (s : ∀ j, Finset (F.obj (op j)))

/-- A pair of an index `j` and a finitely generated subring of `F j` containing `s j`. -/
structure FGSubringPair where
  /-- The index. -/
  idx : I
  /-- The finitely generated subring of `F idx`. -/
  sub : Subalgebra ℤ (F.obj (op idx))
  /-- The subring is finitely generated. -/
  fg : sub.FG
  /-- The subring contains `s idx`. -/
  subset : (s idx : Set (F.obj (op idx))) ⊆ sub

namespace FGSubringPair

variable {F s}

instance : Category (FGSubringPair F s) where
  Hom a b := { f : a.idx ⟶ b.idx // ∀ x ∈ b.sub, F.map f.op x ∈ a.sub }
  id a := ⟨𝟙 _, fun x hx ↦ by simpa using hx⟩
  comp f g := ⟨f.1 ≫ g.1, fun x hx ↦ by simpa using f.2 _ (g.2 x hx)⟩

@[ext]
lemma hom_ext {a b : FGSubringPair F s} {f g : a ⟶ b} (h : f.1 = g.1) : f = g :=
  Subtype.ext h

@[simp]
lemma id_val (a : FGSubringPair F s) : (𝟙 a : a ⟶ a).1 = 𝟙 a.idx := rfl

@[simp]
lemma comp_val {a b c : FGSubringPair F s} (f : a ⟶ b) (g : b ⟶ c) : (f ≫ g).1 = f.1 ≫ g.1 :=
  rfl

/-- The pair over `j` whose subring is generated by `s j` and the images of the subrings of two
pairs `a`, `b` along morphisms `j ⟶ a.idx` and `j ⟶ b.idx`. -/
def ofMaps {j : I} (a b : FGSubringPair F s) (f : j ⟶ a.idx) (g : j ⟶ b.idx) :
    FGSubringPair F s where
  idx := j
  sub := Algebra.adjoin ℤ (s j : Set (F.obj (op j))) ⊔
    (a.sub.map (F.map f.op).hom.toIntAlgHom ⊔ b.sub.map (F.map g.op).hom.toIntAlgHom)
  fg := (Subalgebra.fg_adjoin_finset _).sup ((a.fg.map _).sup (b.fg.map _))
  subset _ hx := (le_sup_left : Algebra.adjoin ℤ _ ≤ _) (Algebra.subset_adjoin hx)

/-- The morphism from `ofMaps a b f g` to `a`. -/
def ofMapsFst {j : I} (a b : FGSubringPair F s) (f : j ⟶ a.idx) (g : j ⟶ b.idx) :
    ofMaps a b f g ⟶ a :=
  ⟨f, fun x hx ↦ by
    change _ ∈ Algebra.adjoin ℤ (s j : Set (F.obj (op j))) ⊔
      (a.sub.map (F.map f.op).hom.toIntAlgHom ⊔ b.sub.map (F.map g.op).hom.toIntAlgHom)
    exact le_sup_right (a := Algebra.adjoin ℤ (s j : Set (F.obj (op j))))
      (le_sup_left (b := b.sub.map (F.map g.op).hom.toIntAlgHom) ⟨x, hx, rfl⟩)⟩

/-- The morphism from `ofMaps a b f g` to `b`. -/
def ofMapsSnd {j : I} (a b : FGSubringPair F s) (f : j ⟶ a.idx) (g : j ⟶ b.idx) :
    ofMaps a b f g ⟶ b :=
  ⟨g, fun x hx ↦ by
    change _ ∈ Algebra.adjoin ℤ (s j : Set (F.obj (op j))) ⊔
      (a.sub.map (F.map f.op).hom.toIntAlgHom ⊔ b.sub.map (F.map g.op).hom.toIntAlgHom)
    exact le_sup_right (a := Algebra.adjoin ℤ (s j : Set (F.obj (op j))))
      (le_sup_right (a := a.sub.map (F.map f.op).hom.toIntAlgHom) ⟨x, hx, rfl⟩)⟩

instance [IsCofilteredOrEmpty I] : IsCofilteredOrEmpty (FGSubringPair F s) where
  cone_objs a b := by
    obtain ⟨j, f, g, -⟩ := IsCofilteredOrEmpty.cone_objs a.idx b.idx
    exact ⟨ofMaps a b f g, ofMapsFst a b f g, ofMapsSnd a b f g, trivial⟩
  cone_maps a b f g := by
    obtain ⟨j, h, hh⟩ := IsCofilteredOrEmpty.cone_maps f.1 g.1
    exact ⟨ofMaps a a h h, ofMapsFst a a h h, hom_ext hh⟩

instance [Nonempty I] : Nonempty (FGSubringPair F s) := by
  obtain ⟨j⟩ := ‹Nonempty I›
  exact ⟨⟨j, Algebra.adjoin ℤ (s j : Set (F.obj (op j))), Subalgebra.fg_adjoin_finset _,
    Algebra.subset_adjoin⟩⟩

/-- The category of pairs over a cofiltered category is cofiltered. -/
instance isCofiltered [IsCofiltered I] : IsCofiltered (FGSubringPair F s) where
  nonempty := have : Nonempty I := IsCofiltered.nonempty; inferInstance

/-- The ring map `C ⟶ C'` along a morphism `(j', C') ⟶ (j, C)`, induced by `F j ⟶ F j'`. -/
def ringHom {a b : FGSubringPair F s} (f : a ⟶ b) :
    CommRingCat.of b.sub ⟶ CommRingCat.of a.sub :=
  CommRingCat.ofHom (((F.map f.1.op).hom.comp b.sub.val.toRingHom).codRestrict a.sub.toSubring
    fun x ↦ f.2 x x.2)

@[simp]
lemma ringHom_apply_coe {a b : FGSubringPair F s} (f : a ⟶ b) (x : b.sub) :
    (ringHom f x).1 = F.map f.1.op x.1 :=
  rfl

variable (F s) in
/-- The functor sending a pair `(j, C)` to the ring `C`. -/
def ring : (FGSubringPair F s)ᵒᵖ ⥤ CommRingCat.{u} where
  obj a := .of a.unop.sub
  map f := ringHom f.unop
  map_id a := by
    ext x
    change F.map (𝟙 a.unop.idx).op x.1 = x.1
    simp
  map_comp f g := by
    ext x
    change F.map (g.unop.1 ≫ f.unop.1).op x.1 = F.map g.unop.1.op (F.map f.unop.1.op x.1)
    simp

@[simp]
lemma ring_map {a b : (FGSubringPair F s)ᵒᵖ} (f : a ⟶ b) : (ring F s).map f = ringHom f.unop :=
  rfl

/-- The cocone on the subrings induced by a cocone on `F`. -/
@[simps pt]
def cocone (t : Cocone F) : Cocone (ring F s) where
  pt := t.pt
  ι.app a := CommRingCat.ofHom a.unop.sub.val.toRingHom ≫ t.ι.app (op a.unop.idx)
  ι.naturality {a b} f := by
    ext x
    change t.ι.app (op b.unop.idx) (F.map f.unop.1.op x.1) = t.ι.app (op a.unop.idx) x.1
    rw [← CategoryTheory.comp_apply, t.w]

@[simp]
lemma cocone_ι_app_apply (t : Cocone F) (a : (FGSubringPair F s)ᵒᵖ) (x : (ring F s).obj a) :
    (cocone (s := s) t).ι.app a x = t.ι.app (op a.unop.idx) x.1 :=
  rfl

/-- Let `t` be a cocone on a cofiltered system `F` of rings such that every element of `t.pt`
comes from some `F j`, and every element of some `F j` mapping to zero in `t.pt` vanishes in
some `F j'`. Then `t.pt` is the colimit of the finitely generated subrings `C ⊆ F j` containing
`s j`. -/
noncomputable def isColimitCocone [IsCofiltered I] (t : Cocone F)
    (hsurj : ∀ r : t.pt, ∃ (j : I) (y : F.obj (op j)), t.ι.app (op j) y = r)
    (hinj : ∀ (j : I) (y : F.obj (op j)), t.ι.app (op j) y = 0 →
      ∃ (j' : I) (f : j' ⟶ j), F.map f.op y = 0) :
    IsColimit (cocone (s := s) t) := by
  classical
  have : ReflectsColimitsOfShape (FGSubringPair F s)ᵒᵖ (forget CommRingCat.{u}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  refine isColimitOfReflects (forget _) (Types.FilteredColimit.isColimitOf' _
    ((forget CommRingCat.{u}).mapCocone (cocone t)) (fun r ↦ ?_) fun a x y h ↦ ?_)
  · obtain ⟨j, y, rfl⟩ := hsurj r
    refine ⟨op ⟨j, Algebra.adjoin ℤ ((insert y (s j) : Finset _) : Set (F.obj (op j))),
      Subalgebra.fg_adjoin_finset _, fun z hz ↦ Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_insert_of_mem hz))⟩,
      ⟨y, Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))⟩, rfl⟩
  · have h' : t.ι.app (op a.unop.idx) (x.1 - y.1) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact h
    obtain ⟨j', f, hf⟩ := hinj _ _ h'
    refine ⟨op (ofMaps a.unop a.unop f f), (ofMapsFst a.unop a.unop f f).op, ?_⟩
    apply Subtype.ext
    change F.map f.op x.1 = F.map f.op y.1
    rwa [← sub_eq_zero, ← map_sub]

end FGSubringPair

end TauCeti.CommRingCat
