module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# Surjectivity and integrality in pushout squares of commutative rings

In a pushout square of commutative rings with corner `P = B ⊗[A] C`, the ring `P` is generated by
the images of `B` and `C`. Hence the map `B → P` is surjective as soon as its image contains the
image of `C`, and integral as soon as the image of `C` is integral over `B`.

## Main declarations

* `TauCeti.CommRingCat.surjective_of_isPushout`: in a pushout square `B → P ← C`, if the image of
  `C → P` lies in the image of `B → P`, then `B → P` is surjective.
* `TauCeti.CommRingCat.isIntegral_of_isPushout`: in a pushout square `B → P ← C`, if the image of
  `C → P` is integral over `B`, then `B → P` is integral.
-/

public section

universe u

open CategoryTheory Limits TensorProduct

namespace TauCeti.CommRingCat

/-- In a pushout square of commutative rings `B → P ← C` over `A`, if the image of `C → P` lies in
the image of `B → P`, then `B → P` is surjective. -/
theorem surjective_of_isPushout {A B C P : CommRingCat.{u}} {f : A ⟶ B} {g : A ⟶ C}
    {inl : B ⟶ P} {inr : C ⟶ P} (h : IsPushout f g inl inr)
    (hle : Set.range inr ⊆ Set.range inl) : Function.Surjective inl := by
  algebraize [f.hom, g.hom, inl.hom, inr.hom, (f ≫ inl).hom]
  have : IsScalarTower A B P := .of_algebraMap_eq' rfl
  have : IsScalarTower A C P := .of_algebraMap_eq' (congr($(h.w).hom))
  have : Algebra.IsPushout A B C P := CommRingCat.isPushout_iff_isPushout.mp h
  intro x
  obtain ⟨t, rfl⟩ := (Algebra.IsPushout.equiv A B C P).surjective x
  induction t using TensorProduct.inductionOn with
  | tmul b c =>
    obtain ⟨b', hb'⟩ := hle ⟨c, rfl⟩
    exact ⟨b * b', by rw [Algebra.IsPushout.equiv_tmul, map_mul, hb']; rfl⟩
  | add t t' ht ht' =>
    obtain ⟨b, hb⟩ := ht
    obtain ⟨b', hb'⟩ := ht'
    exact ⟨b + b', by rw [map_add, map_add, hb, hb']⟩

/-- In a pushout square of commutative rings `B → P ← C` over `A`, if the image of `C → P` is
integral over `B`, then `B → P` is integral. -/
theorem isIntegral_of_isPushout {A B C P : CommRingCat.{u}} {f : A ⟶ B} {g : A ⟶ C}
    {inl : B ⟶ P} {inr : C ⟶ P} (h : IsPushout f g inl inr)
    (hint : ∀ c, inl.hom.IsIntegralElem (inr c)) : inl.hom.IsIntegral := by
  algebraize [f.hom, g.hom, inl.hom, inr.hom, (f ≫ inl).hom]
  have : IsScalarTower A B P := .of_algebraMap_eq' rfl
  have : IsScalarTower A C P := .of_algebraMap_eq' (congr($(h.w).hom))
  have : Algebra.IsPushout A B C P := CommRingCat.isPushout_iff_isPushout.mp h
  intro x
  obtain ⟨t, rfl⟩ := (Algebra.IsPushout.equiv A B C P).surjective x
  induction t using TensorProduct.inductionOn with
  | tmul b c =>
    rw [Algebra.IsPushout.equiv_tmul]
    exact inl.hom.isIntegralElem_map.mul _ (hint c)
  | add t t' ht ht' =>
    rw [map_add]
    exact ht.add _ ht'

end TauCeti.CommRingCat
