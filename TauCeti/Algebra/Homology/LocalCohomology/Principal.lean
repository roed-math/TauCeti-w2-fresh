/-!
# Local cohomology in degree one along a nonzerodivisor

Let `a` be a nonzerodivisor of a commutative ring `A` and `L` the localization of `A` away from
`a`. This file computes Mathlib's native `H¹_{(a)}(A) = colimₙ Ext¹(A ⧸ (a)ⁿ, A)` as `L ⧸ A`,
the algebraic counterpart of `H¹_{V(a)}(Spec A, 𝒪) ≅ A_a ⧸ A`
(`TauCeti.AlgebraicGeometry.Scheme.Modules.cohomologyWithSupportSpecOneEquiv`).

The long exact sequence of `0 → A →(aⁿ) A → A ⧸ (a)ⁿ → 0`, with `Ext¹(A, A) = 0`, shows that
`Ext¹(A ⧸ (a)ⁿ, A)` is `A ⧸ (a)ⁿ`, generated by the class `eₙ` of that extension, and the
naturality of extension classes shows that the transition map sends `eₙ` to `aᵐ⁻ⁿ • eₘ`. So
`r • eₙ ↦ r / aⁿ` is a compatible family of maps to `L ⧸ A`, and it identifies the colimit with
`L ⧸ A`: every element of `L` is some `r / aⁿ`, and `r / aⁿ ∈ A` exactly when `r ∈ (aⁿ)`, since
`a` is a nonzerodivisor. The derived-category computation is transported to the derived-functor
`Ext` that `localCohomology` is built on by `TauCeti.extSuccLinearEquiv`.

## Main definitions

* `TauCeti.Supports.powExtClass ha n`: the class `eₙ ∈ Ext¹(A ⧸ (a)ⁿ, A)`.
* `TauCeti.Supports.derivedExtOneLinearEquiv ha n`: `A ⧸ (a)ⁿ ≃ₗ[A] Ext¹(A ⧸ (a)ⁿ, A)`.
* `TauCeti.Supports.localCohomologyOneLinearEquiv ha L`: `H¹_{(a)}(A) ≃ₗ[A] L ⧸ A`.

## Main results

* `TauCeti.Supports.smul_powExtClass_eq_zero_iff`: `r • eₙ = 0 ↔ r ∈ (a)ⁿ`.
* `TauCeti.Supports.mk₀_mapQ_comp_powExtClass`: the transition maps send `eₙ` to `aᵐ⁻ⁿ • eₘ`.

## References

* [Stacks, Tag 0952](https://stacks.math.columbia.edu/tag/0952), local cohomology as the
  colimit of `Ext(A ⧸ Iⁿ, M)`.
* Markus P. Brodmann and Rodney Y. Sharp, *Local Cohomology*, Cambridge Studies in Advanced
  Mathematics 136, Cambridge University Press (2013), Chapter 2, for `H¹_{(a)}(A) ≅ A_a ⧸ A`.
-/

public section

universe u

open CategoryTheory CategoryTheory.Abelian Limits Opposite

namespace TauCeti.Supports

variable {A : Type u} [CommRing A]

/-- The short complex `A → A → A ⧸ (a)ⁿ` whose first map is multiplication by `aⁿ`. -/
noncomputable abbrev powShortComplex (a : A) (n : ℕ) : ShortComplex (ModuleCat.{u} A) :=
  ModuleCat.shortComplexOfCompEqZero (LinearMap.lsmul A A (a ^ n)) (Ideal.span {a} ^ n).mkQ (by
    ext
    simp only [LinearMap.comp_apply, LinearMap.lsmul_apply, Submodule.mkQ_apply,
      LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self a) n))

/-- Membership in a power of a principal ideal: `x ∈ (a)ⁿ` iff `x` is a multiple of `aⁿ`. -/
theorem mem_span_singleton_pow_iff (a x : A) (n : ℕ) :
    x ∈ Ideal.span {a} ^ n ↔ ∃ y, a ^ n • y = x := by
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  exact exists_congr fun y => by rw [smul_eq_mul, mul_comm]

/-- For a nonzerodivisor `a`, the sequence `0 → A →(aⁿ) A → A ⧸ (a)ⁿ → 0` is exact. -/
theorem shortExact_powShortComplex {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) :
    (powShortComplex a n).ShortExact := by
  refine ModuleCat.shortComplex_shortExact _ (fun x => ?_) (fun x y h => ?_)
    (Submodule.mkQ_surjective _)
  · -- `Function.Exact` of the underlying linear maps, which are `aⁿ • -` and `mkQ`
    change (Ideal.span {a} ^ n).mkQ x = 0 ↔ _
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, mem_span_singleton_pow_iff]
    rfl
  · have hn : a ^ n ∈ nonZeroDivisors A := pow_mem ha n
    -- injectivity of the underlying linear map `aⁿ • -`
    change a ^ n • x = a ^ n • y at h
    simp only [smul_eq_mul] at h
    exact (mul_cancel_left_mem_nonZeroDivisors hn).1 h

/-- The class `eₙ ∈ Ext¹(A ⧸ (a)ⁿ, A)` of the extension `0 → A →(aⁿ) A → A ⧸ (a)ⁿ → 0`. -/
noncomputable abbrev powExtClass {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) :
    Ext (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)) (ModuleCat.of A A) 1 :=
  (shortExact_powShortComplex ha n).extClass

/-- Composing an `Ext` class into `A` with multiplication by `r` on `A` is the scalar action of
`r`. -/
theorem comp_mk₀_lsmul {X : ModuleCat.{u} A} {n : ℕ} (e : Ext X (ModuleCat.of A A) n) (r : A) :
    e.comp (Ext.mk₀ (ModuleCat.ofHom (LinearMap.lsmul A A r))) (add_zero n) = r • e := by
  have h : ModuleCat.ofHom (LinearMap.lsmul A A r) = r • 𝟙 (ModuleCat.of A A) :=
    ModuleCat.lsmul_eq_smul_id (ModuleCat.of A A) r
  rw [h, Ext.mk₀_smul, Ext.comp_smul, Ext.comp_mk₀_id]

/-- Every element of `Ext¹(A ⧸ (a)ⁿ, A)` is a multiple of the class `eₙ`: the next term
`Ext¹(A, A)` of the long exact sequence vanishes, and `Ext⁰(A, A) = Hom(A, A)` is `A`. -/
theorem exists_eq_smul_powExtClass {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ)
    (x : Ext (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)) (ModuleCat.of A A) 1) :
    ∃ r : A, r • powExtClass ha n = x := by
  obtain ⟨y, rfl⟩ := Ext.contravariant_sequence_exact₃ (shortExact_powShortComplex ha n) _ x
    (Ext.eq_zero_of_projective _) (add_zero 1)
  obtain ⟨φ, rfl⟩ := (Ext.mk₀_bijective _ _).2 y
  refine ⟨φ.hom 1, ?_⟩
  have hφ : φ = ModuleCat.ofHom (LinearMap.lsmul A A (φ.hom 1)) := by
    exact ModuleCat.hom_ext (LinearMap.ext_ring (by simp))
  generalize φ.hom 1 = r at hφ ⊢
  rw [hφ, comp_mk₀_lsmul]

/-- A multiple `r • eₙ` of the class of `0 → A →(aⁿ) A → A ⧸ (a)ⁿ → 0` vanishes exactly when
`r ∈ (a)ⁿ`: the kernel of the connecting map `Hom(A, A) → Ext¹(A ⧸ (a)ⁿ, A)` is the image of
precomposition with `aⁿ`. -/
theorem smul_powExtClass_eq_zero_iff {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) (r : A) :
    r • powExtClass ha n = 0 ↔ r ∈ Ideal.span {a} ^ n := by
  have hS := shortExact_powShortComplex ha n
  rw [mem_span_singleton_pow_iff]
  constructor
  · intro h
    rw [← comp_mk₀_lsmul] at h
    obtain ⟨z, hz⟩ := Ext.contravariant_sequence_exact₁ hS _ _ (add_zero 1) h
    obtain ⟨ψ, rfl⟩ := (Ext.mk₀_bijective _ _).2 z
    rw [Ext.mk₀_comp_mk₀] at hz
    have := congrArg (fun φ => φ.hom 1) ((Ext.mk₀_bijective _ _).1 hz)
    refine ⟨ψ.hom 1, ?_⟩
    have h₁ : ψ.hom (a ^ n) = r := by simpa using this
    rw [← h₁, ← map_smul, smul_eq_mul, mul_one]
  · rintro ⟨y, rfl⟩
    rw [smul_eq_mul, mul_comm, mul_smul, ← comp_mk₀_lsmul (powExtClass ha n) (a ^ n)]
    -- the first map of `powShortComplex a n` is multiplication by `aⁿ`
    change y • hS.extClass.comp (Ext.mk₀ (powShortComplex a n).f) (add_zero 1) = 0
    rw [hS.extClass_comp, smul_zero]

/-- The transition map `Ext¹(A ⧸ (a)ⁿ, A) → Ext¹(A ⧸ (a)ᵐ, A)` induced by the projection, for
`n ≤ m`, sends `eₙ` to `aᵐ⁻ⁿ • eₘ`. -/
theorem mk₀_mapQ_comp_powExtClass {a : A} (ha : a ∈ nonZeroDivisors A) {n m : ℕ} (hnm : n ≤ m)
    (h : Ideal.span {a} ^ m ≤ Ideal.span {a} ^ n) :
    (Ext.mk₀ (ModuleCat.ofHom (Submodule.mapQ _ _ LinearMap.id h))).comp (powExtClass ha n)
      (zero_add 1) = a ^ (m - n) • powExtClass ha m := by
  let φ : powShortComplex a m ⟶ powShortComplex a n :=
    { τ₁ := ModuleCat.ofHom (a ^ (m - n) • LinearMap.id)
      τ₂ := 𝟙 _
      τ₃ := ModuleCat.ofHom (Submodule.mapQ _ _ LinearMap.id h)
      comm₁₂ := by
        ext
        -- both sides are multiplication maps on `A`, evaluated at `1`
        change a ^ n • (a ^ (m - n) • (1 : A)) = a ^ m • (1 : A)
        rw [smul_smul, ← pow_add, Nat.add_sub_cancel' hnm]
      comm₂₃ := by
        ext
        rfl }
  rw [← comp_mk₀_lsmul]
  exact ((shortExact_powShortComplex ha m).extClass_naturality
    (shortExact_powShortComplex ha n) φ).symm

/-- `r ↦ r • eₙ` is surjective onto `Ext¹(A ⧸ (a)ⁿ, A)`. -/
theorem toSpanSingleton_powExtClass_surjective {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) :
    Function.Surjective (LinearMap.toSpanSingleton A _ (powExtClass ha n)) :=
  exists_eq_smul_powExtClass ha n

/-- `Ext¹(A ⧸ (a)ⁿ, A)` is `A ⧸ (a)ⁿ`, generated by the class `eₙ`. -/
noncomputable def derivedExtOneLinearEquiv {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) :
    (A ⧸ Ideal.span {a} ^ n) ≃ₗ[A]
      Ext (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)) (ModuleCat.of A A) 1 :=
  Submodule.quotEquivOfEq _ _ (by
      ext r
      rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, smul_powExtClass_eq_zero_iff]) ≪≫ₗ
    (LinearMap.toSpanSingleton A _ (powExtClass ha n)).quotKerEquivOfSurjective
      (toSpanSingleton_powExtClass_surjective ha n)

/-- `derivedExtOneLinearEquiv` sends the class of `r` to `r • eₙ`. -/
@[simp]
theorem derivedExtOneLinearEquiv_mk {a : A} (ha : a ∈ nonZeroDivisors A) (n : ℕ) (r : A) :
    derivedExtOneLinearEquiv ha n (Ideal.Quotient.mk (Ideal.span {a} ^ n) r) =
      r • powExtClass ha n := by
  rw [← Ideal.Quotient.mk_eq_mk, derivedExtOneLinearEquiv, LinearEquiv.trans_apply,
    Submodule.quotEquivOfEq_mk, LinearMap.quotKerEquivOfSurjective_apply_mk,
    LinearMap.toSpanSingleton_apply]

section Localization

variable {a : A} (ha : a ∈ nonZeroDivisors A) (L : Type u) [CommRing L] [Algebra A L]
  [IsLocalization.Away a L]

variable (a) in
/-- The class of `1 / aⁿ` in `L ⧸ A`, for `L` the localization of `A` away from `a`. -/
noncomputable def invPowClass (n : ℕ) : L ⧸ LinearMap.range (Algebra.linearMap A L) :=
  Submodule.Quotient.mk
    (IsLocalization.mk' L (1 : A)
      (⟨a ^ n, pow_mem (Submonoid.mem_powers a) n⟩ : Submonoid.powers a))

/-- `r` times the class of `1 / aⁿ` is the class of `r / aⁿ`. -/
theorem smul_invPowClass (n : ℕ) (r : A) :
    r • invPowClass a L n =
      Submodule.Quotient.mk
        (IsLocalization.mk' L r
          (⟨a ^ n, pow_mem (Submonoid.mem_powers a) n⟩ : Submonoid.powers a)) := by
  rw [invPowClass, ← Submodule.Quotient.mk_smul, IsLocalization.smul_mk', mul_one]

include ha in
/-- For a nonzerodivisor `a`, the class of `r / aⁿ` in `L ⧸ A` vanishes exactly when
`r ∈ (a)ⁿ`. -/
theorem smul_invPowClass_eq_zero_iff (n : ℕ) (r : A) :
    r • invPowClass a L n = 0 ↔ r ∈ Ideal.span {a} ^ n := by
  rw [smul_invPowClass, Submodule.Quotient.mk_eq_zero, LinearMap.mem_range,
    mem_span_singleton_pow_iff]
  refine exists_congr fun y => ?_
  rw [Algebra.linearMap_apply, IsLocalization.eq_mk'_iff_mul_eq, ← map_mul,
    (IsLocalization.injective L ((Submonoid.powers_le (P := nonZeroDivisors A)).2 ha)).eq_iff,
    smul_eq_mul, mul_comm]

/-- For `n ≤ m`, the class of `aᵐ⁻ⁿ / aᵐ` is the class of `1 / aⁿ`. -/
theorem pow_sub_smul_invPowClass {n m : ℕ} (hnm : n ≤ m) :
    a ^ (m - n) • invPowClass a L m = invPowClass a L n := by
  rw [smul_invPowClass, invPowClass]
  congr 1
  rw [IsLocalization.mk'_eq_iff_eq]
  -- the coercions of the bundled powers `aⁿ` and `aᵐ`
  change algebraMap A L (a ^ n * a ^ (m - n)) = algebraMap A L (a ^ m * 1)
  rw [mul_one, ← pow_add, Nat.add_sub_cancel' hnm]

/-- The map `Ext¹(A ⧸ (a)ⁿ, A) → L ⧸ A`, `r • eₙ ↦ r / aⁿ`, on the derived-functor `Ext` of
`Mathlib.CategoryTheory.Abelian.Ext`. -/
noncomputable def extOneToQuotient (n : ℕ) :
    ((_root_.Ext A (ModuleCat.{u} A) 1).obj (op (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)))).obj
      (ModuleCat.of A A) →ₗ[A] L ⧸ LinearMap.range (Algebra.linearMap A L) :=
  (Submodule.liftQ _ (LinearMap.toSpanSingleton A _ (invPowClass a L n)) fun r hr =>
      (smul_invPowClass_eq_zero_iff ha L n r).2 hr) ∘ₗ
    (derivedExtOneLinearEquiv ha n).symm.toLinearMap ∘ₗ
    (extSuccLinearEquiv.{u} A (projectiveResolution _) (ModuleCat.of A A) 0).toLinearMap

/-- `extOneToQuotient` sends a class corresponding to `r • eₙ` to the class of `r / aⁿ`. -/
theorem extOneToQuotient_apply (n : ℕ)
    (y : ((_root_.Ext A (ModuleCat.{u} A) 1).obj
      (op (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)))).obj (ModuleCat.of A A)) (r : A)
    (hy : extSuccLinearEquiv.{u} A (projectiveResolution _) (ModuleCat.of A A) 0 y =
      r • powExtClass ha n) :
    extOneToQuotient ha L n y = r • invPowClass a L n := by
  have : (derivedExtOneLinearEquiv ha n).symm (r • powExtClass ha n) =
      Submodule.Quotient.mk r :=
    (LinearEquiv.symm_apply_eq _).2 (derivedExtOneLinearEquiv_mk ha n r).symm
  simp only [extOneToQuotient, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, hy,
    this]
  rfl

/-- The maps `Ext¹(A ⧸ (a)ⁿ, A) → L ⧸ A` are compatible with the transition maps of the system
defining local cohomology. -/
theorem extOneToQuotient_Ext_map {n m : ℕ} (hnm : n ≤ m)
    (h : Ideal.span {a} ^ m ≤ Ideal.span {a} ^ n)
    (y : ((_root_.Ext A (ModuleCat.{u} A) 1).obj
      (op (ModuleCat.of A (A ⧸ Ideal.span {a} ^ n)))).obj (ModuleCat.of A A)) :
    extOneToQuotient ha L m (((_root_.Ext A (ModuleCat.{u} A) 1).map
      (ModuleCat.ofHom (Submodule.mapQ _ _ LinearMap.id h)).op).app (ModuleCat.of A A) y) =
      extOneToQuotient ha L n y := by
  obtain ⟨r, hr⟩ := exists_eq_smul_powExtClass ha n
    (extSuccLinearEquiv.{u} A (projectiveResolution _) (ModuleCat.of A A) 0 y)
  rw [extOneToQuotient_apply ha L n y r hr.symm]
  refine (extOneToQuotient_apply ha L m _ (r * a ^ (m - n)) ?_).trans ?_
  · rw [extSuccLinearEquiv_Ext_map, ← hr, Ext.comp_smul, mk₀_mapQ_comp_powExtClass ha hnm,
      smul_smul]
  · rw [mul_smul, pow_sub_smul_invPowClass L hnm]

/-- **Local cohomology in degree one along a nonzerodivisor.** For a nonzerodivisor `a` of `A` and
`L` the localization of `A` away from `a`, `H¹_{(a)}(A) ≅ L ⧸ A`: the class `r • eₙ` in
`Ext¹(A ⧸ (a)ⁿ, A)` goes to `r / aⁿ`. -/
noncomputable def localCohomologyOneLinearEquiv :
    (localCohomology (Ideal.span {a}) 1).obj (ModuleCat.of A A) ≃ₗ[A]
      L ⧸ LinearMap.range (Algebra.linearMap A L) := by
  let D := localCohomology.diagram (localCohomology.idealPowersDiagram (Ideal.span {a})) 1
  let F := D ⋙ (evaluation _ _).obj (ModuleCat.of A A)
  let c : Cocone F :=
    { pt := ModuleCat.of A (L ⧸ LinearMap.range (Algebra.linearMap A L))
      ι :=
        { app := fun j => ModuleCat.ofHom (extOneToQuotient ha L j.unop.unop)
          naturality := fun j j' w => by
            ext y
            exact extOneToQuotient_Ext_map ha L (leOfHom w.unop.unop) _ y } }
  have : PreservesColimit F (forget (ModuleCat.{u} A)) :=
    have := preservesFilteredColimitsOfSize_shrink.{0, u, 0, u} (forget (ModuleCat.{u} A))
    inferInstance
  refine (colimitObjIsoColimitCompEvaluation D (ModuleCat.of A A)).toLinearEquiv ≪≫ₗ
    LinearEquiv.ofBijective (colimit.desc F c).hom ⟨?_, ?_⟩
  · refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
    obtain ⟨j, y, rfl⟩ := Concrete.colimit_exists_rep F x
    have hy : extOneToQuotient ha L j.unop.unop y = 0 := by
      rw [← hx, ← ModuleCat.comp_apply, colimit.ι_desc]
      rfl
    obtain ⟨r, hr⟩ := exists_eq_smul_powExtClass ha j.unop.unop
      (extSuccLinearEquiv.{u} A (projectiveResolution _) (ModuleCat.of A A) 0 y)
    rw [extOneToQuotient_apply ha L _ y r hr.symm, smul_invPowClass_eq_zero_iff ha,
      ← smul_powExtClass_eq_zero_iff ha, hr] at hy
    have hy₀ : y = 0 := (LinearEquiv.map_eq_zero_iff _).1 hy
    rw [hy₀, map_zero]
  · intro q
    obtain ⟨l, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    obtain ⟨⟨r, ⟨_, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers a) l
    refine ⟨colimit.ι F (op (op n)) ((extSuccLinearEquiv.{u} A (projectiveResolution _)
      (ModuleCat.of A A) 0).symm (r • powExtClass ha n)), ?_⟩
    rw [← ModuleCat.comp_apply, colimit.ι_desc]
    refine (extOneToQuotient_apply ha L n _ r (LinearEquiv.apply_symm_apply _ _)).trans ?_
    exact smul_invPowClass L n r

end Localization

end TauCeti.Supports
