module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.LinearAlgebra.Dimension.OrzechProperty

import Mathlib.LinearAlgebra.Dimension.Constructions

/-!
# Reduced monomials in `q`-th roots

Let `β₁, …, βₙ` be elements of a `K`-algebra whose `q`-th powers lie in `K`. Every monomial
`∏ βⱼ ^ eⱼ` is a `K`-multiple of the reduced monomial `∏ βⱼ ^ (eⱼ % q)`, so the `qⁿ` reduced
monomials, with exponents `0 ≤ rⱼ < q`, span `K[β₁, …, βₙ]`. Hence `[K[β] : K] ≤ qⁿ`, and when
equality holds, which is what Kummer independence of the classes of the `βⱼ ^ q` in `Kˣ ⧸ (Kˣ)^q`
gives, the reduced monomials are linearly independent over `K`.

In Yu's `p`-adic method this independence is how Kummer conjugates separate support classes: an
algebraic relation `∑_r c_r ∏ βⱼ ^ rⱼ = 0` with `c_r ∈ K` forces every `c_r` to vanish.

## Main results

* `TauCeti.prod_pow_mem_span_prod_pow_mod`: every monomial in the `βⱼ` lies in the `K`-span of the
  reduced monomials.
* `TauCeti.toSubmodule_adjoin_le_span_prod_pow`: so does the subalgebra they generate.
* `TauCeti.finrank_adjoin_range_le_pow`: `[K[β] : K] ≤ qⁿ`.
* `TauCeti.linearIndependent_prod_pow_of_finrank_adjoin_eq`,
  `TauCeti.linearIndependent_prod_pow_of_finrank_intermediateFieldAdjoin_eq`: if the degree is
  `qⁿ`, the reduced monomials are linearly independent over `K`.
* `TauCeti.sum_filter_mul_prod_pow_div_eq_zero`: a vanishing `K`-linear combination of monomials
  vanishes on each residue class of exponents modulo `q`.

## References

* K. Yu, *Linear forms in p-adic logarithms. II*, Compositio Math. 74 (1990), 15–113, §2.
-/

public section

open Module Submodule

namespace TauCeti

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A] {n q : ℕ} {β : Fin n → A}

/-- Every monomial in elements whose `q`-th powers lie in `K` is a `K`-multiple of the reduced
monomial with exponents taken modulo `q`. -/
theorem prod_pow_mem_span_prod_pow_mod (hq : q ≠ 0)
    (hβ : ∀ j, ∃ a : K, algebraMap K A a = β j ^ q) (e : Fin n → ℕ) :
    ∏ j, β j ^ e j ∈ span K (Set.range fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ)) := by
  choose a ha using hβ
  have hmono : ∏ j, β j ^ e j = (∏ j, a j ^ (e j / q)) •
      ∏ j, β j ^ ((⟨e j % q, Nat.mod_lt _ (Nat.pos_of_ne_zero hq)⟩ : Fin q) : ℕ) := by
    rw [Algebra.smul_def, map_prod, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun j _ ↦ ?_
    rw [map_pow, ha, ← pow_mul, ← pow_add, Nat.div_add_mod]
  rw [hmono]
  exact smul_mem _ _ (subset_span ⟨_, rfl⟩)

/-- The subalgebra generated by elements whose `q`-th powers lie in `K` is spanned by the reduced
monomials. -/
theorem toSubmodule_adjoin_le_span_prod_pow (hq : q ≠ 0)
    (hβ : ∀ j, ∃ a : K, algebraMap K A a = β j ^ q) :
    Subalgebra.toSubmodule (Algebra.adjoin K (Set.range β)) ≤
      span K (Set.range fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ)) := by
  rw [Algebra.adjoin_eq_span, span_le]
  intro x hx
  have : ∃ e : Fin n → ℕ, x = ∏ j, β j ^ e j := by
    induction hx using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      refine ⟨Pi.single i 1, ?_⟩
      rw [Fintype.prod_eq_single i fun j hj ↦ by simp [hj]]
      simp
    | one => exact ⟨0, by simp⟩
    | mul x y _ _ hx hy =>
      obtain ⟨e, rfl⟩ := hx
      obtain ⟨e', rfl⟩ := hy
      exact ⟨e + e', by simp [pow_add, Finset.prod_mul_distrib]⟩
  obtain ⟨e, rfl⟩ := this
  exact prod_pow_mem_span_prod_pow_mod hq hβ e

/-- **The degree bound of a Kummer extension.** Adjoining `n` elements whose `q`-th powers lie in
`K` gives a `K`-algebra of dimension at most `qⁿ`. -/
theorem finrank_adjoin_range_le_pow (hq : q ≠ 0)
    (hβ : ∀ j, ∃ a : K, algebraMap K A a = β j ^ q) :
    finrank K (Algebra.adjoin K (Set.range β)) ≤ q ^ n := by
  have := Module.Finite.span_of_finite K
    (Set.finite_range fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ))
  rw [← Subalgebra.finrank_toSubmodule]
  exact ((Submodule.finrank_mono (toSubmodule_adjoin_le_span_prod_pow hq hβ)).trans
    (finrank_range_le_card _)).trans_eq (by simp)

/-- **Reduced monomials in independent `q`-th roots are independent.** If the `q`-th powers of
`β₁, …, βₙ` lie in `K` and `[K[β] : K] = qⁿ`, then the monomials `∏ βⱼ ^ rⱼ` with `0 ≤ rⱼ < q` are
linearly independent over `K`. -/
theorem linearIndependent_prod_pow_of_finrank_adjoin_eq (hq : q ≠ 0)
    (hβ : ∀ j, ∃ a : K, algebraMap K A a = β j ^ q)
    (hdeg : finrank K (Algebra.adjoin K (Set.range β)) = q ^ n) :
    LinearIndependent K fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ) := by
  have hspan : span K (Set.range fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ)) =
      Subalgebra.toSubmodule (Algebra.adjoin K (Set.range β)) := by
    refine le_antisymm (span_le.2 ?_) (toSubmodule_adjoin_le_span_prod_pow hq hβ)
    rintro _ ⟨r, rfl⟩
    exact (Subalgebra.mem_toSubmodule _).2 <|
      prod_mem fun j _ ↦ pow_mem (Algebra.subset_adjoin (Set.mem_range_self j)) _
  rw [linearIndependent_iff_card_eq_finrank_span, Set.finrank, hspan,
    Subalgebra.finrank_toSubmodule, hdeg]
  simp

/-- **Reduced monomials in independent `q`-th roots are independent**, for the subfield generated
by the roots: if the `q`-th powers of `β₁, …, βₙ` lie in `K` and `[K(β) : K] = qⁿ`, the monomials
`∏ βⱼ ^ rⱼ` with `0 ≤ rⱼ < q` are linearly independent over `K`. -/
theorem linearIndependent_prod_pow_of_finrank_intermediateFieldAdjoin_eq {L : Type*} [Field L]
    [Algebra K L] {β : Fin n → L} (hq : q ≠ 0) (hβ : ∀ j, ∃ a : K, algebraMap K L a = β j ^ q)
    (hdeg : finrank K (IntermediateField.adjoin K (Set.range β)) = q ^ n) :
    LinearIndependent K fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ) := by
  refine linearIndependent_prod_pow_of_finrank_adjoin_eq hq hβ ?_
  rwa [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic]
  rintro _ ⟨j, rfl⟩
  obtain ⟨a, ha⟩ := hβ j
  exact IsAlgebraic.of_pow (Nat.pos_of_ne_zero hq) (ha ▸ isAlgebraic_algebraMap a)

/-- **Kummer conjugates separate support classes.** Let `aⱼ = βⱼ ^ q` with `aⱼ ∈ K`, and suppose the
reduced monomials `∏ βⱼ ^ rⱼ`, `0 ≤ rⱼ < q`, are linearly independent over `K`. If a `K`-linear
combination `∑_e c_e ∏ βⱼ ^ eⱼ` of arbitrary monomials vanishes, then so does each of its parts
supported on one residue class `e ≡ r (mod q)`, after the factor `∏ βⱼ ^ rⱼ` is removed:
`∑_{e ≡ r} c_e ∏ aⱼ ^ (eⱼ / q) = 0`. -/
theorem sum_filter_mul_prod_pow_div_eq_zero (hq : q ≠ 0) {a : Fin n → K}
    (ha : ∀ j, algebraMap K A (a j) = β j ^ q)
    (hli : LinearIndependent K fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ))
    {s : Finset (Fin n → ℕ)} {c : (Fin n → ℕ) → K}
    (hsum : ∑ e ∈ s, c e • ∏ j, β j ^ e j = 0) (r : Fin n → Fin q) :
    ∑ e ∈ s with ∀ j, e j % q = r j, c e * ∏ j, a j ^ (e j / q) = 0 := by
  have hq' := Nat.pos_of_ne_zero hq
  let red : (Fin n → ℕ) → Fin n → Fin q := fun e j ↦ ⟨e j % q, Nat.mod_lt _ hq'⟩
  have hterm (e : Fin n → ℕ) : c e • ∏ j, β j ^ e j =
      (c e * ∏ j, a j ^ (e j / q)) • ∏ j, β j ^ (red e j : ℕ) := by
    rw [mul_smul, Algebra.smul_def (∏ j, a j ^ (e j / q)), map_prod, ← Finset.prod_mul_distrib]
    congr 1
    refine Finset.prod_congr rfl fun j _ ↦ ?_
    rw [map_pow, ha, ← pow_mul, ← pow_add, Nat.div_add_mod]
  have hfilter : ∀ r : Fin n → Fin q,
      {e ∈ s | ∀ j, e j % q = r j} = {e ∈ s | red e = r} := fun r ↦
    Finset.filter_congr fun e _ ↦ by simp [red, funext_iff, Fin.ext_iff]
  have key : ∑ r', (∑ e ∈ s with red e = r', c e * ∏ j, a j ^ (e j / q)) •
      ∏ j, β j ^ (r' j : ℕ) = 0 := by
    rw [← hsum, Finset.sum_congr rfl fun e _ ↦ hterm e, ← Finset.sum_fiberwise s red]
    refine Finset.sum_congr rfl fun r' _ ↦ ?_
    rw [Finset.sum_smul]
    refine Finset.sum_congr rfl fun e he ↦ ?_
    rw [(Finset.mem_filter.1 he).2]
  rw [hfilter]
  exact Fintype.linearIndependent_iff.1 hli _ key r

end TauCeti
