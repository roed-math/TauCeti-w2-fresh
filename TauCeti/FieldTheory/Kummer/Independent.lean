import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# Roots of Kummer-independent generators

Let `K` contain the `q`-th roots of unity, let `α₁, …, αₙ ∈ Kˣ`, and let `β₁, …, βₙ` be `q`-th roots
of them in an extension field `E`. The field `K(β₁, …, βₙ)` is the Kummer field
`K(⟨α₁, …, αₙ⟩^{1/q})`: every `q`-th root of a word in the `αⱼ` is a unit of `K` times the same
word in the `βⱼ`. Hence its degree over `K` is the order of the image of `⟨α₁, …, αₙ⟩` in
`Kˣ ⧸ (Kˣ)^q`. When the classes of the `αⱼ` are independent, so that this order is `qⁿ`, the degree
is `qⁿ` and the reduced monomials `∏ βⱼ ^ rⱼ`, `0 ≤ rⱼ < q`, are linearly independent over `K`.

This is the Kummer-independent case of Yu's auxiliary construction: there the independence of the
reduced monomials is how Kummer conjugates separate the support classes modulo `q`.

## Main results

* `TauCeti.isFiniteRelIndex_range_powMonoidHom_closure`: `q`-th powers have finite index in a
  finitely generated subgroup of a commutative group.
* `TauCeti.adjoin_range_eq_kummerField`: `K(β) = K(⟨α⟩^{1/q})`.
* `TauCeti.finrank_adjoin_range_eq_relIndex`: `[K(β) : K] = [⟨α⟩ : ⟨α⟩ ∩ (Kˣ)^q]`.
* `TauCeti.linearIndependent_prod_pow_of_relIndex_eq`: if that index is `qⁿ`, the reduced
  monomials in the `βⱼ` are linearly independent over `K`.

## References

* K. Yu, *Linear forms in p-adic logarithms. II*, Compositio Math. 74 (1990), 15–113, §2.
-/

public section

open IntermediateField Module

namespace TauCeti

/-- In a commutative group, the `q`-th powers have finite index in every finitely generated
subgroup: the quotient is finitely generated and killed by `q`. -/
instance isFiniteRelIndex_range_powMonoidHom_closure {G : Type*} [CommGroup G] {q : ℕ} [NeZero q]
    (s : Set G) [Finite s] :
    (powMonoidHom q : G →* G).range.IsFiniteRelIndex (Subgroup.closure s) := by
  set Δ := Subgroup.closure s
  have : Finite (Δ ⧸ (powMonoidHom q : G →* G).range.subgroupOf Δ) :=
    CommGroup.finite_of_fg_isMulTorsion _ fun x ↦ by
      induction x using QuotientGroup.induction_on with
      | H g =>
        refine isOfFinOrder_iff_pow_eq_one.2 ⟨q, Nat.pos_of_ne_zero (NeZero.ne q), ?_⟩
        rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
        exact Subgroup.mem_subgroupOf.2 ⟨(g : G), rfl⟩
  exact ⟨Subgroup.index_ne_zero_of_finite⟩

variable {K E : Type*} [Field K] [Field E] [Algebra K E] {n q : ℕ} {α : Fin n → Kˣ}
  {β : Fin n → E}

/-- Every element of the subgroup generated by `α₁, …, αₙ` has a `q`-th root in `K(β₁, …, βₙ)` when
`βⱼ ^ q = αⱼ`: the corresponding word in the `βⱼ`. -/
theorem exists_mem_adjoin_range_pow_eq_of_mem_closure
    (hβ : ∀ j, β j ^ q = algebraMap K E (α j)) {a : Kˣ}
    (ha : a ∈ Subgroup.closure (Set.range α)) :
    ∃ y ∈ adjoin K (Set.range β), y ^ q = algebraMap K E a := by
  induction ha using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨j, rfl⟩ := ha
    exact ⟨β j, subset_adjoin _ _ ⟨j, rfl⟩, hβ j⟩
  | one => exact ⟨1, one_mem _, by simp⟩
  | mul a b _ _ ha hb =>
    obtain ⟨y, hy, hya⟩ := ha
    obtain ⟨z, hz, hzb⟩ := hb
    exact ⟨y * z, mul_mem hy hz, by rw [mul_pow, hya, hzb, Units.val_mul, map_mul]⟩
  | inv a _ ha =>
    obtain ⟨y, hy, hya⟩ := ha
    exact ⟨y⁻¹, inv_mem hy, by rw [inv_pow, hya, Units.val_inv_eq_inv_val, map_inv₀]⟩

variable [NeZero q] [HasEnoughRootsOfUnity K q]

/-- **Roots of generators generate the Kummer field.** If `K` contains the `q`-th roots of unity
and `βⱼ ^ q = αⱼ`, then `K(β₁, …, βₙ)` is the Kummer field `K(⟨α₁, …, αₙ⟩^{1/q})`. -/
theorem adjoin_range_eq_kummerField (hβ : ∀ j, β j ^ q = algebraMap K E (α j)) :
    adjoin K (Set.range β) = kummerField E q (Subgroup.closure (Set.range α)) := by
  refine le_antisymm (adjoin_le_iff.2 ?_) (kummerField_le_iff.2 fun a ha x hx ↦ ?_)
  · rintro _ ⟨j, rfl⟩
    exact mem_kummerField_of_pow_eq (Subgroup.subset_closure ⟨j, rfl⟩) (hβ j)
  · obtain ⟨y, hy, hya⟩ := exists_mem_adjoin_range_pow_eq_of_mem_closure hβ ha
    obtain ⟨z, rfl⟩ := exists_eq_algebraMap_mul_of_pow_eq (K := K) (hx.trans hya.symm)
    exact mul_mem (IntermediateField.algebraMap_mem _ _) hy

/-- **The degree of the field generated by `q`-th roots of `α₁, …, αₙ`.** If `K` contains the
`q`-th roots of unity and `βⱼ ^ q = αⱼ`, then `[K(β) : K]` is the order of the image of
`⟨α₁, …, αₙ⟩` in `Kˣ ⧸ (Kˣ)^q`. -/
theorem finrank_adjoin_range_eq_relIndex (hβ : ∀ j, β j ^ q = algebraMap K E (α j)) :
    finrank K (adjoin K (Set.range β)) =
      (powMonoidHom q : Kˣ →* Kˣ).range.relIndex (Subgroup.closure (Set.range α)) := by
  rw [adjoin_range_eq_kummerField hβ, finrank_kummerField fun a ha ↦
    (exists_mem_adjoin_range_pow_eq_of_mem_closure hβ ha).imp fun _ ↦ And.right]

/-- **Reduced monomials in roots of Kummer-independent generators are independent.** If `K`
contains the `q`-th roots of unity, `βⱼ ^ q = αⱼ`, and the classes of `α₁, …, αₙ` in
`Kˣ ⧸ (Kˣ)^q` generate a subgroup of order `qⁿ`, then the monomials `∏ βⱼ ^ rⱼ` with
`0 ≤ rⱼ < q` are linearly independent over `K`. -/
theorem linearIndependent_prod_pow_of_relIndex_eq (hβ : ∀ j, β j ^ q = algebraMap K E (α j))
    (hidx : (powMonoidHom q : Kˣ →* Kˣ).range.relIndex (Subgroup.closure (Set.range α)) =
      q ^ n) :
    LinearIndependent K fun r : Fin n → Fin q ↦ ∏ j, β j ^ (r j : ℕ) :=
  linearIndependent_prod_pow_of_finrank_intermediateFieldAdjoin_eq (NeZero.ne q)
    (fun j ↦ ⟨α j, (hβ j).symm⟩) ((finrank_adjoin_range_eq_relIndex hβ).trans hidx)

end TauCeti
